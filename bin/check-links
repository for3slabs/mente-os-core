#!/usr/bin/env python3
"""check-links — every citation inside Mente must resolve.

⭐ The lock that makes the v1→v2 migration safe. It exists because of two real incidents on
2026-07-30, both in the same day:

  1. A bulk path pass rewrote filenames as SUBSTRINGS: `Plan_Maestro_Entrenamiento.md` became
     `docs/plan-v2-rollout_Entrenamiento.md` in 4 historical documents — pointers to files that
     never existed.
  2. Fixing that, a second pass "completed" 28 valid RELATIVE paths (`decisions/ADR-028` from
     rules/, `expertise/*.md` from principles/) into absolutes that do not exist.

> ⭐ **A bulk rewrite is not safe because the mapping is right. It is safe when something verifies
> the result afterwards.** And **a relative path that resolves from its OWN directory is correct —
> completing it is the bug.**

This lives in its own file (not inside bin/test-f0-f6) so it can run after EVERY single file move,
which is what `docs/plan-v1-to-v2-migration.md` mandates.

Usage:
  bin/check-links            every citation
  bin/check-links <file>     only what this file cites
  bin/check-links --quiet
Exit: 0 all resolve · 1 something points nowhere
"""
import os
import re
import sys
import glob

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(MENTE, "bin"))
import mente_config as cfg                                            # noqa: E402
os.chdir(MENTE)

# Generated by F7 — they exist only after bin/generate-index runs.
FUTURE = {"docs/INDEX.md", "docs/STATES.md", "docs/DECISIONS.md"}
# Illustrative placeholders in prose, never real files.
PLACEHOLDER = re.compile(r"\.\.\.|NNN|<[a-z]|\bX\.md\b|\bY\.md\b|AAAA-MM")
# ⭐ Documents that DESCRIBE another system quote ITS filenames. `Radiografia_Fruterito_*` describes
# OpenClaw, `Hermes_Arquitectura_Completa.md` describes Hermes, `analysis-*` compare frameworks.
# Those names are the SUBJECT of the document, not links into ours. Measured 2026-07-30: they were
# 443 of 443 remaining "broken" links — i.e. all of them, and none was a real defect.
# ⛔ A validator that reports 443 non-defects is a validator nobody reads.
DESCRIBE_FOREIGN = re.compile(
    r"^(Doc/(Radiografia|Comparacion|Analisis|Entrenamiento|Estado_Sesion|Bitacora|Changelog|"
    r"H\d|PR\d|Examen|Informe|Plan_Web|Primeros_Pasos)"
    r"|Cuerpo/(Hermes|Ronda_Entrenamiento|Flujo_Extraccion|Plan_Implementacion)"
    r"|Cerebro/Cerebro_Humano"
        r"|Maestro/)")
# Files that DESCRIBE broken paths (audits quoting what they found) — a description is not a link.
DESCRIBES = ("docs/audit-", "docs/f4-execution-log.md", "docs/f5-execution-log.md",
             "docs/f6-execution-log.md", "docs/f7-f8-execution-log.md",
             "docs/plan-v1-to-v2-migration.md",
             # the framework comparisons quote OTHER systems' filenames as their subject
             "docs/analysis-")
# ⭐ Names the ARCHITECTURE document discusses instead of pointing at (measured 2026-08-02).
# It is the design record: it quotes the v1 vocabulary it REPLACED (`contexto.md`, `estado.md`,
# `BLOQUE.md` → now `BLOCK.md`), a filename-convention EXAMPLE (`minusculas-con-guiones.md`,
# listed beside `ADR-NNN-` and `rule-`), and — under a heading literally titled "Lo que NO se
# copia" — another system's pieces (`tick.md`, `STAKEHOLDERS.md`, `cache/changelog.md`).
#
# ⛔ Why NOT the two easy routes: adding these to GENERIC would excuse `estado.md` in EVERY file
# forever, and adding the document to DESCRIBES would blind all 2454 of its lines — on the same
# day 5 real fossils were fixed inside it. The exemption is scoped to this document AND to the
# names it demonstrably discusses; anything else it cites still fails closed.
#
# NAMING_CONVENTION.md is the same shape one level down: a document that DEFINES how to name
# files necessarily prints sample names. Every entry below sits in the "example" column of its
# table, beside the `spec-` and `ADR-NNN-` prefixes it is illustrating. `pointers.tsv` is the
# English gloss of Maestro/punteros.tsv inside a measurement table — the real file exists in
# Spanish, so translating the prose would be the actual error.
DISCUSSED = {"docs/Arquitectura_Mente_OS_v2_Bloques.md": {
    "contexto.md", "estado.md", "BLOQUE.md", "INDICE.md",
    "minusculas-con-guiones.md", "tick.md", "STAKEHOLDERS.md", "cache/changelog.md"},
    "rules/NAMING_CONVENTION.md": {
    "lowercase-with-hyphens.md", "naming-convention.md", "pointers.tsv",
    "spec-quality-verdict.md", "ADR-001-single-file-per-block.md"},
    # The three docs/architecture/* files are the SPLIT of the architecture document above
    # (block `split-architecture`, archived): same prose, same subject, same v1 vocabulary —
    # verified identical, down to `minusculas-con-guiones.md` sitting beside `ADR-NNN-`.
    "docs/architecture/folder-structure.md": {"minusculas-con-guiones.md", "INDICE.md"},
    "docs/architecture/block-anatomy.md": {"BLOQUE.md", "contexto.md"},
    "docs/architecture/validators-and-hygiene.md": {"estado.md", "cache/changelog.md"},
    # ── the last 9, each verified individually (2026-08-02) ──────────────────
    # "2. Generar X … 3. Generar Y" — a decision the round asks for, not a link.
    # 🔴 First attempt rewrote the dead v1 folder `Mente/Cuerpo/` to `work/` — and the battery's
    # own citation check caught it: work/01-… does not exist either. Repointing an unwritten
    # deliverable at a second path it does not occupy is inventing a fact. A file that has no
    # home yet is named BARE, which is exactly what it is.
    "work/Hermes_Arquitectura_Completa.md": {
        "01-arquitectura-general-for3s-qa.md", "02-installer-for3s.md"},
    # The document ALREADY annotates it: "planned deliverable, never produced — verified
    # 2026-07-30". Same reasoning: bare, because it was never produced anywhere.
    "work/Ronda_Entrenamiento_Plan_Maestro.md": {"Entrenamiento_Manifiesto.md"},
    # "El diario de Brian (`FOR3S-STACK-DEFINED.md`) declaraba en mayo:" — quoting a personal
    # file of Brian's outside this tree, as the source of a quotation.
    "work/Ronda_01_Compute_Lenguaje.md": {"FOR3S-STACK-DEFINED.md"},
    # Deliverables of the extraction flow, one explicitly behind a "GATE Brian": drafts to be
    # written, not files to be found.
    "work/Flujo_Extraccion_Entrenamiento.md": {"persona/IDENTITY.md", "backlog_herramientas.md"},
    "work/Plan_Implementacion_Entrenamiento.md": {"persona/IDENTITY.md"},
    # "Equivalente a `godinez-studio/docs/onboarding-flow.md` pero para For3s" — an ANALOGY to
    # another project's document. A comparison is not a pointer.
    "memory/archive/PR4_Flujo_Usuario_Memoria.md": {"godinez-studio/docs/onboarding-flow.md"}}
# Documents that legitimately name files the pending work will CREATE.
# ⭐ Added 2026-08-02: both are ROADMAPS. Vision_For3s_Frontier §13 ("Corto/Mediano plazo")
# and memory/archive/README §7 list documents to WRITE — "Iniciar Cerebro_Humano_acercamiento3.md",
# "futura iteración". Naming work that does not exist yet is what a roadmap IS; reporting it as a
# broken pointer asks the author to delete the plan. The v1 FOLDERS they wrote those plans into
# (`Mente/Alma/`, `Mente/Cuerpo/`) were real fossils and were corrected to vision/ and work/.
PLANNED = ("memory/PENDIENTES.md", "docs/plan-v2-rollout.md",
           "docs/plan-v1-to-v2-migration.md",
           "vision/Vision_For3s_Frontier.md", "memory/archive/README.md",
           # A round's deliverable table names what the round WILL produce — `gdpr-program.md`
           # sits in the same cell as `dsar_workflow.py`, equally unwritten. Same for the
           # closing section of Arquitectura_Grafo_vs_Loop ("Considerar…", "basado en el boceto").
           "work/Ronda_09_B3_Compliance_Framework.md",
           "Cerebro/Arquitectura_Grafo_vs_Loop.md",
           # A BLOCK names the pieces its sub-blocks will create — that is what §F is for.
           # Reporting them as broken pointers would ask the author to delete the plan.
           "blocks/active/distribucion/BLOCK.md")
# Generic filenames that name a KIND of file, not one file: `BLOCK.md` means "any block".
# `SKILL.md` names a KIND too: every skill has one (.claude/skills/<name>/SKILL.md). The three
# documents citing it are quoting the frozen-number incident, not linking to one skill.
GENERIC = {"BLOCK.md", "SUMMARY.md", "README.md", "MEMORY.md", "connections.md", "SKILL.md",
           "settings.json", "settings.local.json", "package.json", "__init__.py"}
# One level above Mente: the project root holds CLAUDE.md and PROJECT-RULES.md.
PARENT = {"CLAUDE.md", "PROJECT-RULES.md", ".gitignore"}
# Outside Mente: other repos, the harness, the agent. Not ours to resolve.
# ⚠️ `memory/<fecha>.md` es de OpenClaw (diarios del agente ajeno), NO de nuestra memory/.
# Colisión de nombre creada al elegir `memory/` como destino v2 en M1 (2026-07-30).
OPENCLAW_MEMORY = re.compile(r"^memory/(\d{4}-\d{2}-\d{2}|AAAA-MM-DD)\.md$")

# Declared per instance (mente.config.yml): pointers into these belong to other repos.
OUTSIDE = tuple(cfg.outside())


def is_harness_memory(c):
    """A `project_*.md` / `feedback_*.md` citation naming a harness memory, not a file here.

    🔴 Found 2026-08-02: 7 rounds cite `project_r6_critical_pre_code_review.md` and friends.
    They EXIST — in ~/.claude/projects/<slug>/memory/, which is the harness's store and lives
    outside this tree on purpose. Verified present before excusing them; the existence check is
    what keeps this from becoming a blanket pardon for any `project_`-prefixed typo.
    """
    if "/" in c or not re.match(r"^(project|feedback|reference)_.+\.md$", c):
        return False
    d, _ = cfg.session_dir()
    return bool(d) and os.path.exists(os.path.join(d, "memory", c))


def in_sibling_repo(c):
    """Does this citation resolve inside a repo declared `outside`?

    🔴 Found 2026-08-02 auditing the 144: `startswith(OUTSIDE)` only excused a citation that
    SPELLS the repo — but the round documents write the prefix in prose and the path in the
    backticks (`09-technical-architecture/tools-mcp-layer.md` right under a line naming
    for3s-inter/). Measured: 3 of 4 sampled resolve inside ../for3s-inter and were counted as
    broken pointers into OUR tree.

    ⭐ It RESOLVES the path instead of pattern-matching the name: a rule that excused
    `NN-word/` by shape would excuse any future typo of that shape too. This one only goes
    quiet when the file is really there — unknown paths still fail closed.
    """
    for repo in OUTSIDE:
        root = os.path.join("..", repo.rstrip("/"))
        if "/" in c:
            if os.path.exists(os.path.join(root, c)):
                return True
            continue
        # A BARE name (`CHANGELOG.md`, `pentest-plan.md`) is excused only when the sibling repo
        # holds EXACTLY ONE file by that name. Two matches means the citation is ambiguous, and
        # an ambiguous pointer is a defect worth reporting — not something to silence by luck.
        hits = glob.glob(f"{root}/**/{c}", recursive=True)
        if len(hits) == 1:
            return True
    return False


# Folders whose internal citations MUST resolve — the v1 legacy plus every v2 destination.
INSIDE = ("rules/", "principles/", "blocks/", "docs/", "bin/", "hooks/",
          "Cerebro/", "Maestro/",
          "vision/", "work/", "memory/", "bridges/")


def cited(text):
    """Paths cited in backticks or markdown links."""
    # ⭐ Only .md and .tsv: this validator guards the DOCUMENT graph. Code files (.py, .sh, .json)
    # live in the agent's repo — citing `conversation.py` in a round is naming a module, not
    # linking to a file here. Including them produced 100+ non-defects (measured 2026-07-30).
    out = set(re.findall(r"`([A-Za-z0-9_./-]+\.(?:md|tsv))`", text))
    out |= set(re.findall(r"\[[^\]]*\]\(([^)#\s]+\.(?:md|tsv|sh|py))\)", text))
    return out


def main():
    quiet = "--quiet" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    files = args or [f for f in glob.glob("**/*.md", recursive=True)
                     if ".git/" not in f and not f.startswith("secrets/")]
    # 🔴 The two documents that STEER live one level up, outside this glob — so the router read
    # on every single session start was never audited. Measured 2026-08-02: CLAUDE.md carried
    # `Maestro/piezas.tsv` (it is Mente/Maestro/) and a row for `Mente/Doc/`, a folder ADR-029
    # deleted. ⭐ The file read FIRST was the least watched.
    if not args:
        files += [p for p in ("../CLAUDE.md", "../PROJECT-RULES.md") if os.path.exists(p)]

    broken = []
    for f in files:
        # ⭐ A GENERATED index is a snapshot: between a move and the next `generate-index` it
        # legitimately names old paths. Auditing it reports the generator's lag, not a defect —
        # and during M1 that made 3 reverted moves look like 10 broken links (2026-07-30).
        if f in FUTURE:
            continue
        if not os.path.exists(f):
            print(f"🔴 {f} does not exist")
            return 1
        # ⚠️ Maestro/ is a separate repo: its root is Maestro/, so a path written from the Mente
        # root is wrong INSIDE it. Its citations resolve against its own root.
        # A document one level up (CLAUDE.md, PROJECT-RULES.md) writes its paths from the PROJECT
        # root — `Mente/rules/x.md`, not `rules/x.md`. Resolving those against Mente/ would look
        # for Mente/Mente/… and silently find nothing, which is a green that means "not checked".
        base = "Maestro" if f.startswith("Maestro/") else (".." if f.startswith("../") else ".")
        try:
            text = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for c in cited(text):
            name = os.path.basename(c)
            if OPENCLAW_MEMORY.match(c):
                continue
            if c in FUTURE or PLACEHOLDER.search(c) or c.startswith(OUTSIDE):
                continue
            if in_sibling_repo(c):
                continue                      # resolves in a repo declared `outside`
            if c in DISCUSSED.get(f, ()):
                continue                      # this document's subject, not its pointer
            if is_harness_memory(c):
                continue                      # lives in the harness memory store, verified
            # 🔴 secrets/ was skipped as a SOURCE (line below) but never as a DESTINATION, so
            # RETOMAR.md pointing at the demo secrets — present on disk, gitignored on purpose
            # (rule-config-hygiene §1.1) — read as a broken pointer. Reporting it invites
            # deleting a correct one. Resolved by existence, so a wrong path still fails.
            if re.sub(r"^Mente/", "", c).startswith("secrets/") \
                    and os.path.exists(re.sub(r"^Mente/", "", c)):
                continue
            if name in GENERIC and "/" not in c:
                continue                      # a kind of file, not a specific one
            if name in PARENT and os.path.exists(os.path.join("..", name)):
                continue                      # lives at the project root, above Mente
            if f.startswith(DESCRIBES) or f in PLANNED or DESCRIBE_FOREIGN.match(f):
                continue
            # The exemption follows the DOCUMENT, not the folder: a radiography of OpenClaw keeps
            # describing OpenClaw after it moves. Recognised by its own migration trail.
            if re.match(r"^(Radiografia|Comparacion|Analisis|Entrenamiento|Estado_|TRAZA|"
                        r"Examen|Informe|Changelog|Banco_)", os.path.basename(f)):
                continue
            # A URL is not a path.
            if c.startswith(("http", "/")):
                continue
            # resolves from the Mente root, from its own directory, or from its repo root?
            # ⚠️ For a document ABOVE Mente the bare `c` fallback must NOT apply: it would resolve
            # `Maestro/piezas.tsv` from inside Mente/ and call it valid, while a reader starting at
            # the project root finds nothing there. That fallback turned a real broken pointer green.
            cands = ((os.path.join(base, c), os.path.join(os.path.dirname(f), c))
                     if f.startswith("../")
                     else (os.path.join(base, c), os.path.join(os.path.dirname(f), c), c))
            for cand in cands:
                if os.path.exists(cand):
                    break
            else:
                # A BARE NAME (no directory) that exists SOMEWHERE is not a broken link — it is an
                # ambiguous one, and `bin/check-blocks` already reports that as 🟡 "bare path".
                # Two validators reporting the same thing differently is how you learn to ignore
                # both. This one answers a narrower question: does the TARGET exist at all?
                if "/" not in c and glob.glob(f"**/{name}", recursive=True):
                    continue
                broken.append((f, c))

    if quiet:
        return 1 if broken else 0
    if broken:
        print(f"\n🔴 {len(broken)} citation(s) point nowhere\n")
        for f, c in broken[:30]:
            print(f"   {f}\n      → {c}")
        if len(broken) > 30:
            print(f"   … +{len(broken) - 30} more")
        print("\n   A pointer to nothing is worse than no pointer: it is read as a promise.")
        return 1
    print(f"✅ every citation resolves ({len(files)} files checked)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
