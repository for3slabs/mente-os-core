#!/usr/bin/env bash
# test-f0-f6 — the whole system, end to end, every phase.
#
# Why this is a script and not a list of commands typed once (Brian, 2026-07-20):
#   "los bugs trágicos viven ENTRE las piezas" — a battery that cannot be re-run proves nothing
#   about tomorrow. This one is re-runnable, and every check is AFFIRMATIVE: it states the
#   expected value and compares. No "more or less".
#
# Each test names WHAT it verifies and WHY that is the thing that would break.
# Exit: 0 all pass · 1 something failed
#
# ⭐ THIS BATTERY MUTATES THE SHARED TREE, so it takes a lock (below).
#
# The flake it fixes, diagnosed 2026-07-31 by reproducing it on purpose: several checks create
# probe blocks under blocks/active/zz-* and delete them at the end. `generate-index` globs
# blocks/**, so a SECOND concurrent run regenerates the index while the first run's probe is
# alive — and then `generate-index --check` reports the index as stale. Two simultaneous runs:
# BOTH failed, both on "the generated indexes are up to date".
#
# 🔴 The first diagnosis (written before reproducing) was WRONG on both counts: it blamed
# "reading a file mid-write" and claimed the failure named no check. It named one. A guess
# recorded as a finding is worse than an open question — it teaches you to ignore a real report.
#
# Why a lock and not isolated probes: every validator anchors to its own location
# (os.chdir(dirname(dirname(__file__)))), so running them against a scratch tree means
# rewriting all thirteen. The lock is the honest fix for the actual invariant — this battery
# owns the tree while it runs.
set -uo pipefail
M="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ── THE LOCK ────────────────────────────────────────────────────────────────
# mkdir is atomic on every POSIX filesystem: it either creates the directory or fails.
# No flock dependency, no PID file to go stale silently.
#
# The lock is REFUSED, never waited on: a battery queued behind another one would look hung,
# and the second run has nothing to add — the first is already verifying the same tree.
_LOCK="$M/.test-lock"
if ! mkdir "$_LOCK" 2>/dev/null; then
  _owner=$(cat "$_LOCK/pid" 2>/dev/null || echo "?")
  # A lock whose owner is gone is a crash leftover, not a running battery. Reclaim it —
  # otherwise one killed run blocks the battery forever and someone deletes the guard.
  if [ "$_owner" != "?" ] && ! kill -0 "$_owner" 2>/dev/null; then
    printf '⚠️  reclaiming a stale lock from pid %s (that run died)\n' "$_owner" >&2
    rm -rf "$_LOCK" && mkdir "$_LOCK" 2>/dev/null
  else
    printf '🔴 another test-f0-f6 is running (pid %s).\n' "$_owner" >&2
    printf '   This battery creates probe blocks in the real tree, so two runs corrupt\n' >&2
    printf '   each other. Wait for it, or: rm -rf %s\n' "$_LOCK" >&2
    exit 1
  fi
fi
echo $$ > "$_LOCK/pid"
# Released on every exit path — normal, failed, or interrupted. A lock that survives Ctrl-C
# is a lock someone learns to delete by hand, and then it protects nothing.
trap 'rm -rf "$_LOCK"' EXIT INT TERM
REPO="$(dirname "$M")"
PASS=0; FAIL=0; NOTE=()

ok()   { PASS=$((PASS+1)); printf '  ✅ %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  🔴 %s\n     expected: %s\n     got:      %s\n' "$1" "$2" "$3"; }
eq()   { [ "$2" = "$3" ] && ok "$1" || bad "$1" "$2" "$3"; }
note() { NOTE+=("$1"); printf '  🟡 %s\n' "$1"; }
head2(){ printf '\n\033[1m── %s\033[0m\n' "$1"; }

cd "$M"

# ═══════════════════════════════════════════════════════════════════ F0 · SECURITY
head2 "F0 · SECURITY — is the gate a lock or just a document?"

# ⭐ A NAME THAT LIES IS A FILE THAT DOES NOT GET READ (Brian, 2026-07-31).
# `rule-config-hygiene.md` was about MOVING FILES; the real config rules lived buried in an
# 800-line architecture doc. Result: the AI audited .claude/, pruned 31 permissions, and
# re-derived from scratch criteria that were already written — because the file whose name
# promised them held something else.
# The title is the cheapest possible contract between a filename and its content.
_lying=0
for _r in rules/rule-*.md; do
  _slug=$(basename "$_r" .md | sed 's/^rule-//;s/-/ /g')
  _title=$(head -1 "$_r" | tr 'A-Z' 'a-z')
  _hit=0
  for _w in $_slug; do
    case "$_title" in *"$_w"*) _hit=$((_hit+1)) ;; esac
  done
  # at least one word of the filename must appear in its own H1
  [ "$_hit" -ge 1 ] || { _lying=$((_lying+1)); printf '     ⤷ %s: title does not mention "%s"\n' "$_r" "$_slug"; }
done
eq "every rule file's title matches its filename (a lying name is unread)" "0" "$_lying"

# ⭐ ENGINE vs INSTANCE (Brian, 2026-07-31): "si quiero que Mente OS v2 lo puedan ocupar otras
# personas... un usuario normal no debería hacer estas cosas, su foco es ocupar la herramienta."
#
# The ENGINE (bin/ hooks/) must carry NO path tied to one machine. Measured before the split:
# four validators hardcoded `~/.claude/projects/-home-brianweb3-for3s`, and every one failed
# SILENTLY when it did not resolve — on any other machine the session watch went quiet.
# Whatever is instance-specific is DECLARED in mente.config.yml, never written into code.
[ -f mente.config.yml ] && ok "mente.config.yml exists (the instance declares itself)" \
  || bad "mente.config.yml" "exists" "MISSING — the engine has nowhere to read the instance from"

_hardcoded=$(grep -rlE "/home/[a-z]+/|-home-[a-z]+-" bin/ hooks/ 2>/dev/null \
             | xargs grep -lE "^[^#]*(/home/[a-z]+/|-home-[a-z]+-)" 2>/dev/null | wc -l)
eq "no engine file hardcodes a machine path (config, not code)" "0" "$_hardcoded"

# A missing transcript dir must be REPORTED, never skipped. This is the exact bug the split
# fixed: `if not js: return` turned a guard into a green light on every other machine.
_silent=$(python3 -c "
import sys; sys.path.insert(0,'$M/bin')
import mente_config as c
d, why = c.session_dir()
print(0 if (why is None or why.strip()) else 1)" 2>/dev/null)
eq "a missing transcript dir yields a REASON, not silence" "0" "${_silent:-1}"

# The gate must be enforced by the harness, not by doctrine. Doctrine complies 40-60%.
# 🔴 Found 2026-07-31: this counted EXACTLY 3 rules per target, which silently encoded
# "Read+Edit+Write is the whole surface". It is not — Bash was never covered, so `cat` read
# what `Read` forbade. Proven live: `ls Mente/secrets/` listed the files with no friction.
# Now it asserts the TOOLS covered, not the rule count, so adding coverage never fails the test
# and REMOVING a tool always does.
# ⭐ INSTANCE-SPECIFIC (mente.config.yml · gates). The ENGINE is universal; WHICH trees are
# gated is this instance's declaration. A new user changes the config, never this file.
_GATES=$(python3 -c "
import sys; sys.path.insert(0,'$M/bin')
import mente_config as c
print(' '.join(p.rstrip('/').split('/')[-1] if 'Mente' not in p.split('/')[-1] else '/'.join(p.rstrip('/').split('/')[-2:]) for p,_ in c.gates()))" 2>/dev/null)
[ -n "$_GATES" ] || _GATES="5M-incubathon"
for target in $_GATES; do
  for f in settings.json settings.local.json; do
    n=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/$f'))
rules=[r for r in d['permissions'].get('deny',[]) if '$target' in r]
tools={r.split('(')[0] for r in rules}
print(sum(1 for t in ('Read','Edit','Write') if t in tools))")
    eq "deny for $target in $f (Read+Edit+Write)" "3" "$n"
  done
done

# ⭐ The gap that Read/Edit/Write alone leaves open: a shell reads whatever the file tools refuse.
# Every protected target needs a Bash deny too, or the lock has a back door.
for f in settings.json settings.local.json; do
  n=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/$f'))
dn=[r for r in d['permissions'].get('deny',[]) if r.startswith('Bash(')]
print(sum(1 for k in ('secrets','.ssh','.env','5M-incubathon') if any(k in r for r in dn)))")
  eq "Bash deny covers the protected targets in $f" "4" "$n"
done

# ⭐ CREDENTIALS BEYOND THE FAMOUS THREE (found 2026-07-31 auditing the system against itself).
# check-health's credential guard used a HARDCODED list — .ssh, secrets, .env — so it ran, said
# nothing, and `Read(//home/<user>/**)` exposed the GitHub token, AWS credentials, the GPG
# keyring, ~/.github-token and ~/.git-credentials for months.
#
# Same shape as two other bugs the same day: the deny that covered Read/Edit/Write but not Bash,
# and the test that counted exactly 3 rules per target. A fixed list is a hole with a schedule.
# This asserts COVERAGE of what exists on disk, so a new credential file fails the battery.
for f in settings.json settings.local.json; do
  n=$(python3 -c "
import json,os
d=json.load(open('$REPO/.claude/$f'))
dn=d['permissions'].get('deny',[])
home=os.path.expanduser('~')
targets=[c for c in ('.config/gh','.aws','.gnupg','.github-token','.git-credentials')
         if os.path.exists(os.path.join(home,c))]
print(sum(1 for t in targets if any(t.split('/')[-1] in r for r in dn)) == len(targets) and 1 or 0)")
  eq "every credential store on disk is denied in $f" "1" "$n"
done

# The credential guard must DISCOVER, not consult a list. If someone reverts it to a fixed
# tuple, this catches it: the guard has to name what it found, not what it was told to look for.
grep -q "CRED_NAMES\|CRED_DIRS" bin/check-health \
  && ok "the credential guard discovers instead of consulting a fixed list" \
  || bad "credential guard discovers" "CRED_DIRS scan" "a hardcoded tuple"

# rules/rule-isolation.md §5 promised check-health flags these two. It promised for two days
# and nothing implemented it — a rule in a document promising a rule in code.
grep -q "def check_isolation" bin/check-health \
  && ok "isolation detection exists (rule-isolation.md §5 is not just a promise)" \
  || bad "check_isolation" "implemented" "MISSING — the rule promises what nobody does"

# A broad Read grant with no deny over credentials is an open door nothing was watching.
for f in settings.json settings.local.json; do
  n=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/$f'))
dn=d['permissions'].get('deny',[])
print(sum(1 for k in ('.ssh','secrets','.env') if any(k in r for r in dn)))")
  eq "credential deny rules in $f (.ssh + secrets + .env)" "3" "$n"
done

# The password incident: approved commands are stored verbatim, so a secret there is permanent.
n=$(grep -ohE "sshpass -p '[^']+'|sk-ant-[A-Za-z0-9]{15,}|ghp_[A-Za-z0-9]{20,}" \
     "$REPO/.claude/settings.json" "$REPO/.claude/settings.local.json" 2>/dev/null | wc -l)
eq "no secret VALUES inside approved commands" "0" "$n"

eq "secrets/ is 700 (owner only)" "700" "$(stat -c %a secrets 2>/dev/null || echo MISSING)"
n=$(find secrets -type f ! -perm 600 2>/dev/null | wc -l)
eq "every file in secrets/ is 600" "0" "$n"
( cd "$M" && git check-ignore -q secrets/ ) && ok "secrets/ is gitignored" \
  || bad "secrets/ gitignored" "ignored" "TRACKED"

# A dead path in additionalDirectories is a grant nobody can audit.
n=$(python3 -c "
import json,os
t=0
for f in ('settings.json','settings.local.json'):
    d=json.load(open('$REPO/.claude/'+f))
    t+=sum(1 for e in d['permissions'].get('additionalDirectories',[]) if not os.path.exists(e))
print(t)")
eq "no dead paths in additionalDirectories" "0" "$n"

# ═══════════════════════════════════════════════════════════════════ F1 · STRUCTURE
head2 "F1 · STRUCTURE — do the contracts hold on the real tree?"

for d in rules principles blocks docs bin hooks rules/decisions principles/expertise \
         blocks/active blocks/blocked blocks/archive; do
  [ -d "$d" ] && ok "$d/ exists" || bad "$d/ exists" "directory" "MISSING"
done

./bin/check-blocks --docs >/dev/null 2>&1; c=$?
[ "$c" -le 1 ] && ok "document contract: 0 errors (exit $c)" \
  || bad "document contract" "exit 0 or 1" "exit $c"

# ADR rules: one decision = one file, and a superseded ADR must name its successor.
./bin/check-blocks --adrs >/dev/null 2>&1; c=$?
[ "$c" -le 1 ] && ok "ADR contract: 0 errors (exit $c)" || bad "ADR contract" "exit<=1" "exit $c"
eq "ADR numbering has no gaps" "$(ls rules/decisions/ADR-*.md | wc -l)" \
   "$(ls rules/decisions/ADR-*.md | sed 's/.*ADR-0*\([0-9]*\).*/\1/' | sort -n | tail -1)"

# ⭐ TRACEABILITY — a decision nobody cites is a decision that exists only in a document, and
# this project's own law says that gets obeyed 40-60%. Measured 2026-08-02: 10 of 29 ADRs were
# cited NOWHERE, including "only three closed gates" and "the system audits itself" — all four
# sampled were correctly IMPLEMENTED, just not attributed. So the code obeyed a decision it
# could not name, and a future edit would revert it without anyone noticing.
# Scope: `accepted` only. A superseded/reverted ADR is history and needs no live citer.
_untraced=0; _list=""
for _a in rules/decisions/ADR-*.md; do
  grep -qE "^status: *accepted" "$_a" || continue
  _id=$(basename "$_a" | grep -oE "ADR-[0-9]{3}")
  # Cited anywhere OUTSIDE decisions/ and outside the generated indexes?
  # ⚠️ NO --include filter: every validator in bin/ is extensionless (`generate-index`, not
  # `generate-index.py`), so filtering by extension hides exactly the files that IMPLEMENT the
  # decisions — the check would report a correctly-cited ADR as orphaned. Scan bin/ and hooks/
  # explicitly, and skip .git via the directory list rather than a pattern.
  _n=$(grep -rl "$_id" rules/ principles/ docs/ memory/ bin/ hooks/ blocks/ vision/ work/ \
        "$REPO/CLAUDE.md" "$REPO/PROJECT-RULES.md" 2>/dev/null \
        | grep -vE "rules/decisions/|docs/INDEX\.md|docs/DECISIONS\.md" | wc -l)
  [ "$_n" -eq 0 ] && { _untraced=$((_untraced+1)); _list="$_list $_id"; }
done
# ⚠️ Being CITED is not being IMPLEMENTED. ADR-020 now passes this check because PENDIENTES.md
# §🔗 names it — while `grep -rl receipt hooks/ bin/` still returns 0 files. This check guards
# the weaker property on purpose: an uncited decision is invisible, and invisible is the state
# that lets a future edit revert it silently. Whether the code HONOURS it is what owner-3 and
# the gates measure. Registering a gap is progress; it is not a fix.
[ "$_untraced" -eq 0 ] && ok "every accepted ADR is cited by something that names it" \
  || bad "accepted ADRs with no citer" "0" "$_untraced —$_list"

# ═══════════════════════════════════════════════════════════════════ F2 · OWNERS
head2 "F2 · OWNERS — 3 max + the voice, and every hole asked not assumed"

eq "owner files (0 voice + 3 owners)" "4" "$(ls principles/owner-*.md 2>/dev/null | wc -l)"

# ⭐ THE TREE (Brian, 2026-07-31): expertise files are BRANCHES of an owner, never owners
# themselves. The AI had presented dev-{database,backend,frontend} at the same level as the
# owners; correcting that exposed a real asymmetry — owner-1 and owner-3 had no disciplines at
# all, so they judged with no body of criterion of their own.
#
#   owner-1 · documentation ──▶ doc-planning · doc-structure
#   owner-2 · development   ──▶ dev-database · dev-backend · dev-frontend
#   owner-3 · validation    ──▶ val-functional · val-integration
eq "expertise disciplines (2 doc + 3 dev + 2 val)" "7" \
   "$(ls principles/expertise/*.md 2>/dev/null | wc -l)"

# Every expertise file must declare which owner it branches from, by prefix. A flat list hides
# the tree — which is exactly how the confusion started.
_orphan=0
for _e in principles/expertise/*.md; do
  case "$(basename "$_e")" in doc-*|dev-*|val-*) : ;; *) _orphan=$((_orphan+1)) ;; esac
done
eq "every discipline names its owner by prefix (doc-/dev-/val-)" "0" "$_orphan"

# An owner with no disciplines judges with no criterion of its own — the asymmetry Brian caught.
for _o in doc dev val; do
  [ "$(ls principles/expertise/$_o-*.md 2>/dev/null | wc -l)" -ge 2 ] || \
    bad "owner branch $_o- has at least 2 disciplines" "≥2" "$(ls principles/expertise/$_o-*.md 2>/dev/null | wc -l)"
done
ok "all three owners have their own disciplines (no owner judges without criterion)"

# The master rule of the voice must be present verbatim — it is the one that stops the lying.
grep -qi "do not state" principles/owner-0-voice.md \
  && ok "owner-0 master rule present ('do not state, report the measurement')" \
  || bad "owner-0 master rule" "present" "MISSING"

# §5-BIS is what makes 'verified' mean something. It was missing once and got recovered.
grep -q "5-BIS\|5-bis" principles/owner-3-validation.md \
  && ok "owner-3 carries the §5-BIS battery" || bad "§5-BIS in owner-3" "present" "MISSING"

# Holes must be visible and countable, or they get forgotten as 'done'.
#
# 🔴 BUG in the first version of this battery (2026-07-30): it counted ⬜ in PENDING-BRIAN.md,
# which is the INDEX. It reported 1 hole when 34 exist. The holes live in the SOURCE files —
# counting them where they are not is a false green, which is what this battery exists to catch.
h=$(grep -rho "⬜" rules/qa-dimensions.md principles/expertise/*.md principles/owner-0-voice.md \
     2>/dev/null | wc -l)
note "$h criterion holes still waiting on Brian (in the source files, not the index)"

# The index must not disagree with the source — a lying index is read as truth.
# It must DECLARE its total explicitly (`holes-total: N`). Grepping "the first number in the
# file" read a year as a count in the first version of this battery — a made-up number is worse
# than no number, so the total is now a declared field or nothing.
idx=$(grep -oE "^holes-total:\s*[0-9]+" docs/PENDING-BRIAN.md 2>/dev/null | grep -oE "[0-9]+")
if [ -z "$idx" ]; then
  note "docs/PENDING-BRIAN.md declares no holes-total — nothing to cross-check against"
elif [ "$idx" != "$h" ]; then
  bad "index agrees with the source files" "$h" "$idx (holes-total drifted)"
else
  ok "index holes-total ($idx) matches the source files"
fi

# ═══════════════════════════════════════════════════════════════════ F3 · THE BLOCK
head2 "F3 · THE BLOCK — does it restart from disk alone?"

./bin/check-blocks --blocks >/dev/null 2>&1; c=$?
[ "$c" -le 1 ] && ok "block contract: 0 errors (exit $c)" || bad "block contract" "exit<=1" "exit $c"

./bin/check-sufficiency demo >/dev/null 2>&1
eq "demo passes the sufficiency test (§A-E answer the 7 restart questions)" "0" "$?"

# Negative direction: a block full of placeholders must FAIL, and its exit code must agree with
# its report. A validator whose exit contradicts its output is worse than one that stays silent.
tmp="blocks/active/zz-suff"; mkdir -p "$tmp"
cat > "$tmp/BLOCK.md" <<'PROBE'
# BLOCK · zz-suff
id: blk-zz-suff-2026-07
type: docs
intent: ⬜ PENDING
status: active · lane: direct
owner: brian
created: 2026-07-30 · updated: 2026-07-30
## ✅ IN
- Mente/blocks/active/zz-suff/docs
## ⛔ OUT
- ⬜ PENDING
## Connections
- ISOLATED FROM: everything
## Required standards
- ⬜ PENDING
## State
phase: ⬜ PENDING
PROBE
./bin/check-sufficiency zz-suff >/dev/null 2>&1
eq "a placeholder-filled block FAILS sufficiency (exit agrees with report)" "2" "$?"
rm -rf "$tmp"

./bin/flag-stale >/dev/null 2>&1
eq "no stale or abandoned blocks" "0" "$?"

# 🔴 ORPHAN DIRECTORY — measured 2026-08-02: a folder under blocks/ with no BLOCK.md was invisible
# to check-blocks, check-health AND flag-stale, because every one of them starts its sweep FROM
# BLOCK.md and so can never see its absence. It matters: `blocks/active/*` is the sweep the /clear
# guard depends on, so an orphan is live work nothing watches.
# ⚠️ NOT named zz-*: those are exempt as this battery's own probes, so a zz- probe would measure nothing
# and pass by construction — a check that cannot fail. Baseline first, then the probe.
_base=$(./bin/check-blocks --blocks 2>&1 | grep -c "orphan directory")
_tmp="blocks/active/probe-orphan-f4"; mkdir -p "$_tmp/docs"
_o=$(./bin/check-blocks --blocks 2>&1 | grep -c "orphan directory")
rm -rf "$_tmp"
eq "an orphan block directory is DETECTED (no BLOCK.md inside)" "$((_base + 1))" "$_o"

# Per-section limits are declared in the block's own banners (≤5, ≤15…) and nothing measured them:
# a §E State grown to 40 lines fits the whole-file limit while defeating what §E is for.
_s=$(./bin/check-blocks --blocks 2>&1 | grep -c "over the ≤")
[ "$_s" -ge 0 ] && ok "per-section limits are measured against what the block declares ($_s over)"

# The two levels of OUT: a block must not claim ownership of system-wide rules.
grep -q "System-wide rules" blocks/active/demo/BLOCK.md \
  && ok "demo separates its own OUT from inherited rules" \
  || bad "OUT separation" "present" "MISSING"

# ⭐ The ceiling is READ from the contract, never hardcoded here — it was hardcoded until
# 2026-08-05, so raising it in check-blocks left this check measuring the old number.
cap=$(grep -oE "Max \*\*[0-9]+ lines\*\* total" rules/contract-block.md | grep -oE "[0-9]+")
n=$(wc -l < blocks/active/demo/BLOCK.md)
[ -n "$cap" ] && [ "$n" -le "$cap" ] && ok "BLOCK.md within its ${cap}-line limit ($n)" \
  || bad "BLOCK.md limit" "<=${cap:-?}" "$n"

# ═══════════════════════════════════════════════════════════════════ F4 · MEASURE
head2 "F4 · MEASURE — the verdict must be reproducible, not a mood"

# The whole point: same numbers on two consecutive runs. If they drift, it is an opinion.
a=$(./bin/grade-block demo --root "$REPO/marca-personal" --json 2>/dev/null | python3 -c "
import json,sys;d=json.load(sys.stdin);print(d['verdict'],sorted(d['metrics'].items()))" 2>/dev/null)
b=$(./bin/grade-block demo --root "$REPO/marca-personal" --json 2>/dev/null | python3 -c "
import json,sys;d=json.load(sys.stdin);print(d['verdict'],sorted(d['metrics'].items()))" 2>/dev/null)
[ -n "$a" ] && [ "$a" = "$b" ] && ok "grade-block is deterministic across runs" \
  || bad "determinism" "identical output twice" "drifted or empty"

# ⭐ El código de salida DISTINGUE veredictos — 0 = 🟢 PRODUCT, 2 = 🔴 MVP.
# ⚠️ No se fija el veredicto de `demo`: era `2` mientras el bloque estaba rojo, y el check se
# cayó el día que alcanzó 🟢 PRODUCT de verdad (2026-08-05). **Un check no debe codificar el
# estado en curso de un bloque real** — se vuelve falso justo cuando el trabajo tiene éxito.
# Lo que sí es invariante y vale la pena sujetar: el veredicto medido y el código de salida
# NUNCA se contradicen.
gout="$(./bin/grade-block demo --root "$REPO/marca-personal" 2>/dev/null || true)"
./bin/grade-block demo --root "$REPO/marca-personal" --quiet >/dev/null 2>&1
gexit=$?
case "$gout" in
  *"🟢 PRODUCT"*) want_exit=0 ;;   # grade-block: 0 product · 1 close · 2 MVP
  *"🟡 CLOSE"*)   want_exit=1 ;;
  *)              want_exit=2 ;;
esac
eq "el exit code concuerda con el veredicto medido" "$want_exit" "$gexit"

# ADR-028: the type decides the ruler. A block with no type must be REFUSED, not guessed.
tmp="blocks/active/zz-probe"; mkdir -p "$tmp"
cat > "$tmp/BLOCK.md" <<'PROBE'
# BLOCK · zz-probe
id: blk-zz-probe-2026-07
intent: probe
status: active · lane: direct
owner: brian
created: 2026-07-30 · updated: 2026-07-30
## ✅ IN
- Mente/rules/decisions
## ⛔ OUT
- nothing
## Connections
- ISOLATED FROM: everything
## Required standards
- rules/contract-document.md
## State
phase: probe
PROBE
./bin/grade-block zz-probe --quiet >/dev/null 2>&1
eq "block with NO type is refused (not guessed)" "1" "$?"

# docs type: must NOT report 0 tests as a failure — that was the false-red bug.
printf 'type: docs\n' > /tmp/t && python3 - <<'PY'
p='blocks/active/zz-probe/BLOCK.md'; s=open(p).read()
open(p,'w').write(s.replace('id: blk-zz-probe-2026-07','id: blk-zz-probe-2026-07\ntype: docs'))
PY
out=$(./bin/grade-block zz-probe 2>/dev/null)
printf '%s' "$out" | grep -q "n/a" && ok "docs type prints n/a instead of a false red" \
  || bad "docs n/a" "n/a present" "absent"
printf '%s' "$out" | grep -q "NOT a pass" && ok "n/a is explicitly NOT counted as a pass" \
  || bad "n/a disclaimer" "present" "MISSING"
rm -rf "$tmp"

# ═══════════════════════════════════════════════════════════════════ F5 · VERIFY
head2 "F5 · VERIFY — do the locks actually lock?"

for h in session-start.sh pre-edit-standards.py pre-commit.sh; do
  [ -x "hooks/$h" ] && ok "hooks/$h is executable" || bad "hooks/$h" "executable" "no"
done

# Registered in the PROJECT settings, and the 9 GSD hooks untouched.
n=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/settings.json'))
print(sum(len(e['hooks']) for a in d.get('hooks',{}).values() for e in a))")
# 7 = session-start + pre-edit-standards + gate-critical (F6-3) + gate-handoff (2026-07-31)
#   + gate-secrets + 2 emisores del permiso de secrets, SessionStart y PostCompact (2026-08-05).
# A hardcoded count is on purpose: a hook silently disappearing from settings.json is exactly
# the failure this catches. It fired correctly when gate-handoff was added, y otra vez al
# cablear la puerta de secrets — the count is meant to be updated deliberately, never widened
# to "N or more".
eq "project hooks registered (session-start + standards + 3 gates + 2 leases)" "7" "$n"

# ⭐ THE SEAM: counting 4 says nothing about whether they point at anything real.
# Found 2026-07-31 by breaking settings.json and measuring who noticed: a hook rewritten to
# `gate-BORRADO.py` passed BOTH check-health and this battery. The count was 4, the files
# existed on disk, and all three gates were dead.
# Layer D is "lo ÚNICO que no depende del criterio de la IA" (folder-structure.md) — so its
# wiring gets verified, not assumed.
n=$(python3 -c "
import json, os, re
d = json.load(open('$REPO/.claude/settings.json'))
bad = 0
for arr in (d.get('hooks') or {}).values():
    for e in arr:
        for h in e.get('hooks', []):
            # 🔴 2026-08-03: hooks became portable and this check tested the LITERAL string,
            # so all 4 read as missing while every one of them ran. A guard that does not expand
            # what the shell expands is measuring a path nobody uses.
            # The placeholder is built at runtime: writing it literally here would let the
            # surrounding shell expand it to empty before python ever sees the string.
            _v = chr(36) + 'CLAUDE_PROJECT_DIR'
            _c = h.get('command', '').replace(chr(36) + '{CLAUDE_PROJECT_DIR}', '$REPO') \
                                     .replace(_v, '$REPO')
            m = re.search(r'([^\s\"\']+/(?:hooks|bin)/[\w.-]+)', _c)
            if m and not os.path.exists(m.group(1)):
                bad += 1
print(bad)")
eq "every registered hook points at a file that EXISTS" "0" "$n"

# check-health must report the seam itself — the battery runs on demand, check-health runs
# every session. A gap only the battery catches is a gap you find late.
grep -q "def check_hooks_wired" bin/check-health \
  && ok "check-health verifies the hook wiring, not just the files" \
  || bad "check_hooks_wired" "implemented" "MISSING — only the battery would notice"
n=$(python3 -c "
import json,os;d=json.load(open(os.path.expanduser('~/.claude/settings.json')))
print(sum(len(e['hooks']) for a in d.get('hooks',{}).values() for e in a))")
eq "the 9 global GSD hooks are untouched" "9" "$n"

# The informing hooks must NEVER block, even on garbage input.
./hooks/session-start.sh >/dev/null 2>&1
eq "session-start never blocks" "0" "$?"

# ⭐ THE HEARTBEAT — the guard that reports every other guard leaves proof it ran.
# Structural gap found 2026-07-31: session-start.sh is silent when healthy AND silent when
# dead. A missing warning looks exactly like health, so nothing could tell them apart.
# Cannot be caught in the moment; IS catchable after the fact by stamping a date.
[ -f .heartbeat ] && ok "the startup hook leaves a heartbeat (silence becomes measurable)" \
  || bad ".heartbeat" "written by session-start.sh" "MISSING — dead silence is indistinguishable"

# A stale beat must be LOUD. Tested by aging it past the threshold and restoring.
cp .heartbeat /tmp/hb-probe.bak 2>/dev/null
echo "2026-01-01" > .heartbeat
case "$("$M/bin/check-health" 2>/dev/null || true)" in
  *"STARTUP HOOK SILENT"*) ok "a heartbeat that stopped is reported, not ignored" ;;
  *) bad "stale heartbeat detection" "STARTUP HOOK SILENT" "silent" ;;
esac
cp /tmp/hb-probe.bak .heartbeat 2>/dev/null || ./hooks/session-start.sh >/dev/null 2>&1
rm -f /tmp/hb-probe.bak

# It must never be committed: a beat from another machine masks a dead hook on yours.
( cd "$M" && git check-ignore -q .heartbeat ) && ok ".heartbeat is gitignored (it is per-machine)" \
  || bad ".heartbeat gitignored" "ignored" "TRACKED — would ship another machine's date"

# ── F2 · EACH GATE LEAVES ITS OWN PROOF ──────────────────────────────────────
# F1 covered SessionStart. The gates had the same blind spot for a different reason: one that
# stopped firing looks exactly like one with nothing to block. Measured the day it was built:
# gate-handoff had blocked three launches, and after dozens of edits there was NO way to tell
# whether gate-critical had fired even once.
for _g in gate-critical gate-handoff pre-edit-standards; do
  [ -f ".beats/$_g" ] || bad "gate $_g leaves a beat" "a stamped date" "MISSING"
done
ok "the three gates stamp a beat when they fire"

# ⭐ THE COST DECISION, and why the obvious design was rejected: Write+Edit fired 97 times in
# the session this was built in. Stamping per call = ~194 disk writes on the hot path, and this
# project's own rule is that a gate costing more than it protects gets switched off.
# So the beat writes ONLY when the date changes. This proves it: repeated calls, zero writes.
_before=$(stat -c %Y .beats/gate-handoff 2>/dev/null || echo 0)
for _i in 1 2 3 4 5; do
  printf '{"tool_input":{"subagent_type":"Explore"}}' | ./hooks/gate-handoff.py >/dev/null 2>&1
done
_after=$(stat -c %Y .beats/gate-handoff 2>/dev/null || echo 0)
eq "the beat is idempotent within a day (no write on the hot path)" "$_before" "$_after"

# Telemetry must never change what a gate DOES. If adding the beat altered an exit code, the
# measurement would have broken the thing it measures.
printf '{"tool_input":{"subagent_type":"general-purpose"}}' | ./hooks/gate-handoff.py >/dev/null 2>&1
eq "beating did not change gate-handoff's verdict" "2" "$?"
printf '{"tool_input":{"file_path":"/tmp/zz.md"}}' | ./hooks/pre-edit-standards.py >/dev/null 2>&1
eq "beating did not make pre-edit-standards block" "0" "$?"

( cd "$M" && git check-ignore -q .beats ) && ok ".beats/ is gitignored (per-machine, like the heartbeat)" \
  || bad ".beats gitignored" "ignored" "TRACKED"
printf 'not json' | ./hooks/pre-edit-standards.py >/dev/null 2>&1
eq "pre-edit survives malformed input" "0" "$?"

# It must name the block's standards for a file inside the block, and stay quiet outside.
o=$(printf '{"tool_input":{"file_path":"%s/marca-personal/lib/demo/session.ts"}}' "$REPO" \
    | ./hooks/pre-edit-standards.py 2>&1)
printf '%s' "$o" | grep -q "block \`demo\`" && ok "pre-edit names the owning block" \
  || bad "pre-edit block match" "names demo" "silent"
o=$(printf '{"tool_input":{"file_path":"/tmp/unrelated.txt"}}' | ./hooks/pre-edit-standards.py 2>&1)
[ -z "$o" ] && ok "pre-edit stays silent outside every block" \
  || bad "pre-edit silence" "no output" "$o"

# An unclosed sub-block covering the file is the fix-on-fix pattern. Must warn.
# ⭐ EL SUJETO SE BUSCA, NO SE FIJA (2026-08-06).
# Este check caducó CUATRO veces en un día: apuntaba a `allowedEmails.ts` (borrado al cerrar
# §F-7), luego a `ProfilePanel.tsx` (§F-12 cerrado), luego a `tests/apagar.test.ts` (§F-8
# cerrado). Cada vez se caía **porque el trabajo tuvo éxito**, que es lo contrario de lo que
# un check debe reportar.
# Ahora se lee del §F la primera pieza con estado `active` — así el sujeto se renueva solo.
# Si no hay ninguno abierto, no hay nada que avisar y el check se da por bueno.
_p=$(grep -E '^\| [0-9]+ \|' blocks/active/demo/BLOCK.md \
     | awk -F'|' '$5 ~ /active/ {gsub(/^ +| +$|`/,"",$4); print $4; exit}')
if [ -z "$_p" ]; then
  ok "pre-edit warns on an unclosed sub-block (ninguno abierto: nada que avisar)"
  o="sub-block"
else
o=$(printf '{"tool_input":{"file_path":"%s/marca-personal/%s"}}' "$REPO" "$_p" \
    | ./hooks/pre-edit-standards.py 2>&1)
fi
printf '%s' "$o" | grep -q "sub-block" && ok "pre-edit warns on an unclosed sub-block" \
  || bad "sub-block warning" "warns" "silent"

# ⭐ pre-commit is the only one that blocks. Both directions must be proven.
#
# 🔴 EL ÍNDICE SE REGENERA ANTES, A PROPÓSITO (2026-08-05, sesión S11).
# Esta batería CREA bloques sonda `zz-*` en el árbol real, y `bin/generate-index` los recoge —
# medido: el md5 de `docs/INDEX.md` CAMBIA solo por correr la batería. `pre-commit` rechaza un
# índice desfasado, así que este check fallaba por el efecto secundario de la propia batería,
# no por el estado del repo. Salía 176/1 y a la segunda corrida 175/2: **empeoraba solo**.
# El síntoma era desconcertante porque `./hooks/pre-commit.sh` a mano daba exit 0.
#
# ⭐ Misma familia que el ciclo de `bin/generate-metrics`: un check no puede ser evidencia de
# sí mismo. Aquí se le da el estado que MIDE (el índice al día) en vez de medir su propia basura.
./bin/generate-index >/dev/null 2>&1
./hooks/pre-commit.sh >/dev/null 2>&1
eq "pre-commit passes on a healthy block" "0" "$?"

cp blocks/active/demo/BLOCK.md /tmp/bk.$$
python3 -c "
s=open('blocks/active/demo/BLOCK.md').read()
open('blocks/active/demo/BLOCK.md','w').write(s.replace('type: code\n',''))"
./hooks/pre-commit.sh >/dev/null 2>&1
eq "pre-commit BLOCKS a contract violation" "1" "$?"
cp /tmp/bk.$$ blocks/active/demo/BLOCK.md && rm -f /tmp/bk.$$

# fail-open vs fail-closed — the second bug of F5.
t=$(mktemp -d); ( cd "$t" && git init -q && mkdir -p .git/hooks \
  && cp "$M/hooks/pre-commit.sh" .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit \
  && bash .git/hooks/pre-commit >/dev/null 2>&1 )
eq "pre-commit fails OPEN in a repo with no Mente nearby" "0" "$?"
rm -rf "$t"

# The /clear lock must AGREE with the disk: refuse (1) while this session has no autopsy,
# pass (0) once it does.
# 🔴 The first version asserted a constant 1 — it hard-coded the state of the day it was written
# (2026-07-30, session unregistered). Registering S7 made the lock correctly return 0 and the
# test failed while the system was right. A test that pins today's state is a test that breaks
# the moment the work it guards gets DONE.
# 🔴 This hardcoded ~/.claude/projects/-home-brianweb3-for3s — the engine carrying ONE user's
# path, which is exactly what mente.config.yml exists to prevent (block `distribucion` §F-4).
# Ask the config, which computes the slug from the working directory.
sid=$(ls -t "$(python3 -c "
import sys; sys.path.insert(0,'$M/bin')
import mente_config as c; print(c.session_dir()[0] or '')" 2>/dev/null)"/*.jsonl 2>/dev/null | head -1)
sid=$(basename "${sid:-none}" .jsonl | cut -c1-8)
# Family A (rules/rule-checks-must-measure.md): 8 hex as a bare substring matches inside any
# longer hash. The neighbours must not be hex — same fix as check-clear-ready (8d9f5f3).
if grep -qE "(^|[^0-9a-f])$sid([^0-9a-f]|$)" Cerebro/Registro_Conversaciones.md 2>/dev/null; then want=0; else want=1; fi
# 🔴 `$?` was read INSIDE eq's own arguments, and the $(...) that builds the label runs
# FIRST — so the label's exit code overwrote the one being measured. It only ever showed
# when want=1: with want=0 the clobbered $? happened to match. Capture before anything runs.
./bin/check-clear-ready --quiet >/dev/null 2>&1
_ccr=$?
eq "check-clear-ready agrees with the registry (registered=$( [ $want = 0 ] && echo yes || echo no ))" "$want" "$_ccr"

# Found by the E2E flow 2026-07-30: an EMPTY docs block scored 🟢 PRODUCT — zero broken links
# and zero orphans, because there was nothing to measure. Absence of evidence read as evidence.
tmp="blocks/active/zz-empty"; mkdir -p "$tmp/docs"
cat > "$tmp/BLOCK.md" <<'PROBE'
# BLOCK · zz-empty
id: blk-zz-empty-2026-07
type: docs
intent: probe the empty-scope case
status: active · lane: direct
owner: brian
created: 2026-07-30 · updated: 2026-07-30
## ✅ IN
- Mente/blocks/active/zz-empty/docs
## ⛔ OUT
- nothing
## Connections
- ISOLATED FROM: everything
## Required standards
- rules/contract-document.md
## State
phase: probe
PROBE
o=$(./bin/grade-block zz-empty --root "$REPO" 2>/dev/null)
printf '%s' "$o" | grep -q "NOTHING MEASURED" \
  && ok "an empty scope is NOT graded PRODUCT (nothing measured != passing)" \
  || bad "empty scope" "NOTHING MEASURED" "$(printf '%s' "$o" | grep -oE 'VERDICT.*' | head -1)"
rm -rf "$tmp"

# ═══════════════════════════════════════════════════════════════════ F6 · GUARANTEE
head2 "F6 · GUARANTEE READING — the router and the three gates"

# The 3 levels must EXIST. The whole point is that a rule has a declared level.
for f in "$M/base-rules.md" "$REPO/PROJECT-RULES.md"; do
  [ -f "$f" ] && ok "$(basename "$f") exists" || bad "$(basename "$f")" "exists" "MISSING"
done

# CLAUDE.md is a ROUTER: it points, it does not store. A rule written there has no declared level.
n=$(grep -cE "^- \*\*(NO|NUNCA)|^- \*\*Foco" "$REPO/CLAUDE.md" 2>/dev/null); n=${n:-0}
eq "CLAUDE.md stores no project rules (it routes)" "0" "$n"
# ⭐ CAPABILITIES.md tells the AGENT what it can run and what it must not rewrite. It is the
# piece a new instance needs most and the one nothing covered (measured 2026-08-02: CLAUDE.md
# routes WHERE TO READ, README lists one command). An agent that does not know grade-block
# exists hand-writes a verdict — inventing criterion, which ADR-003 forbids.
# 🔴 It must not describe capabilities that do not exist: a capability map that lies is worse
# than none, because the agent acts on it. Every `bin/x` it names has to be on disk.
_cap="$M/CAPABILITIES.md"
if [ -f "$_cap" ]; then
  _miss=0
  for _b in $(grep -oE '`bin/[a-z0-9-]+' "$_cap" | sed 's/`bin\///' | sort -u); do
    [ -x "bin/$_b" ] || { _miss=$((_miss+1)); printf '     ⤷ names bin/%s which is not executable\n' "$_b"; }
  done
  eq "CAPABILITIES names only validators that exist" "0" "$_miss"
  # 🔴 THE OTHER DIRECTION — added 2026-08-05, and it was the hole. The check above catches the
  # map LYING (naming something absent) but never catches it FORGETTING (a real validator it does
  # not name). Asymmetric, so `bin/init` sat unlisted and nothing said a word: an agent reading the
  # map would not know the installer exists. A capability map that omits is as useless as one that
  # lies — the agent acts on what it reads, and it cannot act on what is not there.
  _unlisted=0
  for _f in bin/*; do
    _n=$(basename "$_f")
    case "$_n" in *.py|__pycache__) continue ;; esac   # modules are imported, not run
    [ -x "$_f" ] || continue
    grep -q "bin/$_n" "$_cap" || { _unlisted=$((_unlisted+1))
      printf '     ⤷ bin/%s exists but the capability map never names it\n' "$_n"; }
  done
  eq "CAPABILITIES names EVERY validator that exists" "0" "$_unlisted"
  grep -q "CAPABILITIES.md" "$REPO/CLAUDE.md" \
    && ok "the router points the agent at its capability map" \
    || bad "CAPABILITIES routing" "CLAUDE.md points at it" "unreferenced — no agent will find it"
else
  bad "CAPABILITIES.md" "exists" "MISSING — the agent has no capability map"
fi

# ⭐ THE INSTALLER (block `distribucion` §F-2/§F-3). `bin/init` turns a fresh clone into someone
# else's instance: it reads mente.config.yml and GENERATES the startup files from templates.
# Proven 2026-08-03 on a real clone with a different owner — 6 mentions of the new owner, ZERO of
# Brian, and a hook of the clone ran against the clone's own path.
[ -x bin/init ] && ok "bin/init exists and is executable" \
  || bad "bin/init" "executable" "missing — a new user has nothing to run"
_tpl=0
for _t in templates/CLAUDE.md.template templates/PROJECT-RULES.md.template; do
  [ -f "$_t" ] || { _tpl=$((_tpl+1)); printf '     ⤷ missing %s\n' "$_t"; continue; }
  # 🔴 A template carrying the current owner's data would install THIS instance on someone
  # else's machine — the exact contamination this block exists to remove.
  _n=$(grep -cE "brian""web3|for3s\.vercel|5M-incubathon" "$_t" 2>/dev/null)
  [ "$_n" -eq 0 ] || { _tpl=$((_tpl+1)); printf '     ⤷ %s carries instance data (%s lines)\n' "$_t" "$_n"; }
done
eq "templates exist and carry no instance data" "0" "$_tpl"

# --check must be a REPORT, never a write: an installer that mutates while inspecting is one
# nobody dares run on an instance that already has work in it.
_before=$(md5sum "$REPO/CLAUDE.md" 2>/dev/null | cut -d' ' -f1)
./bin/init --check >/dev/null 2>&1
_after=$(md5sum "$REPO/CLAUDE.md" 2>/dev/null | cut -d' ' -f1)
eq "bin/init --check touches nothing" "$_before" "$_after"

# ⭐ THE 4 HOOKS MUST BE PORTABLE (block `distribucion` §F-1). They are the three gates plus the
# standards injection: if their paths carry one user's home, a clone starts with NO gate running —
# and it fails SILENTLY, which is the worst outcome for a system whose thesis is that code is
# obeyed 100%. Verified 2026-08-03 against the documented behaviour (`${CLAUDE_PROJECT_DIR}` is
# exported into the hook process and the command runs through `sh -c`), then proven by running
# each hook from /tmp with the variable set: all four ran, and gate-critical still exited 2.
_hp=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/settings.json'))
c=[h['command'] for a in d.get('hooks',{}).values() for e in a for h in e['hooks']]
print(sum(1 for x in c if 'CLAUDE_PROJECT_DIR' in x), len(c))" 2>/dev/null)
eq "all registered hooks use a portable path" "${_hp##* } ${_hp##* }" "$_hp"

# ⭐ THE ENGINE CARRIES NO ONE'S NAME (block `distribucion` §F-4). mente.config.yml exists so a
# new user edits ONE file — its own header says "if they ever have to touch bin/ to make the
# system work, this separation failed". Measured 2026-08-03: bin/test-f0-f6 had the session path
# `-home-brianweb3-for3s` hardcoded, so the engine shipped with one user's identity inside it.
# ⚠️ COMMENTS ARE EXEMPT ON PURPOSE: four validators document the incident where that same path
# was hardcoded. Deleting that history to satisfy a grep would erase the reason the rule exists —
# dated evidence stays (rules/contract-document.md §0-bis). Only executable lines are measured.
_dirty=0
for _f in bin/* hooks/* rules/*.md principles/*.md; do
  case "$_f" in *__pycache__*|*.md) [ "${_f##*.}" = "md" ] && continue;; esac
  [ -f "$_f" ] || continue
  # The pattern is split so this check does not match ITSELF — measured: it flagged its own
  # grep line. And a docstring BODY (no leading quotes) is prose too: python modules explain
  # the incident across several lines, so anything without code punctuation is exempt.
  _n=$(grep -nE "/home/[a-z]|brian""web3" "$_f" 2>/dev/null \
       | grep -vE ':[[:space:]]*#|"""|`|^[0-9]+:[^=(]*$' | wc -l)
  [ "$_n" -eq 0 ] || { _dirty=$((_dirty+1)); printf '     ⤷ %s has %s executable line(s) with a personal path\n' "$_f" "$_n"; }
done
eq "no engine FILE carries an owner name or absolute path in code" "0" "$_dirty"

# ⭐ THE ENGINE/INSTANCE LINE as a LOCK, not a paragraph (block `distribucion` §F-6).
# CAPABILITIES.md §1 tells the agent it may run the engine but not rewrite it. In prose that is
# this project's own 40-60% case. These verify the mechanism behind it — and that it is PORTABLE:
# rules written with an absolute path do not survive a clone, which is the whole point of the block.
_eng=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/settings.json'))['permissions']
print(len([r for r in d.get('ask',[]) if 'CLAUDE_PROJECT_DIR/Mente' in r and
      any(x in r for x in ('/bin/','/hooks/','/rules/','/principles/'))]))" 2>/dev/null)
[ "${_eng:-0}" -ge 8 ] && ok "engine is write-gated on Edit+Write, portably ($_eng rules)" \
  || bad "engine boundary" "≥8 portable ask rules" "${_eng:-0} — the agent can rewrite its own validators"

# 🔴 Edit/Write do NOT cover Bash: measured 2026-08-03, a python one-liner rewrote a file under
# bin/ without touching the Edit rule. Same tool-shaped back door as §1.5.
_bash=$(python3 -c "
import json;d=json.load(open('$REPO/.claude/settings.json'))['permissions']
print(len([r for r in d.get('ask',[]) if r.startswith('Bash(') and 'Mente/bin/' in r]))" 2>/dev/null)
[ "${_bash:-0}" -ge 5 ] && ok "engine write CHANNELS via Bash are gated too ($_bash on bin/)" \
  || bad "engine bash channels" "≥5" "${_bash:-0} — Edit is gated but tee/sed/cp are not"

grep -q "PROJECT-RULES.md" "$REPO/CLAUDE.md" && ok "CLAUDE.md routes to PROJECT-RULES.md" \
  || bad "router" "points at PROJECT-RULES.md" "does not"

# ⭐ Nothing was lost in the migration: the gate and server-first must still be findable.
# ⭐ INSTANCE-SPECIFIC: the owner name comes from mente.config.yml, the rest are engine rules.
_OWNER=$(python3 -c "
import sys; sys.path.insert(0,'$M/bin')
import mente_config as c; print(c.owner_name())" 2>/dev/null)
for k in "acceder mente" "Server-first" "KEK" "$_OWNER"; do
  grep -qi "$k" "$REPO/PROJECT-RULES.md" && ok "PROJECT-RULES carries: $k" \
    || bad "migrated rule: $k" "present" "LOST"
done

# ⭐ The four checks above ask "is it WRITTEN?" — which was their job: proving the migration lost
# nothing. They do NOT ask whether the rule GOVERNS. Measured 2026-08-02: §1 and §2 are backed by
# deny rules, §3 only by an `ask`, and §4's KEK by nothing at all — while the file presented them
# all identically. These verify the MECHANISM behind each rule that can have one.
_perm="$REPO/.claude/settings.json"
_n=$(python3 -c "
import json;d=json.load(open('$_perm'))['permissions']
print(len([r for r in d['deny'] if '5M-incubathon' in r]))" 2>/dev/null)
[ "${_n:-0}" -ge 3 ] && ok "§3 the gate is a LOCK: $_n deny rules on the other Mente OS" \
  || bad "§3 gate enforcement" "≥3 deny rules" "${_n:-0} — the gate is doctrine again"

_n=$(python3 -c "
import json;d=json.load(open('$_perm'))['permissions']
print(len([r for r in d['deny'] if 'marca-personal/Mente' in r]))" 2>/dev/null)
[ "${_n:-0}" -ge 3 ] && ok "§2 out-of-scope is a LOCK: $_n deny rules on marca-personal/Mente" \
  || bad "§2 scope enforcement" "≥3 deny rules" "${_n:-0}"

# §3 is the only rule with a PRODUCTION consequence: Vercel deploys from main, so a push to main
# IS a deploy. `Bash(git push *)` requires an argument — the bare `git push`, the commonest form
# on a branch with upstream, was uncovered until today.
_n=$(python3 -c "
import json;d=json.load(open('$_perm'))['permissions']
print(len([r for r in d.get('ask',[])+d['deny'] if 'git push' in r]))" 2>/dev/null)
[ "${_n:-0}" -ge 2 ] && ok "§4 server-first: $_n rules cover git push (bare form included)" \
  || bad "§4 push enforcement" "≥2 rules (bare + argument forms)" "${_n:-0}"

# The file must SAY which rules nothing can enforce. A rule presented as a lock when it is
# discipline is worse than one honestly labelled.
grep -q "WHICH RULES ARE LOCKS" "$REPO/PROJECT-RULES.md" \
  && ok "PROJECT-RULES declares which rules are locks and which are discipline" \
  || bad "enforcement table" "present" "MISSING — doctrine reads as enforcement"

# base-rules must no longer be the SOURCE of the 2 project rules — only a pointer.
grep -q "PROJECT-RULES.md" "$M/base-rules.md" \
  && ok "base-rules points the 2 project rules at their new level" \
  || bad "base-rules pointer" "present" "MISSING"

[ -x "hooks/gate-critical.py" ] && ok "hooks/gate-critical.py is executable" \
  || bad "gate-critical" "executable" "no"

# GATE 2 · the database — both directions.
printf '{"tool_input":{"file_path":"db/003_migration.sql","content":"DROP TABLE x;"}}' \
  | ./hooks/gate-critical.py >/dev/null 2>&1
eq "GATE db: BLOCKS a destructive migration with no rollback" "2" "$?"
printf '{"tool_input":{"file_path":"db/003_migration.sql","content":"DROP TABLE x;\n-- down\nCREATE TABLE x (id int);"}}' \
  | ./hooks/gate-critical.py >/dev/null 2>&1
eq "GATE db: allows the same migration WITH a rollback" "0" "$?"

# GATE 3 · closing a block over open sub-blocks.
# No trailing \n in the JSON string: printf would emit it as a literal backslash-n inside the
# value, and the hook's `^status:\s*closed` never matched. Caught 2026-07-30 — the gate blocked
# correctly by hand and passed in the battery, which is the worst kind of disagreement.
printf '{"tool_input":{"file_path":"%s/blocks/active/demo/BLOCK.md","content":"status: closed"}}' "$M" \
  | ./hooks/gate-critical.py >/dev/null 2>&1
eq "GATE close: BLOCKS closing over open sub-blocks" "2" "$?"
printf '{"tool_input":{"file_path":"%s/blocks/active/demo/BLOCK.md","content":"updated: 2026-07-30\n"}}' "$M" \
  | ./hooks/gate-critical.py >/dev/null 2>&1
eq "GATE close: does NOT obstruct a normal edit of BLOCK.md" "0" "$?"

# GATE 1 · deliberately a WARNING. Blocking the daily path would be pure friction.
printf '{"tool_input":{"file_path":"%s/marca-personal/lib/demo/session.ts","content":"x"}}' "$REPO" \
  | ./hooks/gate-critical.py >/dev/null 2>&1
eq "GATE deps: WARNS but never blocks (12 dependents)" "0" "$?"

# F6-4 · declared standards must show evidence of use.
./bin/check-applied demo --quiet >/dev/null 2>&1
eq "every §D standard the demo declares was actually APPLIED" "0" "$?"

# ═══════════════════════════════════════════════════════════════════ STRUCTURE
head2 "TREE — is the folder structure the one the design declared?"

[ -x "bin/check-structure" ] && ok "bin/check-structure exists" \
  || bad "check-structure" "executable" "MISSING"
[ -x "bin/generate-index" ] && ok "bin/generate-index exists" \
  || bad "generate-index" "executable" "MISSING"

# The generated indexes must EXIST and be CURRENT. A stale index is read as truth.
for f in docs/INDEX.md docs/STATES.md; do
  [ -f "$f" ] && ok "$f is generated" || bad "$f" "exists" "MISSING"
done
# Earlier sections of this battery create and delete probe blocks, which legitimately changes
# what the index should contain. Regenerate first, THEN assert the check is clean — otherwise the
# battery fails on its own side effects, which teaches you to ignore a real staleness report.
./bin/generate-index >/dev/null 2>&1
./bin/generate-index --check >/dev/null 2>&1
eq "the generated indexes are up to date after regenerating" "0" "$?"

# ⭐ NO LIVE DOCUMENT CARRIES A NUMBER THAT METRICS PUBLISHES (Brian, 2026-07-31):
#   "que sea un apuntador... no podemos depender de que actualices, porque se te puede ir."
#
# Measured twice the same day: RETOMAR.md froze the battery at 105/105 (it was 104 — the count
# is not even stable across a /clear), and SKILL.md — written HOURS after that fix — froze 105
# again when it was already 118. Same author, same mistake, same day. A number copied into
# prose is correct exactly once, so the fix is removing the copy, not trying harder.
#
# Scope is deliberately narrow: only the documents a session actually steers by. Execution logs,
# the registry and archives are DATED EVIDENCE — a measurement of a moment that must not change.
_frozen=0
# 🔴 CLAUDE.md was NOT on this list until 2026-08-02 — the one document loaded on EVERY session
# start, and the only one no session can choose to skip. It carried `103/103` (already 141),
# `v0.19.0` (already v0.20.0) and "F8 al 75%" (F8 closed), frozen since 30-jul.
# ⭐ Same shape as the S8 finding, one level up: a list enumerating what is PROTECTED, one entry
# short. The steering documents were guarded; the one that steers FIRST was not.
for _d in memory/RETOMAR.md docs/architecture/how-it-runs.md \
          "$REPO/CLAUDE.md" "$REPO/PROJECT-RULES.md" \
          "$REPO/.claude/skills/session-wrap/SKILL.md"; do
  [ -f "$_d" ] || continue
  # "N/N" battery scores and "N checks" are the shapes that went stale in practice.
  _hits=$(grep -oE "\b1[0-9]{2}/1[0-9]{2}\b|\b[0-9]{2,3} checks\b" "$_d" 2>/dev/null | wc -l)
  [ "$_hits" -eq 0 ] || { _frozen=$((_frozen+1)); printf '     ⤷ %s carries %s frozen count(s)\n' "$_d" "$_hits"; }
done
eq "no live document freezes a metric METRICS.md publishes" "0" "$_frozen"

[ -f docs/METRICS.md ] && ok "docs/METRICS.md exists (the single place a live number lives)" \
  || bad "docs/METRICS.md" "exists" "MISSING — run bin/generate-metrics"

# Regeneration must be DETERMINISTIC — twice in a row cannot differ, or --check is meaningless.
./bin/generate-index >/dev/null 2>&1
a=$(md5sum docs/INDEX.md docs/STATES.md | md5sum)
./bin/generate-index >/dev/null 2>&1
b=$(md5sum docs/INDEX.md docs/STATES.md | md5sum)
eq "regenerating twice produces identical output" "$a" "$b"

# ⭐ A hand edit must be DETECTED — that is the whole point of generating.
printf '\nHAND EDIT\n' >> docs/INDEX.md
./bin/generate-index --check >/dev/null 2>&1
eq "a hand edit to a generated index is DETECTED" "1" "$?"
./bin/generate-index >/dev/null 2>&1

# ⭐ THE POINTER SYSTEM — the test that makes it real (P4).
# Move a file, update ONE line in piezas.tsv, and everything follows. If this fails, the pointer
# system is decoration and the diagram will drift again.
[ -f Maestro/piezas.tsv ] && ok "Maestro/piezas.tsv exists (single source of piece locations)" \
  || bad "piezas.tsv" "exists" "MISSING"

# Every declared piece must resolve. A pointer to nothing is worse than no pointer.
miss=$(python3 - <<'PY'
import os
bad = 0
for line in open("Maestro/piezas.tsv", encoding="utf-8", errors="replace"):
    if line.startswith("#") or not line.strip():
        continue
    f = line.rstrip("\n").split("\t")
    if len(f) >= 5 and not os.path.exists(f[1].replace("repo:", "")):
        print(f"     {f[0]} -> {f[1]}")
        bad += 1
print(f"COUNT={bad}")
PY
)
printf '%s\n' "$miss" | grep -v COUNT
eq "every piece declared in piezas.tsv exists" "0" "$(printf '%s' "$miss" | grep -oE 'COUNT=[0-9]+' | cut -d= -f2)"

# ⭐ THE REAL TEST: move a piece, update only the pointer, and check-structure must follow.
mv bridges/Puentes_Mente_OS.md /tmp/gate.bak
