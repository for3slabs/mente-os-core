#!/usr/bin/env python3
"""secrets-lease — la CREDENCIAL de Mente OS para `Mente/secrets/`, atada al caché.

⭐ EL DISEÑO, en una frase (Brian, 2026-08-05):
   **El permiso nace cuando nace el contexto y muere cuando el contexto se recarga.**

Antes de esto, `secrets/` era inalcanzable: 14 reglas `deny`. Eso protegía el archivo pero
rompía el trabajo — Mente OS no podía entrar al servidor, ni añadir el secreto de un segundo
servidor, ni consultar cuál necesitaba. Y la alternativa que Brian rechazó, con razón, era
pedírselo en cada mensaje: *"no tengo que estarte pidiendo lee Mente OS, y así no me causa
duda a mí en decir ¿sí lo estarás haciendo en el servidor?"*.

── POR QUÉ ATADO AL CACHÉ Y NO A UN RELOJ ──────────────────────────────────────
Un permiso "de 60 minutos" es arbitrario: no corresponde a nada real. El caché sí. Cuando el
contexto se recarga, Mente OS vuelve a leer su arranque desde cero — CLAUDE.md, las reglas, el
estado. Que el permiso se conceda ahí lo hace parte del arranque, igual que las reglas: se lee
una vez, vale mientras dure esa carga, y se renueva sola en la siguiente.

Dos eventos recargan el contexto, y el permiso muere en LOS DOS:
  · `SessionStart`  — la sesión arranca o se retoma
  · `PostCompact`   — auto-compactación a mitad de sesión (pasó varias veces el 2026-08-05)

── LO QUE ESTO NO ES ───────────────────────────────────────────────────────────
⛔ **No levanta el `deny`.** `PROJECT-RULES.md` §3: *"never propose lifting a deny for
convenience"* — esa regla nació porque la versión de palabra se violó 6 veces en una sesión.
El `deny` de ESCRITURA sigue intacto: crear, editar o borrar en `secrets/` sigue preguntando
siempre, tenga o no permiso vivo. Lo que el permiso abre es la LECTURA.

⛔ **No es silencioso.** Toda operación queda en `Mente/secrets/.access-log.md`: qué archivo,
cuándo y con qué motivo — nunca su contenido. Ese es el *"mira, tú accediste e hiciste esto"*.

Uso:
  bin/secrets-lease open [--source startup|compact]   emite el permiso (lo llama el hook)
  bin/secrets-lease check                             ¿hay permiso vivo? exit 0 sí · 1 no
  bin/secrets-lease log <op> <archivo> [motivo]       escribe en la bitácora
  bin/secrets-lease status                            estado legible

Exit: 0 ok · 1 sin permiso
"""
import json
import os
import sys
import time
from datetime import datetime, timezone

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LEASE = os.path.join(MENTE, ".secrets-lease.json")
LOG = os.path.join(MENTE, "secrets", ".access-log.md")

# ⚠️ El permiso NO se guarda dentro de secrets/: los 14 `deny` bloquean escribir ahí, así que
# el propio otorgante no podría emitirlo. Vive en la raíz de Mente y va al .gitignore —
# un permiso commiteado sería un permiso que viaja a otra máquina, que es lo contrario de atarlo
# a ESTE caché.


def emitir(source):
    """Abre el permiso. Lo llama el hook de arranque, nunca a mano."""
    datos = {
        "abierto": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "epoch": int(time.time()),
        "source": source,
        "pid_arranque": os.getppid(),
    }
    with open(LEASE, "w", encoding="utf-8") as fh:
        json.dump(datos, fh, indent=1)
    return datos


def leer():
    try:
        with open(LEASE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def vivo():
    """¿Hay permiso? Existe = vivo. Muere porque el hook lo REESCRIBE en la siguiente carga.

    ⭐ No hay comprobación de reloj a propósito: la caducidad no es temporal, es de contexto.
    Un permiso que expira por minutos caducaría a media tarea; este caduca exactamente cuando
    Mente OS vuelve a leerse a sí mismo, que es cuando el permiso se renueva de todas formas."""
    return leer() is not None


def anotar(op, archivo, motivo=""):
    """Escribe en la bitácora. ⛔ Registra el NOMBRE del archivo, jamás su contenido."""
    sello = datetime.now().strftime("%Y-%m-%d %H:%M")
    linea = f"| {sello} | {op.upper():6s} | `{os.path.basename(archivo)}` | {motivo or '—'} |\n"
    nuevo = not os.path.exists(LOG)
    try:
        with open(LOG, "a", encoding="utf-8") as fh:
            # 🔴 600 DESDE EL NACIMIENTO, no después (cazado por la batería, 2026-08-05).
            # `open()` la creó 644 — legible por cualquier usuario de la máquina, dentro de un
            # directorio que exige 600. La bitácora no lleva secretos, pero SÍ lleva qué archivo
            # se consultó y cuándo: un mapa de dónde mirar. Se ajusta con el fichero ya abierto
            # para que no exista ni un instante con permisos flojos.
            try:
                os.chmod(LOG, 0o600)
            except OSError:
                pass
            if nuevo:
                fh.write(
                    "# BITÁCORA DE ACCESO A `secrets/`\n"
                    "**Status:** current · **Type:** append-only · **Owner:** brian\n\n"
                    "## Purpose\n\nQuién entró a `secrets/`, cuándo y para qué. La escribe\n"
                    "`bin/secrets-lease`, nunca a mano. ⛔ Registra el NOMBRE del archivo,\n"
                    "**nunca su contenido** — una bitácora que copia el secreto lo duplica.\n\n"
                    "| cuándo | qué | archivo | motivo |\n|---|---|---|---|\n"
                )
            fh.write(linea)
        return True
    except OSError:
        return False   # ⛔ la bitácora nunca rompe el trabajo: si falla, se sigue


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 1
    cmd = args[0]

    if cmd == "open":
        src = args[args.index("--source") + 1] if "--source" in args else "startup"
        d = emitir(src)
        print(f"🔑 permiso de secrets ABIERTO ({d['source']}) — vive hasta la próxima recarga")
        return 0

    if cmd == "check":
        return 0 if vivo() else 1

    if cmd == "log":
        if len(args) < 3:
            print("uso: bin/secrets-lease log <op> <archivo> [motivo]")
            return 1
        anotar(args[1], args[2], " ".join(args[3:]))
        return 0

    if cmd == "status":
        d = leer()
        if not d:
            print("🔒 sin permiso — se abre solo en la próxima carga de contexto")
            return 1
        print(f"🔑 permiso VIVO desde {d['abierto']} (origen: {d['source']})")
        print(f"   muere cuando el contexto se recargue (SessionStart o PostCompact)")
        if os.path.exists(LOG):
            n = sum(1 for line in open(LOG, encoding="utf-8") if line.startswith("| 20"))
            print(f"   bitácora: {n} acceso(s) registrado(s) en secrets/.access-log.md")
        return 0

    print(f"🔴 comando desconocido: {cmd}")
    return 1


if __name__ == "__main__":
    sys.exit(main())