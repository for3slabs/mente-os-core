#!/usr/bin/env bash
# verify-all — TODO lo que Mente OS v2 sabe verificar, en una sola corrida.
#
# ⭐ POR QUÉ EXISTE (Brian, 2026-08-06): *"todas las pruebas de funcionalidad que hemos hecho a
# lo largo de v2, vuelve a implementarlas para verificar que nada se omitió"*.
#
# 🔴 El problema que cierra: las pruebas de v2 se fueron construyendo por frentes y quedaron
# REPARTIDAS — la batería (`bin/test-f0-f6`), los validadores sueltos, los tests de la demo
# (otro repo, otro corredor), y varias comprobaciones que solo existieron como comandos sueltos
# en una conversación. **Lo que solo se probó una vez no está probado: está recordado.**
#
# Este script no reimplementa nada: INVOCA lo que ya existe y añade los frentes que no tenían
# dueño (robustez de hooks ante basura, aislamiento, idempotencia, comportamiento en un clon).
#
# ⛔ NO sustituye a `bin/test-f0-f6`. Aquella es la puerta rápida que corre en cada commit;
# ésta es la revisión completa, más lenta, para antes de un release o tras un cambio grande.
#
# Uso:  bin/verify-all            todo
#       bin/verify-all --rapido   omite los frentes lentos (clon, demo)
#
# Exit: 0 todo verde · 1 algo falló
set -uo pipefail
M="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(dirname "$M")"
cd "$M"
RAPIDO=0; [ "${1:-}" = "--rapido" ] && RAPIDO=1

PASS=0; FAIL=0; OMIT=0
declare -a FALLOS

ok()   { PASS=$((PASS+1)); printf '  \033[32m✅\033[0m %s\n' "$1"; }
mal()  { FAIL=$((FAIL+1)); FALLOS+=("$1 — esperaba: $2 · obtuvo: $3")
         printf '  \033[31m🔴\033[0m %s\n     esperaba: %s\n     obtuvo:   %s\n' "$1" "$2" "$3"; }
omit() { OMIT=$((OMIT+1)); printf '  \033[33m⬜\033[0m %s (omitido: %s)\n' "$1" "$2"; }
frente(){ printf '\n\033[1m── %s\033[0m\n' "$1"; }

# ══════════════════════════════════════════════════════════ F1 · LA BATERÍA
frente "F1 · LA BATERÍA COMPLETA — la verificación central de v2"
_b=$(./bin/test-f0-f6 2>&1)
_p=$(printf '%s' "$_b" | grep -oE 'passed: [0-9]+' | grep -oE '[0-9]+')
_f=$(printf '%s' "$_b" | grep -oE 'failed: [0-9]+' | grep -oE '[0-9]+')
[ "${_f:-1}" = "0" ] && ok "test-f0-f6: ${_p:-?} checks, 0 fallos" \
                     || mal "test-f0-f6" "failed: 0" "failed: ${_f:-ERR}"

# ══════════════════════════════════════════════════════ F2 · VALIDADORES
frente "F2 · LOS VALIDADORES — ninguno revienta, y su exit code dice la verdad"
for v in check-links check-blocks check-health check-structure check-clear-ready \
         flag-stale generate-index generate-metrics; do
  [ -x "bin/$v" ] || { omit "$v" "no existe"; continue; }
  _o=$(timeout 300 "bin/$v" 2>&1); _c=$?
  if printf '%s' "$_o" | grep -q "Traceback"; then
    mal "$v" "sin traceback" "revienta"
  elif [ "$_c" -gt 2 ]; then
    mal "$v" "exit 0/1/2" "exit $_c"
  elif printf '%s' "$_o" | grep -q "🔴" && [ "$_c" = "0" ]; then
    mal "$v" "exit != 0 al imprimir 🔴" "dice 🔴 y devuelve 0"
  else
    ok "$v (exit $_c, coherente con su salida)"
  fi
done

# ══════════════════════════════════════════════════ F3 · HOOKS · robustez
frente "F3 · LOS HOOKS ANTE ENTRADA BASURA — un hook que revienta no protege"
BASURA=('' 'no soy json' '{}' '[]' 'null' '{"tool_input":null}' '{"tool_input":[]}'
        '{"tool_input":{"file_path":null}}')
for h in pre-edit-standards gate-critical gate-handoff gate-secrets; do
  [ -f "hooks/$h.py" ] || { omit "$h.py" "no existe"; continue; }
  _bad=""
  for b in "${BASURA[@]}"; do
    _o=$(printf '%s' "$b" | python3 "hooks/$h.py" 2>&1); _c=$?
    printf '%s' "$_o" | grep -q "Traceback" && _bad="traceback con ${b:0:16}"
    [ "$_c" -gt 2 ] && _bad="exit $_c con ${b:0:16}"
  done
  [ -z "$_bad" ] && ok "$h.py aguanta los ${#BASURA[@]} tipos de basura" \
                 || mal "$h.py robustez" "exit 0/2 sin traceback" "$_bad"
done

# ══════════════════════════════════════════════════ F4 · PUERTAS · bloquean
frente "F4 · LAS PUERTAS BLOQUEAN LO SUYO — y callan fuera de su alcance"
printf '{"tool_input":{"file_path":"db/9_m.sql","content":"DROP TABLE x;"}}' \
  | python3 hooks/gate-critical.py >/dev/null 2>&1
[ $? = 2 ] && ok "gate-critical BLOQUEA una migración destructiva sin rollback" \
           || mal "gate-critical db" "exit 2" "dejó pasar"

printf '{"tool_input":{"file_path":"db/9_m.sql","content":"DROP TABLE x;\n-- down\nCREATE TABLE x (id int);"}}' \
  | python3 hooks/gate-critical.py >/dev/null 2>&1
[ $? = 0 ] && ok "…y PERMITE la misma migración CON rollback" \
           || mal "gate-critical rollback" "exit 0" "bloqueó una migración válida"

_o=$(printf '{"tool_name":"Write","tool_input":{"file_path":"%s/secrets/x.md","content":"x"}}' "$M" \
     | python3 hooks/gate-secrets.py 2>/dev/null)
printf '%s' "$_o" | grep -q '"ask"' && ok "gate-secrets: ESCRITURA pregunta siempre" \
                                    || mal "gate-secrets escritura" "ask" "$_o"

_o=$(printf '{"tool_name":"Read","tool_input":{"file_path":"%s/CAPABILITIES.md"}}' "$M" \
     | python3 hooks/gate-secrets.py 2>/dev/null)
[ -z "$_o" ] && ok "gate-secrets CALLA fuera de secrets/" \
             || mal "gate-secrets silencio" "sin salida" "$_o"

# 🔴 Fail-closed: con el emisor caído NO concede.
mv bin/secrets-lease bin/secrets-lease.verify-off 2>/dev/null
_o=$(printf '{"tool_name":"Read","tool_input":{"file_path":"%s/secrets/x.md"}}' "$M" \
     | python3 hooks/gate-secrets.py 2>/dev/null)
mv bin/secrets-lease.verify-off bin/secrets-lease 2>/dev/null
printf '%s' "$_o" | grep -q '"allow"' \
  && mal "gate-secrets fail-closed" "ask" "CONCEDIÓ con el emisor caído" \
  || ok "gate-secrets FAIL-CLOSED: emisor caído → pregunta, no concede"

# ═════════════════════════════════════════════ F5 · EVASIÓN de la puerta
frente "F5 · EVASIÓN — ¿una ruta construida burla la puerta de secrets?"
_ev=0
for r in "$M/secrets/../secrets/x.md" "$M/./secrets/x.md" "$M/blocks/../secrets/x.md" "$M/secrets//x.md"; do
  _o=$(printf '{"tool_name":"Write","tool_input":{"file_path":"%s","content":"x"}}' "$r" \
       | python3 hooks/gate-secrets.py 2>/dev/null)
  printf '%s' "$_o" | grep -q '"ask"' || { _ev=$((_ev+1)); }
done
[ "$_ev" = "0" ] && ok "4 rutas construidas (../ · ./ · doble barra) NO burlan la puerta" \
                 || mal "evasión" "0 burlas" "$_ev ruta(s) se colaron"

# ══════════════════════════════════════════ F6 · IDEMPOTENCIA y AISLAMIENTO
frente "F6 · IDEMPOTENCIA — dos corridas seguidas dicen lo mismo"
for v in check-links check-blocks check-structure; do
  _1=$(timeout 300 "bin/$v" 2>&1); _2=$(timeout 300 "bin/$v" 2>&1)
  [ "$_1" = "$_2" ] && ok "$v es determinista" \
                    || mal "$v idempotencia" "misma salida" "cambió entre corridas"
done

# ═══════════════════════════════════════════ F7 · LOS TESTS DE LA DEMO
frente "F7 · LOS 4 CAMINOS CRÍTICOS DE LA DEMO"
if [ "$RAPIDO" = "1" ]; then
  omit "tests de la demo" "--rapido"
elif [ -d "$REPO/marca-personal/tests" ]; then
  _t=$(cd "$REPO/marca-personal" && timeout 600 npx vitest run 2>&1 | grep -E "^ +Tests +")
  if printf '%s' "$_t" | grep -q "failed"; then
    mal "tests de la demo" "0 failed" "$(printf '%s' "$_t" | tr -s ' ')"
  else
    ok "demo:$(printf '%s' "$_t" | sed 's/ *Tests */ /')"
  fi
else
  omit "tests de la demo" "marca-personal/tests no existe"
fi

# ═══════════════════════════════════════════════ F8 · EL CLON (portabilidad)
frente "F8 · UN CLON LIMPIO — lo único que ningún check interno puede sustituir"
if [ "$RAPIDO" = "1" ]; then
  omit "clon limpio" "--rapido"
else
  _tmp=$(mktemp -d)
  if timeout 400 git clone -q "$REPO" "$_tmp/c" 2>/dev/null; then
    if [ -x "$_tmp/c/Mente/bin/check-blocks" ]; then
      (cd "$_tmp/c/Mente" && timeout 300 bin/check-blocks >/dev/null 2>&1)
      [ $? -le 1 ] && ok "un clon corre check-blocks sin errores" \
                   || mal "clon check-blocks" "exit 0/1" "falló"
      for f in LICENSE CLAUDE.md PROJECT-RULES.md .claude/settings.json Mente/piezas.tsv; do
        [ -e "$_tmp/c/$f" ] && ok "el clon trae $f" || mal "clon $f" "presente" "falta"
      done

      # ⭐ Y LA BATERÍA COMPLETA, DENTRO DEL CLON (2026-08-07).
      # 🔴 El hueco que esto cierra: F8 solo corría `check-blocks` y comprobaba 4 archivos, así
      # que daba VERDE mientras la batería fallaba 22 veces ahí dentro. Lo descubrió una
      # auditoría externa, no este script. **Un frente que dice "clon limpio" y no corre lo que
      # importa mide su propio nombre, no el clon.**
      #
      # ⚠️ El techo NO es 0, y es deliberado: unos 9 de esos fallos son el sistema fallando
      # CERRADO ante una instancia sin configurar (`settings.local.json` que no viaja, sesión no
      # registrada, `{{OWNER}}` sin resolver) — eso es correcto, no deuda. Lo que se prohíbe es
      # que EMPEORE. El techo baja con la deuda, igual que WARN_CAP en pre-commit.
      # 📊 Medido 2026-08-07: 21 desde un clon LOCAL (`git clone .`) y 16 desde uno de GitHub.
      # La diferencia son latidos (`.beats/`) y `mente.config.yml`, que no viajan y aquí sí
      # existían — el clon local es el caso MÁS DURO, así que el techo se fija sobre él.
      # ⭐ ESTE ES EL GUARDIÁN DE LA FAMILIA D de `rules/rule-checks-must-measure.md`:
      # *un check que exige algo que por diseño no viaja mide la máquina, no el sistema*.
      # Ningún check interno puede detectarla —por definición pasa en el árbol del autor—, así
      # que la única prueba es correr la batería DENTRO de un clon y comparar. El techo es el
      # número medido; si sube, alguien escribió un check atado a esta máquina.
      #
      # ⚠️ LÍMITE, medido y dicho: `git clone` copia lo COMMITEADO, no el árbol de trabajo. Así
      # que este guardián no ve un check recién escrito hasta que se commitea — atrapa la
      # regresión antes del PR, no antes del commit. Clonar el working tree daría un falso
      # positivo por cada archivo a medio escribir, que sería peor.
      # 📊 11 → 7 (2026-08-07, bloque `separacion-motor-instancia`). El techo baja cuando la
      # causa se corrige, nunca para que quepa un rojo nuevo. Lo que lo bajó: cuatro checks de
      # familia D (casos 5-8) y `WORKSPACE.md`, que ahora se GENERA en vez de heredarse.
      # ⭐ Este número es SIN `bin/init` — el peor caso. Tras el init el clon queda en 1, y ese
      # 1 es `check-clear-ready registered=no`: la respuesta CORRECTA en un árbol recién nacido.
      CLON_CAP=7
      _cf=$(cd "$_tmp/c/Mente" && timeout 900 bin/test-f0-f6 2>&1 \
            | grep -oE 'failed: [0-9]+' | grep -oE '[0-9]+' | head -1)
      if [ -z "$_cf" ]; then
        mal "batería en el clon" "un número" "no se pudo medir"
      elif [ "$_cf" -le "$CLON_CAP" ]; then
        ok "batería en el clon: $_cf fallo(s) — bajo el techo de $CLON_CAP"
      else
        mal "batería en el clon" "≤ $CLON_CAP fallos" "$_cf — empeoró"
      fi
    else
      mal "clon" "validadores ejecutables" "no lo son"
    fi
  else
    omit "clon limpio" "git clone falló"
  fi
  rm -rf "$_tmp" 2>/dev/null
fi

# ══════════════════════════════════════════════════════════════ RESULTADO
printf '\n\033[1m════ RESULTADO ════\033[0m\n'
printf '  verde:   %d\n  fallos:  %d\n  omitido: %d\n' "$PASS" "$FAIL" "$OMIT"
if [ "$FAIL" -gt 0 ]; then
  printf '\n  \033[31m🔴 %d FALLO(S):\033[0m\n' "$FAIL"
  for f in "${FALLOS[@]}"; do printf '     · %s\n' "$f"; done
  exit 1
fi
printf '\n  ✅ TODO verificado end to end\n'
exit 0