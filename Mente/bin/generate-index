#!/usr/bin/env python3
# Implements ADR-019 — validators COMPLETE what is derivable (index, graph)
"""generate-index — produce docs/INDEX.md and docs/STATES.md from what is ON DISK.

⭐ Why this exists, measured right now: `Maestro/registro.md` claims **173 docs** when there are
**255**. Foresito reads that file LIVE over MCP, so it is serving false numbers today.

> **Brian's own criterion, already applied in `Maestro/punteros.tsv`:**
> *"aquí NO se duplica la tabla: la sincronía a mano murió."*
> This extends that criterion to the rest of the system.

A hand-maintained index does not go stale loudly — it goes stale silently, and it is read as truth.
Regenerating is cheap; trusting a stale index is not.

⛔ NEVER hand-edit the output. Both files carry a GENERATED header and `bin/check-blocks` exempts
them from the document contract precisely because a human is not supposed to touch them.

Usage:
  bin/generate-index            write both files
  bin/generate-index --check    exit 1 if regenerating would change them (for CI / pre-commit)
  bin/generate-index --quiet
"""
import os
import re
import sys
import glob
import subprocess
from datetime import date, datetime

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(MENTE)
TODAY = date.today()

SKIP = ("secrets/", ".git/", "Maestro/.git/", "Maestro/.staging/")


def field(text, name):
    m = re.search(rf"\*\*{name}:\*\*\s*([^·\n]+)", text)
    return m.group(1).strip() if m else ""


def bfield(text, name):
    m = re.search(rf"^{name}:\s*(.+)$", text, re.M)
    return m.group(1).strip() if m else ""


def days_since(iso):
    try:
        return (TODAY - date.fromisoformat(iso[:10])).days
    except Exception:                                          # noqa: BLE001
        return None


def block_health(text, path):
    """Health is MEASURED, never declared. A block calling itself healthy proves nothing."""
    problems = []
    upd = bfield(text, "updated") or field(text, "Updated")
    d = days_since(upd)
    status = bfield(text, "status").split("·")[0].strip()
    if d is None:
        problems.append("no readable date")
    elif status == "active" and d > 7:
        problems.append(f"stale {d}d")
    elif status == "blocked" and d > 14:
        problems.append(f"abandoned {d}d")
    if "⬜" in text.split("## Sub-blocks")[0]:
        problems.append("Tier 1 has placeholders")
    if status == "blocked" and "→" not in bfield(text, "blockers"):
        problems.append("blocker names no owner")
    if not problems:
        return "🟢", ""
    return ("🔴" if any("abandoned" in p or "no readable" in p for p in problems) else "🟡",
            " · ".join(problems))


def sub_blocks(text):
    """The §F rows — and ONLY the §F rows.

    ⚠️ Measured 2026-08-07 on blk-separacion-motor-instancia: the old regex scanned the WHOLE
    file for any 5-column row starting with a digit, so a numbered table in §K counted as a
    sub-block and a 5/5 block published 5/6. The §F is the propagation graph; nothing else is.

    ⚠️ Column count is NOT fixed either: the real §F tables run 4 columns (expertise-programacion,
    plan-tests-demo) or 5 (demo, separacion-motor-instancia). Hard-coding five made two fully
    closed blocks publish 0/3 and 0/1. The status is the LAST cell of the row, whatever the width.
    """
    m = re.search(r"══\s*F\s*·\s*SUB-BLOCKS.*?-->\n(.*?)(?=\n<!--\s*══|\Z)", text, re.S)
    if not m:
        return []
    out = []
    for line in m.group(1).split("\n"):
        line = line.strip()
        if not re.match(r"^\|\s*\d+\w*\s*\|", line) or line.count("|") < 3:
            continue
        out.append(line.strip("|").split("|")[-1])
    return out


def is_closed(cell):
    """A sub-block is closed whatever notation the §F used to say so.

    ⚠️ The old check was `cell == "closed"`, so a `✅` — the majority convention across the
    real blocks — was invisible: blk-demo had 11/12 closed and the index published 6/7.
    ⛔ An index that under-reports makes finished work get reopened, so the fix is to read the
    notation in use, not to rewrite every §F to one word.
    """
    c = cell.strip().lower()
    return "✅" in c or c in ("closed", "done", "cerrado")


def collect_blocks():
    rows = []
    for f in sorted(glob.glob("blocks/**/BLOCK.md", recursive=True)):
        t = open(f, encoding="utf-8", errors="replace").read()
        state = f.split("/")[1]
        icon, why = block_health(t, f)
        subs = sub_blocks(t)
        closed = sum(1 for s in subs if is_closed(s))
        rows.append({
            "name": os.path.basename(os.path.dirname(f)),
            "id": bfield(t, "id"), "type": bfield(t, "type"),
            "status": bfield(t, "status").split("·")[0].strip() or state,
            "lane": (re.search(r"lane:\s*([\w-]+)", t) or [None, "?"])[1],
            "owner": bfield(t, "owner"), "phase": bfield(t, "phase")[:52],
            "updated": bfield(t, "updated"), "path": f,
            "health": icon, "why": why,
            "progress": f"{closed}/{len(subs)}" if subs else "—",
        })
    return rows


def collect_docs():
    docs = []
    for f in sorted(glob.glob("**/*.md", recursive=True)):
        if any(f.startswith(s) for s in SKIP) or "/.git/" in f:
            continue
        t = open(f, encoding="utf-8", errors="replace").read(2500)
        docs.append({"path": f, "type": field(t, "Type") or "—",
                     "status": field(t, "Status") or "—",
                     "updated": field(t, "Updated") or "",
                     "lines": sum(1 for _ in open(f, encoding="utf-8", errors="replace"))})
    return docs


HEADER = ("<!-- 🤖 GENERATED by bin/generate-index — DO NOT EDIT BY HAND.\n"
          "     Hand edits are lost on the next run, and a hand-maintained index goes stale\n"
          "     silently while still being read as truth (Maestro/registro.md claimed 173 docs\n"
          "     when there were 255). Regenerate instead: bin/generate-index -->\n")


def render_states(blocks):
    o = [HEADER, "# STATES — every block and its measured health\n",
         f"**Generated:** {TODAY.isoformat()} · **Source:** `blocks/**/BLOCK.md` · "
         "**Type:** generated\n"]
    if not blocks:
        o.append("\n_No blocks yet._\n")
    else:
        o.append("\n| | Block | Type | Status | Lane | Progress | Owner | Updated | Path |")
        o.append("|---|---|---|---|---|---|---|---|---|")
        for b in blocks:
            o.append(f"| {b['health']} | **{b['name']}** | {b['type']} | {b['status']} | "
                     f"{b['lane']} | {b['progress']} | {b['owner']} | {b['updated']} | "
                     f"`{b['path']}` |")
        sick = [b for b in blocks if b["why"]]
        if sick:
            o.append("\n## Health findings\n")
            for b in sick:
                o.append(f"- {b['health']} **{b['name']}** — {b['why']}")
        o.append("\n## Phase\n")
        for b in blocks:
            o.append(f"- **{b['name']}**: {b['phase'] or '—'}")
    o.append("\n---\n\nRegenerate: `bin/generate-index` · Verify: `bin/check-structure`\n")
    return "\n".join(o)


def render_index(docs, blocks):
    by_dir = {}
    for d in docs:
        by_dir.setdefault(os.path.dirname(d["path"]) or ".", []).append(d)
    o = [HEADER, "# INDEX — every document in Mente OS\n",
         f"**Generated:** {TODAY.isoformat()} · **Type:** generated\n",
         f"\n**{len(docs)} documents** · **{len(blocks)} blocks** · "
         f"{len(by_dir)} directories\n"]
    o.append("\n| Directory | Docs |\n|---|---|")
    for d in sorted(by_dir):
        o.append(f"| `{d}/` | {len(by_dir[d])} |")
    o.append("\n---\n")
    for d in sorted(by_dir):
        o.append(f"\n## `{d}/`\n")
        o.append("| Document | Type | Status | Updated | Lines |")
        o.append("|---|---|---|---|---|")
        for x in sorted(by_dir[d], key=lambda y: y["path"]):
            o.append(f"| `{os.path.basename(x['path'])}` | {x['type']} | {x['status']} | "
                     f"{x['updated']} | {x['lines']} |")
    o.append("\n---\n\nRegenerate: `bin/generate-index`\n")
    return "\n".join(o)


def main():
    check = "--check" in sys.argv
    quiet = "--quiet" in sys.argv
    blocks, docs = collect_blocks(), collect_docs()
    out = {"docs/STATES.md": render_states(blocks), "docs/INDEX.md": render_index(docs, blocks)}

    changed = []
    for path, content in out.items():
        old = open(path, encoding="utf-8").read() if os.path.exists(path) else None
        # Ignore the generation date when comparing: it changes every day by design.
        norm = lambda s: re.sub(r"\*\*Generated:\*\* \d{4}-\d{2}-\d{2}", "", s or "")
        if norm(old) != norm(content):
            changed.append(path)
        if not check:
            open(path, "w", encoding="utf-8").write(content)

    if quiet:
        return 1 if (check and changed) else 0
    if check:
        if changed:
            print(f"🔴 out of date: {', '.join(changed)}\n   run: bin/generate-index")
            return 1
        print("✅ generated indexes are current")
        return 0
    print(f"✅ docs/INDEX.md   — {len(docs)} documents")
    print(f"✅ docs/STATES.md  — {len(blocks)} block(s)")
    for b in blocks:
        print(f"   {b['health']} {b['name']}: {b['status']} · {b['progress']}"
              + (f" · {b['why']}" if b["why"] else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
