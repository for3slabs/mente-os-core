#!/usr/bin/env python3
# Implements ADR-011 — four layers guarantee reading — /clear is the last one
"""check-clear-ready — is it safe to /clear right now?

⭐ This exists because of the single worst failure of the project (2026-07-24/26):

    before /clear:  "todo está perfecto, me encantó"
    after  /clear:  "sí mejoró, pero aún sigue roto"

Same code. Opposite verdicts. Brian: *"¿me mientes o qué está pasando? Ese dolor es el que más me
impide trabajar."*

Nothing lied. `/clear` is a CUT, not a save — it writes nothing to disk. The first verdict lived
only in the conversation, so it died with it, and what came back was a fresh reading of the same
files. **The fix is not a better memory. It is refusing to /clear while the verdict lives only in
context.**

Usage: bin/check-clear-ready [--quiet]
Exit: 0 safe · 1 something would be lost
"""
import os
import re
import sys
import glob
import time
import subprocess
from datetime import date

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(MENTE)
sys.path.insert(0, os.path.join(MENTE, "bin"))
import mente_config as cfg                                            # noqa: E402

LOST, WARN = [], []


def main():
    quiet = "--quiet" in sys.argv

    # ① the session autopsy — the rule that already existed and was never enforced
    #
    # 🔴 This hardcoded `~/.claude/projects/-home-brianweb3-for3s` and did `if js:` — so on any
    # other machine the check simply did not run, and /clear was allowed with no autopsy. The
    # path is now COMPUTED from the working directory (mente_config.session_slug) and a missing
    # transcript directory is REPORTED, not skipped. A guard that goes quiet is a green light.
    _, why = cfg.session_dir()
    if why:
        WARN.append(f"{why}\n"
                    "   → the session autopsy cannot be checked. Register it by hand, or set\n"
                    "     session.project_dir in mente.config.yml.")
    js = cfg.session_files()
    if js:
        sid = os.path.basename(js[0])[:8]
        mb = os.path.getsize(js[0]) / 1e6
        reg = "Cerebro/Registro_Conversaciones.md"
        text = open(reg, encoding="utf-8", errors="replace").read() if os.path.exists(reg) else ""
        # 🔴 This was `sid not in text` — a bare substring match on 8 hex characters. Any commit
        # hash, path or id that happens to CONTAIN them declared the session registered and opened
        # the /clear. Measured 2026-08-02: 'abcdc733bc1def' satisfies a search for 'dc733bc1'.
        # ⭐ Same defect found the same day in check-blocks (it compared "016", matching "2016").
        # The neighbours must not be hex, which accepts both real forms — `2a5131d3` in the table
        # and the id named in prose — while rejecting one embedded inside a longer string.
        if not re.search(rf"(?<![0-9a-f]){re.escape(sid)}(?![0-9a-f])", text):
            LOST.append(f"this session ({sid}, {mb:.0f} MB) has NO entry in {reg}\n"
                        "   → rule-session-close.md: no /clear without registering first.\n"
                        "   The 2026-07-21 incident was recovered from a .jsonl six days later,\n"
                        "   documented nowhere else. Without the entry, the autopsy is unfindable.")

    # ② every active block must restart from disk alone
    for b in glob.glob("blocks/active/*/BLOCK.md"):
        name = os.path.basename(os.path.dirname(b))
        r = subprocess.run([f"{MENTE}/bin/check-sufficiency", name],
                           capture_output=True, text=True)
        if r.returncode != 0:
            LOST.append(f"block `{name}` is NOT sufficient — §A-E do not answer the restart\n"
                        "   questions. After /clear its scope gets rebuilt by inference.")
        text = open(b, encoding="utf-8", errors="replace").read()
        upd = re.search(r"^updated:\s*(\d{4}-\d{2}-\d{2})", text, re.M)
        if upd and upd.group(1) != date.today().isoformat():
            WARN.append(f"block `{name}` §E updated {upd.group(1)}, not today — "
                        "today's progress may live only in the conversation")

    # ③ RETOMAR.md is the cold-start brief: stale, the next session starts blind
    #
    # 🔴 Found 2026-07-31: this pointed at `Doc/RETOMAR.md`, a path the v1→v2 migration
    # deleted. Guarded by `os.path.exists`, it failed SILENTLY — so the one check that
    # protects the cold-start brief had never run. A guard aimed at a path that no longer
    # exists is not a guard; it is a green light. Hence the missing-file branch below.
    for f, label in (("memory/RETOMAR.md", "the cold-start brief"),
                     ("docs/plan-v2-rollout.md", "the v2 plan")):
        if not os.path.exists(f):
            LOST.append(f"{f} ({label}) does not exist — the next session starts blind")
        else:
            m = re.search(r"(\d{4}-\d{2}-\d{2})",
                          open(f, encoding="utf-8", errors="replace").read()[:1500])
            if m and m.group(1) < date.today().isoformat():
                WARN.append(f"{f} ({label}) reads {m.group(1)} — update it before the cut")

    # ④ uncommitted work is not lost by /clear, but the REASON for it is
    # The repo root plus whatever siblings this instance declares (mente.config.yml).
    for repo in [os.path.dirname(MENTE)] + cfg.siblings():
        if not os.path.isdir(f"{repo}/.git"):
            continue
        out = subprocess.run(["git", "-C", repo, "status", "--porcelain"],
                             capture_output=True, text=True).stdout.strip()
        if out:
            WARN.append(f"{os.path.basename(repo)}: {len(out.splitlines())} uncommitted files — "
                        "the files survive, the reason for the change does not")

    # ── P1 · IS THE BATTERY GREEN, AND WAS IT RUN RECENTLY? (2026-08-05) ────────────
    # Measured the same day: NOTHING executed bin/test-f0-f6. The 173 checks ran only when
    # somebody remembered — so this project's own law (code 100%, discipline 40-60%) put its
    # CENTRAL verification on the 40-60% side.
    #
    # ⚠️ It is NOT run from here: the battery takes ~2m31s and this check must stay at ~0.1s
    # (measured). A close gate that costs 2.5 minutes is a gate people skip, and a skipped gate
    # protects nothing (rule-friction.md). Instead we read the result the battery already
    # published in docs/METRICS.md, and check HOW OLD it is — a green from last week says
    # nothing about the code being closed today.
    metrics = f"{MENTE}/docs/METRICS.md"
    if os.path.isfile(metrics):
        try:
            mt = open(metrics, encoding="utf-8", errors="replace").read()
        except OSError:
            mt = ""
        # ⚠️ El número que se lee aquí YA viene descontado del fallo circular por
        # `bin/generate-metrics`. Ver el comentario de `battery_checks()` allí: la batería
        # contiene un check que corre ESTE validador, así que un rojo suyo se autoperpetuaba.
        m = re.search(r"`battery\.failed`\s*\|\s*\*\*(\d+)\*\*", mt)
        if m and int(m.group(1)) > 0:
            LOST.append(f"the battery is RED ({m.group(1)} failed) — closing now freezes a "
                        "broken state as if it were good. Run: bin/test-f0-f6")
        age_days = (time.time() - os.path.getmtime(metrics)) / 86400
        if age_days > 1:
            WARN.append(f"the battery result is {age_days:.0f} day(s) old — a green from before "
                        "today's work is not evidence about today's work "
                        "(val-functional.md §2.2). Run: bin/generate-metrics")
    else:
        WARN.append("docs/METRICS.md is missing — no battery result to read at all")

    if quiet:
        return 1 if LOST else 0
    if LOST:
        print(f"\n🔴 DO NOT /clear YET — {len(LOST)} thing(s) would be lost\n")
        for m in LOST:
            print(f"   {m}\n")
    if WARN:
        print(f"🟡 {len(WARN)}")
        for m in WARN:
            print(f"   {m}")
    if not LOST:
        print("\n✅ SAFE TO /clear — everything that matters is on disk."
              if not WARN else "\n🟡 /clear is allowed, but read the warnings above first.")
    return 1 if LOST else 0


if __name__ == "__main__":
    sys.exit(main())
