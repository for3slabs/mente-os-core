#!/usr/bin/env python3
# Implements ADR-019 — validators COMPLETE what is derivable; they never complete criterion
"""init — turn a fresh clone of the engine into THIS user's instance.

⭐ Brian, 2026-08-02: *"esto está local para mí y aun así tenemos errores. AÚN NO VEO QUE SEA ALGO
QUE PODAMOS CONFIAR A QUE LA GENTE PUEDA OCUPAR."* — and the installer is an AGENT, not a person.

WHAT IT DOES
    Reads mente.config.yml, then GENERATES the three startup files from templates:
    CLAUDE.md · PROJECT-RULES.md · .claude/settings.json (hooks block only).

WHY GENERATED AND NOT HAND-EDITED
    Measured 2026-08-02: those three carried 43 occurrences of one user's name and 34 absolute
    paths, while mente.config.yml existed precisely so a new user edits ONE file. The validators
    honoured that separation; the startup files did not. A value copied by hand is correct
    exactly once — the same reason docs/METRICS.md exists.

WHAT IT REFUSES TO DO
    🔴 It never invents criterion (ADR-003). `owner.name` and the gates are ASKED, never guessed:
    a gate the installer made up would be a boundary nobody decided.
    🔴 It never overwrites a file that already differs from what it would generate, unless --force.
    An instance that has been worked on is not a scaffold.

Usage:
  bin/init                 interactive — asks only what cannot be derived
  bin/init --check         report what WOULD change, touch nothing
  bin/init --force         regenerate even if the target was edited by hand
Exit: 0 done / nothing to do · 1 refused (would overwrite) · 2 could not read the config
"""
import os
import re
import sys
import json
import shutil
import datetime

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(MENTE, "bin"))
import mente_config as cfg                                            # noqa: E402
os.chdir(MENTE)
REPO = os.path.dirname(MENTE)
TPL = "templates"

check_only = "--check" in sys.argv
force = "--force" in sys.argv

# The hook wiring is the one thing that MUST be portable: measured 2026-08-03, a clone whose
# hooks carried an absolute path started with no gate running — and it failed silently.
# 🔴 CADA GRUPO LLEVA SU `matcher`, y no es cosmético (2026-08-07).
# Sin él un hook corre en TODAS las herramientas: el 2026-08-06 `gate-handoff` —que solo debe
# vigilar `Agent|Task`— pasó a bloquear Bash, Read, Grep y hasta Edit, y **el sistema se cerró
# sobre sí mismo**: no se podía editar la configuración para arreglarlo. Brian lo desbloqueó a
# mano. El JSON seguía siendo válido, así que nada lo detectó.
#
# ⚠️ Y estaban los 3 de secrets sin cablear: `bin/init` dejaba una instancia con 4 hooks donde
# el sistema declara 7, así que un clon recién instalado fallaba su propio check de cableado.
# Medido: `init --force` subía los fallos de un clon de 10 a 14.
#
# Formato: evento → lista de (matcher | None, [(intérprete, archivo|comando)]).
HOOKS = {
    "SessionStart": [
        (None, [("bash", "hooks/session-start.sh"),
                ("python3", "bin/secrets-lease|open --source startup")]),
    ],
    "PreToolUse": [
        ("Write|Edit", [("python3", "hooks/pre-edit-standards.py"),
                        ("python3", "hooks/gate-critical.py")]),
        ("Agent|Task", [("python3", "hooks/gate-handoff.py")]),
        ("Read|Write|Edit|Bash", [("python3", "hooks/gate-secrets.py")]),
        # ⭐ Detecta un merge de Brian ANTES de tocar git (2026-08-08). `bin/check-prs` ya corre
        # en el SessionStart, pero su caso real es otro: mergea A MITAD DE SESIÓN, cuando el
        # arranque ya pasó — y entonces yo sigo empujando sobre una rama ya mergeada.
        # Este hook mira justo cuando voy a hacer algo que ese merge invalida. Nunca bloquea.
        ("Read|Write|Edit|Bash|Grep|Glob", [("python3", "hooks/watch-prs.py")]),
    ],
    "PostCompact": [
        (None, [("python3", "bin/secrets-lease|open --source compact")]),
    ],
}


def ask(prompt, default=None):
    """Ask, or take the default. Never guess a value that is criterion."""
    if not sys.stdin.isatty():
        if default is None:
            print(f"🔴 `{prompt}` has no default and there is no terminal to ask on.\n"
                  "   Fill it in mente.config.yml, or run bin/init interactively.", file=sys.stderr)
            sys.exit(2)
        return default
    d = f" [{default}]" if default else ""
    return input(f"   {prompt}{d}: ").strip() or (default or "")


def render(name, values):
    """Fill a template. A placeholder left unresolved is a bug, not a blank."""
    src = os.path.join(TPL, name + ".template")
    if not os.path.exists(src):
        return None, f"template missing: {src}"
    text = open(src, encoding="utf-8").read()
    # ⭐ The template's own banner is scaffolding, not content: it addresses whoever EDITS the
    # template, and copying it into the generated file makes an instance document open with a
    # warning aimed at somebody else. Measured 2026-08-08: `init --force` prepended 6 lines of
    # "⚠️ PLANTILLA — la genera bin/init" to CLAUDE.md, so the file that Claude Code reads first
    # started by telling the reader not to edit it by hand.
    text = re.sub(r"\A<!--.*?-->\n", "", text, count=1, flags=re.S)
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", str(v))
    left = re.findall(r"\{\{(\w+)\}\}", text)
    if left:
        return None, f"{name}: unresolved placeholders {sorted(set(left))}"
    return text, None


def foreign_owner(path, owner, rendered):
    """Does the file on disk still carry ANOTHER owner's name where this one should be?

    ⭐ It measures, it does not guess (ADR-003). The template marks every spot the owner's name
    belongs in, so the rendered text says exactly where `owner` must appear. If the file on disk
    has the declared owner in FEWER of those spots than the template asks for, it is carrying
    somebody else's identity — no name-guessing heuristic involved.

    A file that merely differs is an edit; a file missing its owner is INHERITED, and only the
    second is dangerous: it ships a stranger's identity to a new owner.

    Returns (present, expected) when it is foreign, else None. Never raises — a detector that
    breaks `init` would be worse than the defect it reports.
    """
    if not owner:
        return None
    try:
        disk = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    expected = rendered.count(owner)
    if expected == 0:                      # this file never names the owner: nothing to inherit
        return None
    present = disk.count(owner)
    return None if present >= expected else (present, expected)


def write(path, text):
    """Refuse to clobber work. A file that already differs is an instance, not a scaffold."""
    if os.path.exists(path):
        current = open(path, encoding="utf-8").read()
        if current == text:
            return "unchanged"
        if not force:
            return "DIFFERS"
        shutil.copy(path, path + ".bak")
    if check_only:
        return "would write"
    open(path, "w", encoding="utf-8").write(text)
    return "written"


def wire_hooks():
    """Register the four hooks with a PORTABLE path, preserving every other setting."""
    p = os.path.join(REPO, ".claude", "settings.json")
    try:
        d = json.load(open(p)) if os.path.exists(p) else {}
    except ValueError as e:
        return f"🔴 {p} is not valid JSON ({e}) — fix it by hand, this will not overwrite it"
    var = chr(36) + "{CLAUDE_PROJECT_DIR}"
    blocks = {}
    for event, grupos in HOOKS.items():
        salida = []
        for matcher, entries in grupos:
            hs = []
            for run, f in entries:
                # `archivo|args` permite cablear un binario con argumentos (secrets-lease)
                ruta, _, args = f.partition("|")
                cmd = f'{run} "{var}/Mente/{ruta}"'
                if args:
                    cmd += f" {args} >/dev/null 2>&1 || true"
                hs.append({"type": "command", "command": cmd})
            g = {"hooks": hs}
            if matcher:
                g = {"matcher": matcher, "hooks": hs}
            salida.append(g)
        blocks[event] = salida
    # 🔴 LOS PERMISOS A CARPETAS DE OTRA INSTANCIA NO SE HEREDAN (2026-08-07).
    # `additionalDirectories` viaja dentro de settings.json, y en este repo concedía acceso a
    # `marca-personal/` — una carpeta de la instancia de Brian. En cualquier clon esa ruta no
    # existe: la batería la reportaba como "ruta muerta" y el clon nacía en rojo por un permiso
    # que su dueño nunca pidió.
    # ⭐ Un permiso concedido a algo que no existe no es inofensivo: es una concesión que nadie
    # puede auditar, y el día que ESA ruta aparezca queda otorgada sin que nadie lo decidiera.
    # Se podan las muertas, se conservan las vivas, y se DICE cuántas se quitaron.
    podadas = []
    perms = d.setdefault("permissions", {})
    vivos = []
    for e in perms.get("additionalDirectories", []):
        destino = os.path.expandvars(os.path.expanduser(
            e.replace("${CLAUDE_PROJECT_DIR}", REPO)))
        (vivos if os.path.exists(destino) else podadas).append(e)
    nota = ""
    if podadas:
        nota = f" · {len(podadas)} additionalDirectories muertos podados"

    if d.get("hooks") == blocks and not podadas:
        return "hooks already wired, portably"
    if check_only:
        return f"would rewire 4 hooks with a portable path{nota}"
    if podadas:
        perms["additionalDirectories"] = vivos
    d["hooks"] = blocks
    # 🔴 BACK UP BEFORE OVERWRITING (2026-08-05, imported from graphify's install.py #2167).
    # This file belongs to the USER and they have hand-edited it: permissions, env, statusline.
    # Refusing on unparseable JSON (above) covers the corrupt case; it does NOT cover a correct
    # merge that turns out to be wrong. graphify grew this after a real user lost their whole
    # config. One rolling backup, so a bad rewire is always one `mv` away from undone.
    #
    # ⚠️ This runs on someone ELSE's machine, which is the scenario the field test still owes:
    # the failure would land where nobody can debug it. Cheapest possible insurance.
    if os.path.exists(p):
        try:
            shutil.copy2(p, p + ".mente-bak")
        except OSError as e:
            return f"🔴 could not back up {p} ({e}) — refusing to overwrite it"
    json.dump(d, open(p, "w"), indent=2, ensure_ascii=False)
    return ("4 hooks wired with ${CLAUDE_PROJECT_DIR} "
            f"(previous settings.json → .mente-bak){nota}")


def main():
    print("\n\033[1m── mente init ──\033[0m")

    # ⭐ SIN CONFIG, SE CREA DESDE LA PLANTILLA (2026-08-06).
    # 🔴 Antes `mente.config.yml` VIAJABA en el repo con el nombre de Brian dentro, así que en
    # un clon ajeno `owner_name()` lo encontraba ya escrito y **nunca preguntaba**: el nuevo
    # dueño heredaba la identidad del anterior sin enterarse. Ahora la config viva está en el
    # .gitignore y solo viaja la plantilla, con `{{OWNER}}` sin resolver — que es un valor
    # imposible de confundir con un nombre real, así que el flujo de abajo SÍ pregunta.
    _cfg, _tpl = "mente.config.yml", os.path.join(TPL, "mente.config.yml.template")
    if not os.path.exists(_cfg) and os.path.exists(_tpl):
        shutil.copy2(_tpl, _cfg)
        print(f"\n   📄 {_cfg} creado desde la plantilla — se preguntará lo que falta")

    owner = cfg.owner_name()
    if owner and "{{" in str(owner):
        owner = ""          # un placeholder sin resolver NO es un nombre
    if not owner or owner in ("", "None"):
        print("\n   mente.config.yml has no owner. This is CRITERION — it is asked, never guessed.")
        owner = ask("owner name")
        if not owner:
            print("🔴 an instance with no owner cannot say who decides. Aborted.", file=sys.stderr)
            return 2
    project = os.path.basename(REPO)
    values = {"owner": owner, "project": project,
              "date": datetime.date.today().isoformat()}

    print(f"\n   owner   : {owner}")
    print(f"   project : {project}")
    print(f"   engine  : {MENTE}\n")

    rc = 0

    # ⭐ cuentas.tsv NACE VACÍO en cada instancia (2026-08-20). Su plan lo prometía —"un clon lo
    # recibe VACÍO, nadie hereda cuentas ajenas"— y la promesa NO se cumplía: el archivo viajaba
    # en git y un clon ajeno heredaba las 8 cuentas de su autor. Lo cazó la auditoría "ponte en
    # los zapatos del que clona". ⛔ Sin él la puerta gate-accounts no sabe qué es legítimo, así
    # que el motor lo crea con su cabecera y sin una sola fila.
    # ⭐ La CAPA 2 de la puerta de cuentas: `pre-push` lo ejecuta GIT en el push real, así que
    # un alias, una función, `eval` o `xargs` no lo rodean — medido 2026-08-20, esas 5 formas SÍ
    # rodeaban la capa 1, que lee el texto del comando. Sin enlazarlo, un clon tiene la puerta
    # que se puede evadir y no la que no.
    hookdir = os.path.join(REPO, ".git", "hooks")
    src = os.path.join(MENTE, "hooks", "pre-push.sh")
    dst = os.path.join(hookdir, "pre-push")
    if os.path.isdir(hookdir) and os.path.exists(src):
        try:
            rel = os.path.relpath(src, hookdir)
            if os.path.islink(dst) and os.readlink(dst) == rel:
                print("   ✅ pre-push: ya enlazado (capa 2 de la puerta de cuentas)")
            else:
                if os.path.lexists(dst):
                    os.remove(dst)
                os.symlink(rel, dst)
                print("   🆕 pre-push: enlazado (capa 2 — la que no se rodea)")
        except OSError as e:
            print(f"   🟡 pre-push: no se pudo enlazar ({e}) — queda solo la capa 1")

    reg = os.path.join(MENTE, "cuentas.tsv")
    if os.path.exists(reg):
        print("   ✅ cuentas.tsv: ya existe (no se toca — es tuyo)")
    else:
        header = (
            "# cuentas.tsv — FUENTE ÚNICA de qué cuenta gobierna cada repo\n"
            "# Lo leen: bin/check-accounts · bin/conectar-cuenta · hooks/gate-accounts.py\n"
            "#\n"
            "# 📦 ARCHIVO DE INSTANCIA: describe TUS cuentas. Nace vacío a propósito —\n"
            "#    nadie hereda las cuentas de quien escribió el motor.\n"
            "# ⛔ AQUÍ NUNCA VA UN TOKEN NI UNA CONTRASEÑA. La columna `guia` apunta a\n"
            "#    secrets/, que está fuera de git y en 700.\n"
            "#\n"
            "# rol: taller | backup | motor | control | sitio | publicado | plantilla\n"
            "# por_que_existe: OBLIGATORIO — un repo que no puede justificarse es basura\n"
            "#\n"
            "repo\tcuenta\trol\tremoto\truta_local\tpor_que_existe\tguia\n"
        )
        status = write(reg, header)          # reusa la función que ya respeta --dry-run y --force
        icon = {"DIFFERS": "🔴", "unchanged": "✅", "written": "🆕", "would write": "🔎"}[status]
        print(f"   {icon} cuentas.tsv: {status} (vacío — añade tus repos)")

    # ⚠️ WORKSPACE.md se GENERA, no se hereda (2026-08-07). Describe ESTA máquina —qué repo es
    # cuál, qué está vedado, dónde viven los secretos— y viajaba con el motor, así que cada clon
    # nacía con la descripción de la máquina de otro. El archivo lo declaraba desde el 05-ago
    # ("A clone regenerates it; it is not copied") y nadie lo hacía cumplir: exactamente el
    # 40-60% con que se cumple una regla que solo vive en un documento.
    for name, target in (("CLAUDE.md", os.path.join(REPO, "CLAUDE.md")),
                         ("PROJECT-RULES.md", os.path.join(REPO, "PROJECT-RULES.md")),
                         ("WORKSPACE.md", os.path.join(MENTE, "docs", "WORKSPACE.md"))):
        text, err = render(name, values)
        if err:
            print(f"   🟡 {err}")
            continue
        status = write(target, text)
        icon = {"DIFFERS": "🔴", "unchanged": "✅", "written": "🆕", "would write": "🔎"}[status]
        print(f"   {icon} {name}: {status}")
        if status == "DIFFERS":
            # ⭐ DIFFERS has two very different causes and saying only "it was edited" hides the
            # dangerous one. Measured 2026-08-08 on a clone owned by "Auditor Externo":
            # PROJECT-RULES.md arrived with 11 mentions of "Brian" and 0 of the real owner, and
            # init said nothing but "rerun with --force". A new owner has no way to know the file
            # carries somebody else's identity — so the engine shipped a stranger's name and the
            # only signal was a check failing much later, without naming the cause.
            # ⛔ Refusing to clobber stays: it is the right default. What changes is that the
            # refusal now REPORTS WHAT IT FOUND.
            owner = values.get("OWNER", "")
            foreign = foreign_owner(target, owner, text)
            if foreign:
                present, expected = foreign
                print(f"      ⚠️  INHERITED: names {owner!r} {present}× where this engine writes"
                      f" it {expected}× — the rest still belongs to another owner's tree.")
                print("      Run `bin/init --force` to make it yours (a .bak is kept).")
            else:
                print("      it was edited after generation — rerun with --force to overwrite "
                      "(a .bak is kept)")
            rc = 1

    print(f"   🔌 {wire_hooks()}")
    print("\n   next: bin/check-health · bin/test-f0-f6\n")
    return rc


if __name__ == "__main__":
    sys.exit(main())