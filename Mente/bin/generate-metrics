#!/usr/bin/env python3
# Implements ADR-019 — validators COMPLETE what is derivable (the live numbers)
"""generate-metrics — publish every live number ONCE, so documents can point instead of copy.

⭐ Brian, 2026-07-31:

    "que sea un apuntador... si cambió de tamaño de 118 a 120 no pasa nada con el SKILL.md
     porque manda a apuntar a un número que está en otro lugar y no lo tenemos que estar
     corrigiendo manualmente... no podemos depender de que actualices, porque se te puede ir."

THE FAILURE THIS FIXES, measured the same day it was written:

  · memory/RETOMAR.md claimed the battery was 105/105 — F8-4 found it was 104. The number is
    not even stable across a /clear.
  · .claude/skills/session-wrap/SKILL.md, written HOURS after that fix, froze 105 again.
    It was 118 by then. The same author repeated the same mistake in the same day.

That is the point: a number copied into prose is correct exactly once. The fix is not more
discipline — it is removing the copy.

HOW A DOCUMENT USES THIS
    ⛔  "the battery is 118/118"
    ✅  "the battery is green — the current count is in `docs/METRICS.md` (battery.checks)"

A document names the METRIC. This file holds the VALUE. When the value moves, nothing in prose
goes stale, because no prose carries it.

WHAT DOES NOT BELONG HERE
    Dated historical evidence — "5 of 11 sessions were never registered (2026-07-27)" — is a
    measurement of a moment, not live state. It must NOT change. Freezing it is correct;
    freezing live state is the bug.

Usage: bin/generate-metrics [--check]
Exit:  0 written / up to date · 1 stale (with --check) · 2 could not measure
"""
import os
import re
import sys
import json
import glob
import subprocess
from datetime import date

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(MENTE, "bin"))
import mente_config as cfg                                            # noqa: E402
os.chdir(MENTE)
REPO = os.path.dirname(MENTE)
OUT = "docs/METRICS.md"
check_only = "--check" in sys.argv


def battery_checks():
    """Total checks in test-f0-f6, from a real run.

    🔴 The battery takes a lock and REFUSES a second concurrent run (exit 1). Reading a refused
    run as "0 checks" would publish a lie, so an unreadable count is reported as unknown —
    never as zero. A metric that guesses is worse than a metric that is absent.
    """
    try:
        r = subprocess.run(["./bin/test-f0-f6"], capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.SubprocessError):
        return None, None
    m = re.search(r"passed:\s*(\d+)", r.stdout)
    f = re.search(r"failed:\s*(\d+)", r.stdout)
    if not m:
        return None, None
    passed = int(m.group(1))
    failed = int(f.group(1)) if f else None

    # 🔴 EL CICLO QUE ESTO ROMPE (medido 2026-08-05, sesión S11).
    #
    # La batería contiene el check *check-clear-ready agrees with the registry*, y
    # `bin/check-clear-ready` decide su veredicto LEYENDO el `battery.failed` que este
    # archivo publica. El lazo se cierra sobre sí mismo:
    #
    #   METRICS failed=1 → check-clear-ready sale 🔴 → la batería lo cuenta → aquí se
    #   vuelve a escribir failed=1 → …
    #
    # Medido tres corridas seguidas: `METRICS=2 → exit 1`, inmóvil, con el resto del sistema
    # en verde. **Un fallo transitorio quedaba congelado para siempre** y ningún arreglo del
    # código real lo limpiaba — el peor tipo de métrica, la que se cree a sí misma.
    #
    # ⭐ Se descuenta AQUÍ y no en check-clear-ready porque aquí existe el dato: la salida de
    # la batería trae los NOMBRES de los checks rojos; `docs/METRICS.md` solo trae dos totales.
    # (Se intentó primero allí y no funcionaba: la condición nunca se cumplía. Verificado antes
    # de darlo por bueno — `rule-checks-must-measure.md`.)
    if failed and re.search(r"🔴\s*check-clear-ready agrees with the registry", r.stdout):
        failed -= 1
        passed += 1

    return passed, failed


def criterion_holes():
    """Holes only Brian can fill. Counted where they LIVE, never in the index.

    The first version of this count read PENDING-BRIAN.md — the index — and reported 1 when 34
    existed. Counting them where they are not is a false green.

    ⚠️ A HOLE IS A HOLE, A LABEL IS NOT (fixed 2026-08-05). The glyph is also used as a *template
    label* — `### ⬜ NO HECHO` is a field of the delivery block in owner-0-voice.md §7, not a
    pending criterion. Counting it left the metric stuck at a floor of 1 that could never be
    cleared, and a permanent 🟡 teaches people to ignore 🟡. A real hole is the marked pending
    line; a heading or an illustration is not.
    """
    files = ["rules/qa-dimensions.md", "principles/owner-0-voice.md"] + \
        sorted(glob.glob("principles/expertise/*.md"))
    n = 0
    for f in files:
        try:
            text = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for line in text.split("\n"):
            if "⬜" not in line:
                continue
            s = line.lstrip("> ").strip()
            if s.startswith("#"):          # a heading: template label, not a hole
                continue
            if "PENDING" in s or "pending" in s:
                n += s.count("⬜")
    return n, len(files)


def broken_links():
    """Citations inside Mente that point nowhere, from a real check-links run.

    🔴 Added 2026-08-02. check-links was the only validator the battery never invoked, so the
    count it measures drifted from ~73 to 144 with nothing reporting it. Same contract as
    battery_checks(): an unreadable run is unknown, never zero — a validator that cannot run
    is not a clean bill of health.
    """
    try:
        r = subprocess.run(["./bin/check-links"], capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode == 0:
        return 0
    m = re.search(r"(\d+)\s+citation\(s\) point nowhere", r.stdout)
    return int(m.group(1)) if m else None


def sessions():
    """Registered sessions vs .jsonl files on disk, and how many heavy ones lack an entry."""
    try:
        reg = len(re.findall(r"^\|\s*S\d+\s*\|",
                             open("Cerebro/Registro_Conversaciones.md",
                                  encoding="utf-8", errors="replace").read(), re.M))
    except OSError:
        return None, None, None
    js = cfg.session_files()
    body = ""
    try:
        body = open("Cerebro/Registro_Conversaciones.md", encoding="utf-8",
                    errors="replace").read()
    except OSError:
        pass
    # Threshold declared per instance (mente.config.yml · session.heavy_mb).
    _, _, heavy_mb = cfg.thresholds()
    # 🔴 Family A (2026-08-02): a bare substring match on 8 hex would publish
    # `sessions.heavy_unregistered = 0` while a session sat unregistered, because its id
    # happened to appear inside a commit hash. A metric that guesses is worse than absent.
    def _logged(sid):
        return re.search(rf"(?<![0-9a-f]){re.escape(sid)}(?![0-9a-f])", body)
    heavy_unreg = sum(1 for p in js
                      if os.path.getsize(p) > heavy_mb * 1_000_000
                      and not _logged(os.path.basename(p)[:8]))
    return reg, len(js), heavy_unreg


def permissions():
    out = {}
    for name in ("settings.json", "settings.local.json"):
        try:
            d = json.load(open(f"{REPO}/.claude/{name}"))["permissions"]
            out[name] = (len(d.get("allow", [])), len(d.get("deny", [])))
        except (OSError, ValueError, KeyError):
            out[name] = (None, None)
    return out


def registered_hooks():
    try:
        d = json.load(open(f"{REPO}/.claude/settings.json"))
        return sum(len(e["hooks"]) for a in d.get("hooks", {}).values() for e in a)
    except (OSError, ValueError, KeyError):
        return None


def n(v):
    """A number that could not be measured prints as ?, never as 0."""
    return "?" if v is None else str(v)


passed, failed = battery_checks()
holes, hole_files = criterion_holes()
links_broken = broken_links()
reg, on_disk, heavy_unreg = sessions()
perms = permissions()
hooks_reg = registered_hooks()
validators = len([f for f in os.listdir("bin") if os.path.isfile(f"bin/{f}")])
hook_files = len([f for f in os.listdir("hooks") if os.path.isfile(f"hooks/{f}")])
active = len(glob.glob("blocks/active/*/BLOCK.md"))
archived = len(glob.glob("blocks/archive/*/BLOCK.md"))

body = f"""<!-- 🤖 GENERATED by bin/generate-metrics — DO NOT EDIT BY HAND.
     Hand edits are lost on the next run. This file exists so that no document has to
     carry a live number in its prose: documents name the METRIC, this file holds the
     VALUE. Regenerate: bin/generate-metrics -->

# METRICS — every live number, measured once

**Status:** current · **Type:** generated · **Updated:** {date.today().isoformat()} · **Owner:** brian
**Generated:** {date.today().isoformat()} · **Source:** the tree itself · **Regenerate:** `bin/generate-metrics`

## Purpose

Every live number in Mente OS, measured once, so no document has to copy one into its prose.

> ⭐ **Why this file exists** (Brian, 2026-07-31): *"que sea un apuntador... no podemos depender
> de que actualices, porque se te puede ir."*
>
> A number copied into prose is correct **exactly once**. `RETOMAR.md` claimed the battery was
> 105/105 when it was 104; `SKILL.md`, written hours after that was fixed, froze 105 again — it
> was already 118. **The fix is not more discipline. It is removing the copy.**

## How to cite a metric

```
⛔  "the battery is 118/118"
✅  "the battery is green — count in `docs/METRICS.md` (battery.checks)"
```

⚠️ **Dated historical evidence does NOT belong here.** *"5 of 11 sessions were never registered
(2026-07-27)"* measures a moment and must never change. Freezing that is correct. Freezing live
state is the bug this file removes.

---

## battery

| Metric | Value |
|---|---|
| `battery.checks` | **{n(passed)}** |
| `battery.failed` | **{n(failed)}** |

⚠️ **`battery.checks` is not stable across a `/clear`.** The battery includes
`check-clear-ready`, which measures the **live** session: it reads one short until this session
is registered in `Cerebro/Registro_Conversaciones.md`. A count one under the total right after a
`/clear` is **expected, not a regression**.

## links — citations that resolve

| Metric | Value |
|---|---|
| `links.broken` | **{n(links_broken)}** |

⭐ **This number is a CEILING, not a target.** `bin/test-f0-f6` fails if it goes UP from what is
committed here — the debt is allowed to exist, never to grow unseen. It drifted from ~73 to 144
precisely because nothing measured it. Fix a batch, regenerate, and the ceiling drops with it.

## criterion — what only Brian can write

| Metric | Value |
|---|---|
| `criterion.holes` | **{n(holes)}** |
| `criterion.files` | {n(hole_files)} |

Counted where the holes LIVE (`rules/qa-dimensions.md` · `principles/owner-0-voice.md` ·
`principles/expertise/*`), never in the index — the index is what goes stale.

## sessions

| Metric | Value |
|---|---|
| `sessions.registered` | **{n(reg)}** |
| `sessions.on_disk` | {n(on_disk)} |
| `sessions.heavy_unregistered` | **{n(heavy_unreg)}** |

`heavy_unregistered` counts `.jsonl` files over 2 MB with no autopsy — the ones whose loss
actually costs something. The 21-jul incident came from one of them.

## system

| Metric | Value |
|---|---|
| `system.validators` | {n(validators)} |
| `system.hook_files` | {n(hook_files)} |
| `system.hooks_registered` | **{n(hooks_reg)}** |
| `system.blocks_active` | {n(active)} |
| `system.blocks_archived` | {n(archived)} |

⚠️ `hook_files` and `hooks_registered` differ on purpose: `pre-commit.sh` is invoked by git, not
by the harness, so it is a file without a settings entry.

## permissions

| Metric | allow | deny |
|---|---|---|
| `permissions.shared` (`settings.json`) | {n(perms['settings.json'][0])} | {n(perms['settings.json'][1])} |
| `permissions.local` (`settings.local.json`) | {n(perms['settings.local.json'][0])} | {n(perms['settings.local.json'][1])} |

`deny` must be **identical** in both — one that lives only in the local file protects nobody
else (`rules/rule-config-hygiene.md` §1.6).

---

Related: `docs/INDEX.md` · `docs/STATES.md` (also generated) ·
`rules/rule-config-hygiene.md` · `docs/PENDING-BRIAN.md` (the holes, by owner).
"""

if check_only:
    try:
        current = open(OUT, encoding="utf-8").read()
    except OSError:
        print(f"🔴 {OUT} does not exist — run bin/generate-metrics")
        sys.exit(1)
    # The generation date changes daily and is not a metric; compare everything else.
    strip = lambda s: re.sub(r"\*\*Generated:\*\* \d{4}-\d{2}-\d{2}", "", s)
    if strip(current) != strip(body):
        print(f"🔴 {OUT} is stale — regenerate: bin/generate-metrics")
        sys.exit(1)
    print(f"✅ {OUT} is up to date")
    sys.exit(0)

open(OUT, "w", encoding="utf-8").write(body)

# ── holes-total STOPS BEING A HAND-COPIED NUMBER (graphify #1, 2026-08-05) ────
# 🔴 docs/PENDING-BRIAN.md declares `holes-total: N` by hand, and the battery cross-checks it.
# That catches the drift AFTER it happens — it drifted THREE times in this session alone, once
# per batch of holes filled. graphify's lesson (`tools/skillgen --check`) is that a generated
# value must be RENDERED from its source, not remembered and then verified.
#
# The count is already measured a few lines above. Writing it here removes the copy instead of
# guarding it: `contract-document.md` §0-bis — *the fix is not more discipline, it is removing
# the copy.* The battery keeps its cross-check as the seatbelt, but it should now never fire.
_idx = "docs/PENDING-BRIAN.md"
if os.path.exists(_idx):
    _t = open(_idx, encoding="utf-8").read()
    _new = re.sub(r"^holes-total:\s*\d+.*$",
                  f"holes-total: {holes}   <!-- 🤖 GENERATED by bin/generate-metrics -->",
                  _t, count=1, flags=re.M)
    if _new != _t:
        open(_idx, "w", encoding="utf-8").write(_new)

print(f"✅ {OUT}")
print(f"   battery {n(passed)} passed / {n(failed)} failed · criterion holes {n(holes)}")
print(f"   sessions {n(reg)} registered · {n(heavy_unreg)} heavy unregistered")
print(f"   validators {n(validators)} · hooks {n(hooks_reg)} registered · blocks {n(active)} active")
sys.exit(0)
