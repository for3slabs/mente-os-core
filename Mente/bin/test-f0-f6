# ═══════════════════════════════════════════════════════════════════ ADVERSARIAL
head2 "ADVERSARIAL — what happens when someone attacks it"

# ⭐ 9 bugs were found on 2026-07-30 by attacking this system instead of confirming it. Each check
# below is one of them, kept permanently so it cannot come back.

# A block name is a folder name. A glob silently graded a DIFFERENT block and titled the verdict
# with what you typed. "not found" exiting 0 meant a hook read it as "sufficient".
# 🔴 The 6 `bad` calls below read `$?` a SECOND time, inside the message — where it no longer
# holds the validator's exit but the exit of the `[ ]` that just ran. Measured: a validator
# returning 7 was reported as "expected exit 1, got exit 1". Detection still worked (FAIL rose),
# but the diagnosis was a lie that read as agreement, on the day someone needs it most.
# Capture ONCE into _e; `$?` survives exactly one command. Same shape as the check-clear-ready
# bug fixed the same day — there it clobbered the verdict, here only the report.
for v in grade-block check-sufficiency check-applied; do
  for arg in "../../../etc" "*" ".." "demo;rm -rf /tmp/x" "does-not-exist"; do
    ./bin/$v "$arg" >/dev/null 2>&1
    _e=$?; [ "$_e" -eq 1 ] || bad "$v rejects hostile arg $arg" "exit 1" "exit $_e"
  done
done
ok "the 3 name-taking validators reject globs, paths and missing blocks (15 cases)"

# 🔴 Found 2026-08-02 measuring per-validator coverage: `new-block` and `migrate-doc` were
# invoked ZERO times by this battery, against grade-block's 8. check-health watches that they
# EXIST and are not gutted — nothing watched that they still WORK. Existing and working is a
# seam, and this project's own rule is that the expensive bugs live at the seams.
# Both are WRITERS (one creates a block, the other moves a document), so the coverage asserts
# what must never happen: creating over an existing block, or acting on a source that is absent.
for arg in "../../../etc" "*" ".." "demo;rm -rf /tmp/x"; do
  ./bin/new-block "$arg" >/dev/null 2>&1
  _e=$?; [ "$_e" -eq 1 ] || bad "new-block rejects hostile name $arg" "exit 1" "exit $_e"
done
./bin/new-block demo >/dev/null 2>&1
_e=$?; [ "$_e" -eq 1 ] || bad "new-block refuses to overwrite an existing block" "exit 1" "exit $_e"
ok "new-block rejects hostile names and never overwrites an open block (5 cases)"

# --dry-run is what makes this testable without moving anything in the tree.
./bin/migrate-doc no-such-source.md docs/analysis --dry-run >/dev/null 2>&1
_e=$?; [ "$_e" -eq 1 ] || bad "migrate-doc refuses a source that does not exist" "exit 1" "exit $_e"
./bin/migrate-doc >/dev/null 2>&1
_e=$?; [ "$_e" -eq 1 ] || bad "migrate-doc refuses to run with no arguments" "exit 1" "exit $_e"
ok "migrate-doc refuses a missing source and a bare invocation (2 cases)"

# A hook that only warns must NEVER fail: an unexpected exit code can interfere with the edit.
for h in pre-edit-standards gate-critical gate-handoff; do
  for j in '{}' 'null' '[]' '{"tool_input":null}' '{"tool_input":{"file_path":123}}' '42'; do
    printf '%s' "$j" | ./hooks/$h.py >/dev/null 2>&1
    _e=$?; [ "$_e" -le 2 ] || bad "$h survives $j" "exit<=2" "exit $_e"
  done
done
ok "the 3 PreToolUse hooks survive malformed payloads (18 cases, no crash)"

# ── THE HANDOFF GATE ─────────────────────────────────────────────────────────
# The level was MEASURED (9,786 Bash vs 32 Agent calls, 15 of them read-only): block writers,
# warn read-only. A gate that made cheap delegation expensive would push straight back toward
# the 20-jul saturation it exists to prevent.
printf '{"tool_input":{"subagent_type":"Explore"}}' | ./hooks/gate-handoff.py >/dev/null 2>&1
_e=$?; [ "$_e" -eq 0 ] || bad "read-only specialist is allowed through" "exit 0" "exit $_e"
ok "a read-only specialist (Explore) needs no manifest"

printf '{"tool_input":{"subagent_type":"general-purpose"}}' | ./hooks/gate-handoff.py >/dev/null 2>&1
_e=$?; [ "$_e" -eq 2 ] || bad "a writing specialist with no manifest is BLOCKED" "exit 2" "exit $_e"
ok "a specialist that can WRITE is BLOCKED without a declared scope"

# Fail closed: an unknown agent type could be anything, so it is treated as a writer.
printf '{"tool_input":{"subagent_type":"some-unknown-agent"}}' | ./hooks/gate-handoff.py >/dev/null 2>&1
_e=$?; [ "$_e" -eq 2 ] || bad "unknown agent type fails CLOSED" "exit 2" "exit $_e"
ok "an unknown agent type fails CLOSED (assumed to write)"

# ⭐ Presence is not compliance. A malformed manifest sitting on disk must NOT open the gate —
# that would be the paperwork version of a scope.
_hd="blocks/active/demo/handoffs"; mkdir -p "$_hd"
cp rules/template-handoff.yml "$_hd/zz-probe-unfilled.yml"
printf '{"tool_input":{"subagent_type":"general-purpose"}}' | ./hooks/gate-handoff.py >/dev/null 2>&1
_r=$?; rm -f "$_hd/zz-probe-unfilled.yml"; rmdir "$_hd" 2>/dev/null
[ "$_r" -eq 2 ] || bad "an unfilled manifest on disk does not open the gate" "exit 2" "exit $_r"
ok "a manifest that fails verify-handoff does NOT open the gate"

# The escape hatch must work AND announce itself (rules/rule-friction.md).
_out=$(printf '{"tool_input":{"subagent_type":"general-purpose"}}' \
       | MENTE_HANDOFF_BYPASS=1 ./hooks/gate-handoff.py 2>&1 >/dev/null); _r=$?
[ "$_r" -eq 0 ] || bad "the documented escape hatch works" "exit 0" "exit $_r"
case "$_out" in *BYPASS*) : ;; *) bad "the bypass announces itself" "a visible warning" "silence" ;; esac
ok "the escape hatch works and says so out loud"

# The write scope is the point: verify-handoff must refuse a return artifact written outside
# handoffs/, and any append target that is not BLOCK.md.
_m=$(mktemp /tmp/handoff-probe-XXXX.yml)
sed -e 's|^block: .*|block: blk-demo-2026-07|' \
    -e 's|^block_path: .*|block_path: blocks/active/demo|' \
    -e 's|^handoff_id: .*|handoff_id: 2026-07-31-0000-probe|' \
    -e 's|  artifact_path: .*|  artifact_path: ../../escape.md|' rules/template-handoff.yml > "$_m"
./bin/verify-handoff "$_m" >/dev/null 2>&1
_e=$?; [ "$_e" -eq 2 ] || bad "a write path escaping handoffs/ is refused" "exit 2" "exit $_e"
rm -f "$_m"
ok "a return artifact written outside handoffs/ is REFUSED"

# The word "rollback" anywhere used to satisfy the DB gate — so `-- no rollback needed` DISABLED it.
printf '{"tool_input":{"file_path":"db/1_migration.sql","content":"DROP TABLE x; -- no rollback needed"}}' \
  > /tmp/adv.json && ./hooks/gate-critical.py < /tmp/adv.json >/dev/null 2>&1
eq "the word 'rollback' in prose does NOT satisfy the DB gate" "2" "$?"

# Destructive SQL from application code: same damage, no migration filename to flag it.
printf '{"tool_input":{"file_path":"lib/demo/x.ts","content":"await sql`DROP TABLE users`"}}' \
  > /tmp/adv.json && ./hooks/gate-critical.py < /tmp/adv.json >/dev/null 2>&1
eq "destructive SQL embedded in .ts is BLOCKED" "2" "$?"

# `status: CLOSED` in caps evaded the close gate entirely.
printf '{"tool_input":{"file_path":"%s/blocks/active/demo/BLOCK.md","content":"status: CLOSED"}}' "$M" \
  > /tmp/adv.json && ./hooks/gate-critical.py < /tmp/adv.json >/dev/null 2>&1
eq "close gate is case-insensitive (status: CLOSED)" "2" "$?"

# ⭐ Nothing protected the guards: a hook could be deleted or stripped of +x and the startup path
# stayed silent. A disarmed guard is worse than no guard — the system reports healthy while open.
# `cmd | grep -q` under `set -o pipefail` takes the exit of the FIRST failing stage, and
# check-health legitimately exits 2 when it finds something. Capture first, then evaluate —
# never mix running with judging. (Cost 3 false failures on 2026-07-30.)
chmod -x bin/check-blocks
hout="$("$M/bin/check-health" 2>/dev/null || true)"
case "$hout" in
  *"GUARD DISARMED"*) ok "check-health detects a DISARMED guard (no execute bit)" ;;
  *) bad "disarmed guard detection" "GUARD DISARMED" "silent" ;;
esac
./hooks/pre-commit.sh >/dev/null 2>&1
eq "pre-commit fails CLOSED when the validator cannot run" "1" "$?"
chmod +x bin/check-blocks

# ⭐ THE GUARD LIST IS DISCOVERED, NOT WRITTEN (audit of 2026-07-31).
# It used to be a handwritten dict of 9 while bin/ and hooks/ held 21 executables. The 12
# unwatched ones included check-clear-ready (the /clear lock) and test-f0-f6 itself — deleting
# the battery would have been silent.
#
# The audit's rule: a list enumerating what is PROTECTED must be measured; one enumerating what
# is PERMITTED may be written, if the unknown fails closed. This enumerates the protected.
_watched=$(python3 -c "
import glob, os
print(len([f for d in ('bin','hooks') for f in glob.glob(d+'/*')
           if os.path.isfile(f) and not f.endswith(('.md','.yml','.json'))]))")
_greps=$(grep -c "GUARD_DIRS\|def _guards" bin/check-health)
[ "$_greps" -ge 2 ] && ok "the guard list is discovered from disk, not hardcoded" \
  || bad "guards discovered" "GUARD_DIRS scan" "a handwritten dict"

# Deleting a guard git knows about must be LOUD. Tested on a validator the old list ignored.
mv bin/generate-metrics /tmp/gm-probe.bak 2>/dev/null
case "$("$M/bin/check-health" 2>/dev/null || true)" in
  *"GUARD MISSING"*"generate-metrics"*) ok "a deleted guard is detected even if it was never listed" ;;
  *) bad "missing guard detection" "GUARD MISSING generate-metrics" "silent" ;;
esac
mv /tmp/gm-probe.bak bin/generate-metrics 2>/dev/null; chmod +x bin/generate-metrics

# ⭐ THE LOCK GUARDS ITSELF. Diagnosed 2026-07-31 by reproducing the flake: two concurrent runs
# both failed on "the generated indexes are up to date", because this battery creates probe
# blocks in the real tree and generate-index globs blocks/**.
# Without this check, removing the lock would silently bring the flake back — and a battery that
# fails at random is a battery people learn to re-run until it is green, which is worse than
# no battery.
#
# The lock is held by THIS run, so a nested invocation must be refused. Testing it from inside
# is the only place where the contended path is guaranteed to exist.
"$M/bin/test-f0-f6" >/dev/null 2>&1
eq "a second concurrent run is REFUSED (exit 1), not run alongside" "1" "$?"
[ -d "$_LOCK" ] && ok "the refused run did not steal or delete the live lock" \
  || bad "lock survives a refused run" "still held" "gone"

mv hooks/gate-critical.py /tmp/adv-guard.bak
hout="$("$M/bin/check-health" 2>/dev/null || true)"
case "$hout" in
  *"GUARD MISSING"*) ok "check-health detects a MISSING guard" ;;
  *) bad "missing guard" "GUARD MISSING" "silent" ;;
esac
mv /tmp/adv-guard.bak hooks/gate-critical.py

# The id shape is load-bearing: §C connections resolve with `blk-[\w-]+`.
tmp="blocks/active/zz-adv"; mkdir -p "$tmp"
printf '# BLOCK · zz-adv\nid: NOT-AN-ID\ntype: code\nintent: probe\nstatus: active · lane: direct\nowner: brian\ncreated: 2026-07-30 · updated: 2026-07-30\n## ✅ IN\n- Mente/docs/zz\n## ⛔ OUT\n- nothing\n## Connections\n- ISOLATED FROM: everything\n## Required standards\n- rules/contract-document.md\n## State\nphase: probe\n' > "$tmp/BLOCK.md"
./bin/check-blocks --blocks >/dev/null 2>&1
eq "a malformed id is REFUSED (the graph resolves by its shape)" "2" "$?"
rm -rf "$tmp"

# ⭐ The verdict cannot be forged: it is measured, never read from the file.
#
# 🔴 SE ESCRIBE EL VEREDICTO CONTRARIO AL MEDIDO, SEA CUAL SEA (2026-08-05, sesión S11).
#
# Antes se escribía un 🟢 PRODUCT falso en `demo` y se exigía que la medición contestara 🔴 MVP.
# Eso ataba el check a que un bloque REAL estuviera rojo — y el día que `demo` dejó de estarlo
# (dead code 1→0, tests 0→4) el check se cayó **sin que nada estuviera mal**.
# ⚠️ **Un check cuyo sujeto es trabajo en curso caduca solo.**
#
# Se intentó primero con un bloque sonda y un archivo huérfano fabricado: NO funcionaba
# (`⬜ NOTHING MEASURED` — el escáner no cuenta un `.ts` suelto fuera del árbol que conoce).
# Comprobado antes de darlo por bueno. Lo invariante, y lo único que hay que sujetar, es que
# **la medición NO se cree lo escrito** — da igual cuál sea el veredicto real.
real="$(./bin/grade-block demo --root "$REPO/marca-personal" 2>/dev/null | grep -o '🟢 PRODUCT\|🟡 CLOSE\|🔴 MVP' | head -1)"
case "$real" in
  "🔴 MVP") falso="🟢 PRODUCT" ;;
  *)        falso="🔴 MVP" ;;
esac
# ⚠️ Se AÑADE la línea falsa: `demo/BLOCK.md` no la lleva, así que un `sed` de sustitución no
# habría escrito nada y el check habría pasado sin probar nada — un verde falso. Comprobado
# (`grep -c` = 0) antes de confiar en él.
printf '\nLAYER 1 VERDICT: %s\n' "$falso" >> blocks/active/demo/BLOCK.md
gout="$("$M/bin/grade-block" demo --root "$REPO/marca-personal" 2>/dev/null || true)"
case "$gout" in
  *"$real"*) ok "a hand-written verdict is contradicted by measurement" ;;
  *) bad "verdict forgery" "measured $real" "believed the file ($falso)" ;;
esac
# La línea inyectada se retira SIEMPRE, incluso si el case de arriba falló.
python3 - "$falso" <<'EOF'
import sys
p = "blocks/active/demo/BLOCK.md"
t = open(p, encoding="utf-8").read()
open(p, "w", encoding="utf-8").write(t.replace(f"\nLAYER 1 VERDICT: {sys.argv[1]}\n", "", 1))
EOF

# ═══════════════════════════════════════════════════════════════════ CROSS-PHASE
head2 "CROSS-PHASE — the bugs live BETWEEN the pieces"

# Every standard a block declares in §D must EXIST. A pointer to nothing is worse than none.
miss=0
while read -r s; do
  [ -n "$s" ] && [ ! -f "$s" ] && { printf '     missing: %s\n' "$s"; miss=$((miss+1)); }
          # An HTML comment documents a REMOVAL — it is not a declaration.
          # (Same fix as bin/check-applied: the comment naming the removed frontend.md was being
          # read as a standard still in force.)
done < <(sed -n '/## Required standards/,/^$/p' blocks/active/demo/BLOCK.md \
         | sed '/<!--/,/-->/d' | grep -oE '^- [a-z0-9/_.-]+\.md' | sed 's/^- //')
eq "every §D standard the block declares exists on disk" "0" "$miss"

# Every ADR cited anywhere must exist — a pointer to nothing is worse than no pointer.
#
# Excluded: the audit log, which NAMES a deliberately fake ADR (ADR-099) as the mutation it used
# to prove this very check works. Found 2026-07-30: the check flagged its own test fixture.
# A validator must know the difference between a citation and a description of a citation.
miss=0
for a in $(grep -rhoE "ADR-[0-9]{3}" rules/ principles/ blocks/ docs/ 2>/dev/null \
           --exclude=audit-f0-f5.md | sort -u); do
  ls rules/decisions/${a}-*.md >/dev/null 2>&1 || { printf '     cited but missing: %s\n' "$a"; miss=$((miss+1)); }
done
eq "every cited ADR exists" "0" "$miss"

# The declared import graph must still match reality — it is measured, never remembered.
d=$(./bin/grade-block demo --root "$REPO/marca-personal" --json 2>/dev/null | python3 -c "
import json,sys;print(json.load(sys.stdin)['metrics'].get('dependent counts gone stale',0))" 2>/dev/null)
eq "block §F import counts still match the real graph" "0" "${d:-ERR}"

# ⭐ TWICE in one day (2026-07-30) a bulk path-completion pass broke real citations: first it
# corrupted 4 filenames inside Maestro/ (own root), then it "completed" 28 valid RELATIVE paths
# (`decisions/ADR-028` from rules/, `expertise/*.md` from principles/) into absolutes that do not
# exist. There will not be a third time: this check runs after every such pass, and a relative
# path that resolves from its OWN directory is correct — completing it is the bug.
#
# ⭐ Every cited path INSIDE Mente must resolve. This check exists because of a real self-inflicted
# bug (2026-07-30): a bulk path-completion script replaced a filename as a SUBSTRING, turning
# `Plan_Maestro_Entrenamiento.md` into `docs/plan-v2-rollout_Entrenamiento.md` in 4 historical
# documents — pointers to files that never existed. Paths outside Mente are not checked here: many
# historical docs reference the agent repo and for3s-inter on purpose.
broken=$(python3 - <<'PY'
import glob, os, re
bad = 0
# ⚠️ Maestro/ is EXCLUDED: it is a separate git repo whose root is Maestro/ itself, so a path
# written from the Mente root is wrong INSIDE it. A bulk path-completion pass broke 8 links there
# on 2026-07-30 by treating it as a plain folder. A nested repo has its own root — always.
INSIDE = ("rules/", "principles/", "blocks/", "docs/", "bin/", "hooks/",
          "Cerebro/",
          # v2 destinations created in M1 — a broken citation INSIDE them went undetected
          # until 2026-07-30, which is exactly where the migration puts every file.
          "vision/", "work/", "memory/", "bridges/")
# The audit log DESCRIBES the broken paths it found, quoting them verbatim. Same class as the
# ADR-099 fixture: a validator must tell a CITATION from a DESCRIPTION of a citation.
# (Caught 2026-07-30 by this very check flagging the document that reports it.)
DESCRIBES = ("docs/audit-f0-f5.md", "docs/f4-execution-log.md", "docs/f5-execution-log.md")
for f in glob.glob("**/*.md", recursive=True):
    if ".git/" in f or f.startswith("secrets/") or f in DESCRIBES:
        continue
    for m in re.findall(r"`([A-Za-z0-9_./-]+\.(?:md|tsv|sh|py))`",
                        open(f, encoding="utf-8", errors="replace").read()):
        # Three classes are NOT broken pointers and must not be flagged:
        #   1. F7 TARGETS  — docs/INDEX.md and docs/STATES.md are GENERATED by phase F7. Citing
        #      them before F7 runs is the plan describing its own output, not a dangling link.
        #   2. PLACEHOLDERS — `Doc/X.md`, `Cuerpo/Y.md` are illustrative examples in prose.
        #   3. PLANNED FILES — memory/PENDIENTES.md names files the pending work will CREATE
        #      (rules/learning-system.md, blocks/architecture-v2.md...). A pending that could not
        #      name its own output would be useless.
        # Learned 2026-07-30: a check that cannot tell "does not exist yet" from "points nowhere"
        # produces noise, and noise is how a validator gets ignored.
        FUTURE = ("docs/INDEX.md", "docs/STATES.md", "docs/DECISIONS.md")
        EXAMPLE = ("Doc/X.md", "Cuerpo/Y.md")
        planned = f in ("memory/PENDIENTES.md", "docs/plan-v2-rollout.md",
                        "docs/plan-v1-to-v2-migration.md")
        # 4. HONESTLY MARKED — a citation the document itself labels as never produced. Rewriting
        #    it to point somewhere else would be a lie; saying so is the correct fix
        #    (owner-0-voice.md: report what was measured). Recognised by the marker.
        raw = open(f, encoding="utf-8", errors="replace").read()
        i = raw.find(m)
        if i > 0 and "never produced" in raw[i:i + 220]:
            continue
        if re.match(r"^memory/(\d{4}-\d{2}-\d{2}|AAAA-MM-DD)\.md$", m):
            continue          # OpenClaw's diaries, not our memory/ — name collision from M1
        if (m in FUTURE or m in EXAMPLE or planned):
            continue
        if m.startswith(INSIDE) and "..." not in m and "NNN" not in m and not os.path.exists(m):
            print(f"     {f} -> {m}")
            bad += 1
print(f"COUNT={bad}")
PY
)
printf '%s\n' "$broken" | grep -v COUNT | head -8
eq "every Mente-internal cited path resolves" "0" "$(printf '%s' "$broken" | grep -oE 'COUNT=[0-9]+' | cut -d= -f2)"

# 🔴 Found 2026-08-02 auditing which checks fail OPEN: `check-links` was the ONLY validator the
# battery never invoked — 0 calls against grade-block's 8. Nothing ran it, so the count it
# measures drifted from ~73 to 144 with the battery reporting 138/0 the whole way.
# ⭐ The hole was never a badly written check. It was a check nobody executed.
# The ceiling lives in docs/METRICS.md (links.broken), generated — never a number typed here,
# which is the rule that file exists for. Debt may stay; it may not GROW unseen.
_lb=$(timeout 300 ./bin/check-links 2>/dev/null); _lc=$?
if [ $_lc -eq 0 ]; then _now=0
else _now=$(printf '%s' "$_lb" | grep -oE '[0-9]+ citation\(s\) point nowhere' | grep -oE '^[0-9]+'); fi
_cap=$(grep -F '`links.broken`' docs/METRICS.md | grep -oE '\*\*[0-9]+\*\*' | grep -oE '[0-9]+')
# An unreadable count is NOT zero: without a number this must fail, never quietly pass.
if [ -z "$_now" ] || [ -z "$_cap" ]; then
  bad "broken citations stay at or below the committed ceiling" "two readable counts" \
      "check-links='${_now:-unreadable}' METRICS='${_cap:-unreadable}'"
elif [ "$_now" -le "$_cap" ]; then
  ok "broken citations ($_now) stay at or below the ceiling ($_cap, docs/METRICS.md)"
else
  bad "broken citations stay at or below the committed ceiling" "≤ $_cap" \
      "$_now — regenerate with bin/generate-metrics only after FIXING them, not to hide them"
fi

# ⭐ ZOMBIE CORRUPTIONS — two bad paths that came back FOUR times on 2026-07-30, because every
# `migrate-doc` revert restores the HEAD version that still contains them. Fixed in the working
# tree each time, they return on the next revert. This check makes their return a FAILURE instead
# of a surprise; they die for good when the tree is committed.
z=$(grep -rl "plan-v2-rollout_Entrenamiento\|Cerebro/casos/CASO_Default" --include="*.md" . 2>/dev/null \
    | grep -v "^./.git" | grep -cv "test-f0-f6")
eq "no zombie corruptions (they return on every revert until committed)" "0" "$z"

# ═══════════════════════════════════════════════════════════════ SELF-TEST
head2 "SELF-TEST — the checks are made to FAIL on purpose"

# ⭐ F4 of the root plan (rules/rule-checks-must-measure.md). 8 findings on 2026-08-02 shared one
# shape: a check that RUNS, reports green, and is not measuring what it claims. Every one was
# caught by breaking it BY HAND — so the manual step became the hole.
#
# ⚠️ Scope on purpose: NOT all 66 assertions. GATE db/close, pre-commit and gate-handoff already
# carry their own negative twin (BLOCKS … / allows …), so they are covered. What follows are the
# guards over something IRREVERSIBLE whose negative direction nothing exercised.
#
# 🔴 The corollary that cost two probes today: when a negative run does NOT fire, suspect the
# PROBE as well as the check. Each probe below asserts its own setup before trusting the result.

# ── 1 · the /clear guard must not accept an id embedded in a longer string ──
# Fixed in 8d9f5f3: `sid not in text` matched 8 hex ANYWHERE, so a commit hash disarmed the
# guard that exists because of the 21-jul incident.
_reg="Cerebro/Registro_Conversaciones.md"
_sid=$(ls -t "$(python3 -c "
import sys; sys.path.insert(0,'bin'); import mente_config as c; print(c.session_dir()[0] or '')" \
  2>/dev/null)"/*.jsonl 2>/dev/null | head -1)
_sid=$(basename "${_sid:-none}" .jsonl | cut -c1-8)
if [ "$_sid" != "none" ] && [ -f "$_reg" ]; then
  cp "$_reg" /tmp/reg.$$
  printf '\n<!-- probe abc%sdef -->\n' "$_sid" >> "$_reg"
  # PROBE SELF-CHECK: the bait must really be embedded and NOT present as a standalone id
  _bait=$(grep -cE "(^|[^0-9a-f])$_sid([^0-9a-f]|$)" "$_reg")
  ./bin/check-clear-ready --quiet >/dev/null 2>&1; _r=$?
  cp /tmp/reg.$$ "$_reg"; rm -f /tmp/reg.$$
  if [ "$_bait" -gt 0 ]; then
    note "clear-guard probe skipped: this session IS registered, no false-positive to force"
  else
    eq "clear guard: an id embedded in a hash does NOT open /clear" "1" "$_r"
  fi
fi

# ── 2 · ADR symmetry must not accept the bare number ──
# Fixed in 52e03a0: it compared "016", which "2016" satisfies.
_a29="rules/decisions/ADR-029-full-v1-to-v2-migration.md"
if [ -f "$_a29" ] && grep -q "ADR-016" "$_a29"; then
  cp "$_a29" /tmp/a29.$$
  sed -i 's/ADR-016/the earlier decision/g' "$_a29"
  printf '\nMigrated 2016 documents in phase F3-016b.\n' >> "$_a29"
  _bait=$(grep -c "ADR-016" "$_a29")          # must be 0 for the probe to mean anything
  _loose=$(grep -c "016" "$_a29")             # but "016" must still appear
  ./bin/check-blocks --adrs >/dev/null 2>&1; _r=$?
  cp /tmp/a29.$$ "$_a29"; rm -f /tmp/a29.$$
  if [ "$_bait" -eq 0 ] && [ "$_loose" -gt 0 ]; then
    eq "ADR symmetry: a bare '016' does NOT satisfy 'ADR-016'" "2" "$_r"
  else
    bad "ADR symmetry probe" "bait removed, loose 016 present" "bait=$_bait loose=$_loose"
  fi
fi

# ── 3 · the credential guard must notice a NEW protected target ──
# Fixed 2026-07-31 (SENSITIVE listed three paths) and re-verified today: the guard must
# DISCOVER what exists, not consult what someone remembered.
_probe="$HOME/.mente-probe-credentials"
printf 'probe\n' > "$_probe" 2>/dev/null
if [ -f "$_probe" ]; then
  ./bin/check-health >/tmp/ch.$$ 2>&1
  rm -f "$_probe"
  grep -qiE "credential|deny" /tmp/ch.$$ \
    && ok "credential guard still reports on the deny surface" \
    || note "credential guard printed nothing about the deny surface"
  rm -f /tmp/ch.$$
fi

# ── 4 · grade-block must not report a verdict it did not measure ──
# 🔴 THE HOLE THIS CLOSES (2026-08-05): three defects survived in the tool that issues EVERY
# layer-1 verdict, and all three were found by accident. The battery covered check-blocks,
# check-links and check-health — nothing ever fed grade-block a malformed §B and asserted it
# refuses instead of returning a false ⬜. A validator nobody validates reports what it never
# measured, which is the exact failure rules/rule-checks-must-measure.md forbids.
_gbdir="blocks/active/probe-grade"
mkdir -p "$_gbdir"
# 4a · a comment between `## ✅ IN` and the first `- ` must NOT kill the scope silently.
#      Before the fix this returned ⬜ NOTHING MEASURED with every real metric green.
cat > "$_gbdir/BLOCK.md" <<'PROBE'
# BLOCK · probe-grade
id: blk-probe-grade-2026-08
type: docs
intent: probe — asserts grade-block parses a scope that carries a comment
status: active · lane: direct · owner: brian
## ✅ IN
<!-- a comment here used to end the list and empty the scope -->
- `rules/qa-dimensions.md`
## ⛔ OUT
- nothing
PROBE
_out=$(./bin/grade-block probe-grade 2>&1)
# PROBE SELF-CHECK: the bait must really be a comment sitting inside the IN list
_bait=$(grep -A1 '## ✅ IN' "$_gbdir/BLOCK.md" | grep -c '<!--')
if [ "$_bait" -eq 1 ]; then
  printf '%s' "$_out" | grep -q "scope: .*qa-dimensions" \
    && ok "grade-block: a comment inside §B IN does not empty the scope" \
    || bad "grade-block comment-in-scope" "scope parsed" "scope empty (false ⬜)"
else
  bad "grade-block probe 4a" "comment inside the IN list" "bait=$_bait"
fi
# 4b · an EMPTY scope must never score PRODUCT — absence of evidence is not evidence.
cat > "$_gbdir/BLOCK.md" <<'PROBE'
# BLOCK · probe-grade
id: blk-probe-grade-2026-08
type: docs
intent: probe — asserts an empty scope cannot pass
status: active · lane: direct · owner: brian
## ✅ IN
- (nothing declared)
## ⛔ OUT
- nothing
PROBE
./bin/grade-block probe-grade 2>&1 | grep -q "PRODUCT" \
  && bad "grade-block empty scope" "NOT a pass" "scored PRODUCT with nothing measured" \
  || ok "grade-block: an empty scope does NOT score PRODUCT (ADR-028)"
# 4c · a block with no `type:` must be REFUSED, never guessed (ADR-028).
cat > "$_gbdir/BLOCK.md" <<'PROBE'
# BLOCK · probe-grade
id: blk-probe-grade-2026-08
intent: probe — asserts a missing type is refused, not guessed
status: active · lane: direct · owner: brian
## ✅ IN
- `rules/qa-dimensions.md`
## ⛔ OUT
- nothing
PROBE
./bin/grade-block probe-grade >/dev/null 2>&1 \
  && bad "grade-block missing type" "refused (exit != 0)" "accepted and graded anyway" \
  || ok "grade-block: a block with no type: is REFUSED, not guessed"
rm -rf "$_gbdir"
# 4d · a glob must stay refused: it would silently grade a DIFFERENT block.
./bin/grade-block 'demo*' >/dev/null 2>&1 \
  && bad "grade-block glob" "refused" "a glob was accepted as a block name" \
  || ok "grade-block: a glob is refused (it would grade another block)"
# 4e · an ARCHIVED block must still be gradeable — its §K verdict has to be reproducible
#      (architecture §12-Q.4). The `_YYYY-MM` suffix used to be rejected outright.
_arch=$(ls -d blocks/archive/*/ 2>/dev/null | head -1)
if [ -n "$_arch" ]; then
  _an=$(basename "${_arch%/}")
  ./bin/grade-block "$_an" 2>&1 | grep -q "LAYER 1 VERDICT" \
    && ok "grade-block: an archived block can be re-graded ($_an)" \
    || bad "grade-block archived" "gradeable" "refused — §K verdict not reproducible"
fi

# ── 5 · the three rules that NO script was enforcing (2026-08-05) ──
# 🔴 Measured this session: rule-inheritance, rule-moving-files and rule-shipping-flow were named
# by no validator. By this project's own law — code 100%, document 40-60% — they were the weakest
# rules in the tree, and one of them had been written the same day. What follows does not check
# that the FILES exist (that is check-links' job): it checks the CLAIM each one makes.

# 5a · rule-inheritance: a block may ADD or TIGHTEN, never LOOSEN. The measurable face of that is
#      that no block grants itself access to a path the config gates. A block that did would be
#      "lying on paper" while the harness still refuses — §2 of the rule.
_loosen=0
for _b in blocks/active/*/BLOCK.md blocks/archive/*/BLOCK.md; do
  [ -f "$_b" ] || continue
  # a gated path appearing in Scope IN (not in OUT, where naming it is correct)
  _in=$(sed -n '/## ✅ IN/,/## ⛔ OUT/p' "$_b")
  printf '%s' "$_in" | grep -qE "5M-incubathon|marca-personal/Mente" && {
    _loosen=$((_loosen+1)); printf '     ⤷ %s claims a gated path in its Scope IN\n' "$_b"; }
done
eq "no block LOOSENS an inherited gate (rule-inheritance §2)" "0" "$_loosen"

# 5b · rule-moving-files: step 1 is "check if it is tracked". Its measurable consequence is that a
#      moved document leaves no citation pointing at where it used to be. Archived blocks are the
#      case that proves it — every close moves a directory.
_ghost=$(grep -rlE "blocks/active/(distribucion|expertise-programacion|split-architecture)\b" \
         --include="*.md" . 2>/dev/null | wc -l)
eq "no citation points at a block that was archived (rule-moving-files)" "0" "$_ghost"

# 5c · rule-shipping-flow: transversal by construction — it is useless unless a block DECLARES it
#      in §D, because pre-edit-standards.py injects only what §D lists. Written 2026-08-05 and
#      declared by nobody active: the flow existed and reached no one.
_ship=0
for _b in blocks/active/*/BLOCK.md; do
  [ -f "$_b" ] || continue
  # ⚠️ Only §D counts. Grepping the WHOLE file passed while the rule was merely MENTIONED in §G —
  # caught 2026-08-05 by deleting the §D line and watching this check stay green. A mention is not
  # a declaration: the hook reads §D and nothing else.
  sed -n '/## Required standards/,/══ E/p' "$_b" | grep -q "rule-shipping-flow" || {
    _ship=$((_ship+1))
    printf '     ⤷ %s does not declare the shipping flow in its §D\n' "$_b"; }
done
eq "every ACTIVE block is handed the shipping flow (§D)" "0" "$_ship"

# 5d · WORKSPACE.md is an INSTANCE document: it ages in silence. Two things must hold — it must
#      never carry a secret VALUE (it says WHERE, never WHAT), and the repos it names must exist.
_ws="$M/docs/WORKSPACE.md"
if [ -f "$_ws" ]; then
  # a credential value would look like an assignment or a long opaque token
  _leak=$(grep -cEi "(password|passwd|token|secret|api[_-]?key)\s*[:=]\s*[^ ]{6,}" "$_ws")
  eq "WORKSPACE.md carries no credential VALUE (only pointers)" "0" "$_leak"
  _gone=0
  for _r in $(grep -oE '`~/for3s/[a-zA-Z0-9._-]+/' "$_ws" | tr -d '`' | sed "s|~/for3s/||;s|/$||" | sort -u); do
    [ -e "$REPO/$_r" ] || { _gone=$((_gone+1))
      printf '     ⤷ WORKSPACE names %s which is not on disk\n' "$_r"; }
  done
  eq "every repo WORKSPACE.md names is really on disk" "0" "$_gone"
else
  bad "docs/WORKSPACE.md" "exists" "MISSING — the agent re-derives the layout every session"
fi

# ── 6 · FILLED criterion must REACH somebody (2026-08-05) ──
# 🔴 The failure this closes, and it happened three times in one day: a piece is written, it is
# correct, and nothing declares it — so hooks/pre-edit-standards.py never injects it and the
# criterion governs nothing. Writing is not wiring. An expertise file that carries Brian's
# criterion and appears in no active block's §D is filled criterion nobody will ever be handed.
# ⚠️ SCOPE, corrected 2026-08-05 (Brian): this check demanded that EVERY filled expertise reach an
# active block — but a discipline only applies to blocks whose subject matter it governs. With one
# `code` block open, it was demanding that `doc-planning` be declared there, which would inflate §D
# and trip check-applied. Worse, the assumption underneath was wrong: **Mente OS users may never
# write code at all** (*"no es ley que siempre será así"*). So a discipline is only required to
# reach a block when a block of a type it governs is open.
_orphan=0
_types=$(grep -h "^type:" blocks/active/*/BLOCK.md 2>/dev/null | awk '{print $2}' | sort -u)
for _e in principles/expertise/*.md; do
  _n=$(basename "$_e")
  # only FILLED files are held to this — an empty one has nothing to deliver yet
  grep -q "BRIAN'S CRITERION" "$_e" || continue
  # which block types does this discipline govern?
  case "$_n" in
    dev-*|val-*)  _governs="code data infra" ;;
    doc-*)        _governs="docs" ;;
    *)            _governs="code docs infra data" ;;
  esac
  _relevant=0
  for _t in $_types; do
    case " $_governs " in *" $_t "*) _relevant=1 ;; esac
  done
  [ "$_relevant" -eq 1 ] || continue        # no open block of a type it governs → not applicable
  _decl=0
  for _b in blocks/active/*/BLOCK.md; do
    [ -f "$_b" ] || continue
    # ⚠️ Only real `- ` list entries count. Grepping the §D range verbatim passed on a COMMENT
    # saying the standard had been REMOVED ("<!-- expertise/dev-frontend.md removed … -->") —
    # caught 2026-08-05. A comment about a standard is not a declaration of it; the hook reads
    # the list. Same defect as check 5c, one layer down.
    sed -n '/## Required standards/,/══ E/p' "$_b" \
      | grep -E "^\s*-\s" | grep -q "expertise/$_n" && _decl=1
  done
  [ "$_decl" -eq 1 ] || { _orphan=$((_orphan+1))
    printf '     ⤷ %s carries criterion but no ACTIVE block declares it in §D\n' "$_n"; }
done
eq "every FILLED expertise file reaches an active block (§D)" "0" "$_orphan"

# 6b · the owner must not advertise its disciplines as pending once they are filled.
# owner-3-validation.md governs EVERY block close; saying "pending" about a filled file makes the
# reader apply the weaker path (the §5-BIS battery alone) when stricter criterion already exists.
_stale=0
for _o in principles/owner-*.md; do
  for _d in $(grep -oE 'expertise/[a-z-]+\.md' "$_o" 2>/dev/null | sort -u); do
    [ -f "principles/$_d" ] || continue
    grep -q "BRIAN'S CRITERION" "principles/$_d" || continue
    # the discipline is filled: the owner must not still call it pending on that same line
    grep -E "$(basename "$_d")" "$_o" | grep -qi "pending" && { _stale=$((_stale+1))
      printf '     ⤷ %s still calls %s pending, but it is filled\n' \
             "$(basename "$_o")" "$(basename "$_d")"; }
  done
done
eq "no owner advertises a FILLED discipline as pending" "0" "$_stale"

# ── 7 · THE ENGINE MUST KNOW WHICH VERSION IT IS (P4, 2026-08-05) ──
# 🔴 Measured 2026-08-05: the engine is PUBLISHED (mente-os, MIT) with no VERSION and no CHANGELOG.
# An engine that cannot say which version it is cannot be debugged in someone else's house — which
# is exactly the field-test scenario still pending. Both intern-os and graphify solve this; the
# difference is WHERE the number lives. graphify keeps ONE source and propagates; intern-os
# validates three copies agree. One source is stricter: a copy cannot drift if it does not exist.
if [ -f "$M/VERSION" ]; then
  _ver=$(head -1 "$M/VERSION" | tr -d '[:space:]')
  printf '%s' "$_ver" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' \
    && ok "VERSION declares a semantic version ($_ver)" \
    || bad "VERSION format" "N.N.N" "$_ver"
  # The CHANGELOG must carry an entry for exactly this version — a version nobody wrote down is a
  # number, not a release.
  if [ -f "$M/CHANGELOG.md" ]; then
    grep -qE "^## +$(printf '%s' "$_ver" | sed 's/\./\\./g')( |$|—)" "$M/CHANGELOG.md" \
      && ok "CHANGELOG has an entry for the current VERSION" \
      || bad "CHANGELOG entry" "a '## $_ver' heading" "absent"
  else
    bad "CHANGELOG.md" "exists" "MISSING — a version with no record of what changed"
  fi
else
  bad "VERSION" "exists" "MISSING — the engine cannot say which version it is"
fi

# ⭐ intern-os #5 · VERSION-SELF-AWARENESS — having the number is not the same as SAYING it.
# P4 created VERSION and CHANGELOG; nothing REPORTED them. A bug report from another machine
# that cannot name a version is a bug report nobody can reproduce — the field-test scenario.
# intern-os validates the number across three places; here the source is ONE file, so the check
# is that the number REACHES the operator, not that three copies agree.
_vs=$(head -1 "$M/VERSION" 2>/dev/null | tr -d '[:space:]')
_vout=$("$M/bin/check-health" 2>&1 | grep -c "Mente OS $_vs")
[ "${_vout:-0}" -ge 1 ] \
  && ok "check-health states which version is running ($_vs)" \
  || bad "version reporting" "check-health prints 'Mente OS $_vs'" "silent"

# ── 8 · A VALIDATOR THAT WRITES MUST NOT LEAVE THE TREE (graphify #3, 2026-08-05) ──
# 🔴 Measured that day: `bin/migrate-doc VERSION ../../../tmp/x --dry-run` was ACCEPTED and printed
# the move as valid. Only --dry-run stopped it; without the flag it would have moved a document out
# of Mente, and every citation to it would have become unresolvable.
# The fix is graphify's `validate_graph_path()` shape: RESOLVE the path and assert it stays under
# the root — a blacklist of "../" shapes misses the next shape; resolution answers the real
# question, *where does this actually land?*
"$M/bin/migrate-doc" VERSION ../../../tmp/zz-escape --dry-run >/dev/null 2>&1 \
  && bad "migrate-doc escape" "REFUSED" "accepted a destination outside Mente" \
  || ok "migrate-doc refuses a destination outside the tree"
# …and it must still allow the legitimate move it exists for.
"$M/bin/migrate-doc" VERSION docs --dry-run >/dev/null 2>&1 \
  && ok "migrate-doc still allows a move INSIDE the tree" \
  || bad "migrate-doc inside" "allowed" "refused a legitimate move"

# ═══════════════════════════════════════════════════════════════════ RESULT
printf '\n\033[1m════ RESULT ════\033[0m\n'
printf '  passed: %d\n  failed: %d\n' "$PASS" "$FAIL"
[ ${#NOTE[@]} -gt 0 ] && { printf '  notes:\n'; for n in "${NOTE[@]}"; do printf '    · %s\n' "$n"; done; }
[ "$FAIL" -eq 0 ] && printf '\n  ✅ F0-F6 verified end to end\n' \
                  || printf '\n  🔴 %d check(s) FAILED\n' "$FAIL"
exit $([ "$FAIL" -eq 0 ] && echo 0 || echo 1)
