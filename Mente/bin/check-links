# Generic filenames that name a KIND of file, not one file: `BLOCK.md` means "any block".
# `SKILL.md` names a KIND too: every skill has one (.claude/skills/<name>/SKILL.md). The three
# documents citing it are quoting the frozen-number incident, not linking to one skill.
GENERIC = {"BLOCK.md", "SUMMARY.md", "README.md", "MEMORY.md", "connections.md", "SKILL.md",
           "settings.json", "settings.local.json", "package.json", "__init__.py"}
# One level above Mente: the project root holds CLAUDE.md and PROJECT-RULES.md.
PARENT = {"CLAUDE.md", "PROJECT-RULES.md", ".gitignore"}

# ⭐ Directorios que el `.gitignore` excluye A PROPÓSITO: existen en la máquina del dueño y
# NUNCA viajan al repositorio. Un puntero hacia ellos es correcto, no roto — pero solo se
# acepta si el directorio no está presente (clon) o si el archivo sí existe (máquina real).
# Se LEE del .gitignore: una lista escrita a mano aquí se desincroniza del archivo que manda.
def _ignorados():
    fuera = set()
    try:
        for line in open(".gitignore", encoding="utf-8"):
            s = line.strip()
            if s and not s.startswith("#") and s.endswith("/") and "*" not in s:
                fuera.add(s.rstrip("/").split("/")[0])
    except OSError:
        pass
    return fuera


IGNORADOS_A_PROPOSITO = _ignorados()


# ⭐ REPOS HERMANOS: viven AL LADO de Mente/, nunca dentro, y NUNCA viajan al repositorio.
# Un puntero hacia ellos (`../for3s-inter/…`, `marca-personal/…`) es correcto y útil en la
# máquina del dueño, y en un clon no puede resolver por diseño — no porque esté mal escrito.
#
# 🔴 Medido en un clon limpio el 2026-08-06: ~50 de las citas "rotas" eran esto. Un clon que
# arranca reportando 50 fallos **parece roto sin estarlo**, y un validador que grita sobre lo
# correcto enseña a ignorarlo.
#
# ⛔ Y NO es dejar de verificar: en la máquina que SÍ tiene el hermano, la ruta se comprueba
# como cualquier otra. Lo que se acepta es "el destino está fuera del repo por diseño".
# Se LEE de `mente.config.yml` (`siblings` + `outside`): una lista a mano aquí se desincroniza
# del archivo que declara la verdad.
def _hermanos():
    fuera = set()
    try:
        import mente_config as _mc
        for k in ("siblings", "outside"):
            for x in (_mc.get(k) or []) if hasattr(_mc, "get") else []:
                fuera.add(str(x).strip("/").split("/")[0])
    except Exception:                                          # noqa: BLE001
        pass
    if not fuera:                       # respaldo: leer el YAML a mano, sin dependencias
        try:
            sec = None
            for line in open("mente.config.yml", encoding="utf-8"):
                s = line.rstrip()
                if re.match(r"^(siblings|outside):", s):
                    sec = True
                    continue
                if sec and re.match(r"^\s*-\s", s):
                    v = s.split("-", 1)[1].strip().strip('"\'').split("#")[0].strip()
                    if v:
                        fuera.add(v.strip("/").split("/")[0])
                elif sec and s and not s.startswith((" ", "\t", "#")):
                    sec = None
        except OSError:
            pass
    return fuera


HERMANOS = _hermanos()
# Outside Mente: other repos, the harness, the agent. Not ours to resolve.
# ⚠️ `memory/<fecha>.md` es de OpenClaw (diarios del agente ajeno), NO de nuestra memory/.
# Colisión de nombre creada al elegir `memory/` como destino v2 en M1 (2026-07-30).
OPENCLAW_MEMORY = re.compile(r"^memory/(\d{4}-\d{2}-\d{2}|AAAA-MM-DD)\.md$")

# Declared per instance (mente.config.yml): pointers into these belong to other repos.
OUTSIDE = tuple(cfg.outside())

# ⭐ ¿Está presente el repo hermano donde una cita PODRÍA resolver? (2026-08-07)
# `in_sibling_repo` resuelve contra `../<repo>`. Si ese repo no está clonado, devuelve False y
# la cita se reporta ROTA — pero no lo está: es que el destino no viaja.
# 🔴 Medido en un clon limpio: 12 citas de `work/`, `memory/` y `Cerebro/` señaladas como rotas.
# Las 12 resuelven de verdad en la máquina de Brian (`for3s-inter/`, `For3s-OS/`,
# `marca-personal/`), todos ya declarados `outside:`. El clon las llamaba defectos.
# ⛔ NO es un indulto: si el hermano ESTÁ presente, la cita se verifica como siempre y un
# puntero equivocado sigue fallando. Solo se calla cuando no hay dónde comprobar — y entonces
# el silencio es honesto, porque afirmar "rota" sería afirmar sin medir.
#
# ⚠️ Y "hermano" significa REPO hermano, no cualquier entrada de `outside:`. La primera versión
# preguntaba `any(isdir(...))` sobre la lista entera y salía False siempre: `.claude/` está en
# esa lista y **existe en todo clon** porque lo crea `bin/init`. Bastaba una entrada interna
# para que el flag nunca se encendiera. Se descartan las que empiezan por punto y las que son
# nombres de tooling — no son árboles donde una cita pueda resolver.
_NO_ES_REPO = ("node_modules", "workspace")
_SIN_HERMANOS = not any(
    os.path.isdir(os.path.join("..", r.rstrip("/")))
    for r in OUTSIDE
    if not r.startswith(".") and r.rstrip("/") not in _NO_ES_REPO)

# ⚠️ Y se acota a los documentos que son INSTANCIA. Un flag global habría callado también las
# citas de `rules/` y `bin/` —el motor—, y ahí una cita rota SÍ es un defecto que viaja a todos.
# Estas tres carpetas son la bitácora de un trabajo concreto: hablan de los repos de su autor.
DOCS_DE_INSTANCIA = ("work/", "memory/", "Cerebro/")


def is_harness_memory(c):
    """A `project_*.md` / `feedback_*.md` citation naming a harness memory, not a file here.

    🔴 Found 2026-08-02: 7 rounds cite `project_r6_critical_pre_code_review.md` and friends.
    They EXIST — in ~/.claude/projects/<slug>/memory/, which is the harness's store and lives
    outside this tree on purpose. Verified present before excusing them; the existence check is
    what keeps this from becoming a blanket pardon for any `project_`-prefixed typo.
    """
    if "/" in c or not re.match(r"^(project|feedback|reference)_.+\.md$", c):
        return False
    d, _ = cfg.session_dir()
    if not d or not os.path.isdir(os.path.join(d, "memory")):
        # 🔴 FAMILIA D de `rules/rule-checks-must-measure.md` (2026-08-07): el almacén del
        # harness vive en `~/.claude/projects/<slug>/`, FUERA de este árbol y por máquina. En un
        # clon no existe, así que exigir el archivo allí reportaba 20 citas CORRECTAS como rotas
        # — medido corriendo `check-links` en un clon limpio.
        # ⚠️ LÍMITE MEDIDO Y DICHO: sin el almacén esto es un INDULTO GENERAL — cualquier
        # `project_loquesea.md` pasa, erratas incluidas (probado: una inventada no se cazó).
        # Se acepta a conciencia porque la alternativa es peor: 20 citas correctas reportadas
        # como rotas en cada clon, que es cómo un validador se vuelve ruido y se ignora entero.
        # ⭐ Dónde SÍ se verifican: en la máquina que tiene el almacén — la del dueño de esas
        # memorias, que es la única que puede saber si el nombre es correcto.
        return True
    return os.path.exists(os.path.join(d, "memory", c))


def in_sibling_repo(c):
    """Does this citation resolve inside a repo declared `outside`?

    🔴 Found 2026-08-02 auditing the 144: `startswith(OUTSIDE)` only excused a citation that
    SPELLS the repo — but the round documents write the prefix in prose and the path in the
    backticks (`09-technical-architecture/tools-mcp-layer.md` right under a line naming
    for3s-inter/). Measured: 3 of 4 sampled resolve inside ../for3s-inter and were counted as
    broken pointers into OUR tree.

    ⭐ It RESOLVES the path instead of pattern-matching the name: a rule that excused
    `NN-word/` by shape would excuse any future typo of that shape too. This one only goes
    quiet when the file is really there — unknown paths still fail closed.
    """
    for repo in OUTSIDE:
        root = os.path.join("..", repo.rstrip("/"))
        if "/" in c:
            if os.path.exists(os.path.join(root, c)):
                return True
            continue
        # A BARE name (`CHANGELOG.md`, `pentest-plan.md`) is excused only when the sibling repo
        # holds EXACTLY ONE file by that name. Two matches means the citation is ambiguous, and
        # an ambiguous pointer is a defect worth reporting — not something to silence by luck.
        if len(_sibling_index(repo).get(c, [])) == 1:
            return True
    return False


# ── the index behind in_sibling_repo (F1, 2026-08-05) ────────────────────────
_SIBLING_INDEX = {}


def _sibling_index(repo):
    """`{filename: [paths]}` for one sibling repo, built once per process.

    🔴 WHY THIS EXISTS — measured 2026-08-05, profiled, not guessed:
        in_sibling_repo()  →      1,980 calls
          glob recursive   →      4,184 globs
            _rlistdir      → 14,730,455 calls
              time         →        114 s   (99.8% of this validator)
    The cost is not this tree: `glob.glob("**/name", recursive=True)` walked ../marca-personal
    (43,986 files) once per bare citation. Building the index for all siblings costs 0.16s.
    Measured end to end: 47.20s → 0.16s, **292x**, with `same=626 diff=0`.

    ⚠️ HIDDEN DIRECTORIES ARE PRUNED, AND THAT IS THE WHOLE POINT.
    `glob` does not descend into dot-directories; `os.walk` does. Measured: 6,036 files of
    difference across the siblings. Without the prune, `layout.md` would be seen TWICE (the
    second copy inside a `.claude/`), the index would call it AMBIGUOUS, and a citation that
    resolves today would start reporting broken. **A performance change that alters the verdict
    is the v1 failure**, so the index reproduces glob's visibility exactly.

    Proven by `docs/f0-probe-check-links.py`, which loads the real functions and compares both
    strategies citation by citation — and FAILS when the `== 1` criterion is relaxed to `>= 1`
    (rules/rule-checks-must-measure.md: a check only ever seen green is untested).

    The cache lives in memory and dies with the process — never on disk. A stale on-disk index
    would forgive a genuinely broken citation, which is exactly what this validator exists to catch.
    """
    if repo in _SIBLING_INDEX:
        return _SIBLING_INDEX[repo]
    root = os.path.join("..", repo.rstrip("/"))
    idx = {}
    if os.path.isdir(root):
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for name in filenames:
                if not name.startswith("."):
                    idx.setdefault(name, []).append(os.path.join(dirpath, name))
    _SIBLING_INDEX[repo] = idx
    return idx


# Folders whose internal citations MUST resolve — the v1 legacy plus every v2 destination.
INSIDE = ("rules/", "principles/", "blocks/", "docs/", "bin/", "hooks/",
          "Cerebro/", "Maestro/",
          "vision/", "work/", "memory/", "bridges/")


def cited(text):
    """Paths cited in backticks or markdown links."""
    # ⭐ Only .md and .tsv: this validator guards the DOCUMENT graph. Code files (.py, .sh, .json)
    # live in the agent's repo — citing `conversation.py` in a round is naming a module, not
    # linking to a file here. Including them produced 100+ non-defects (measured 2026-07-30).
    out = set(re.findall(r"`([A-Za-z0-9_./-]+\.(?:md|tsv))`", text))
    out |= set(re.findall(r"\[[^\]]*\]\(([^)#\s]+\.(?:md|tsv|sh|py))\)", text))
    return out


def main():
    quiet = "--quiet" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    files = args or [f for f in glob.glob("**/*.md", recursive=True)
                     if ".git/" not in f and not f.startswith("secrets/")]
    # 🔴 The two documents that STEER live one level up, outside this glob — so the router read
    # on every single session start was never audited. Measured 2026-08-02: CLAUDE.md carried
    # `Maestro/piezas.tsv` (it is Mente/Maestro/) and a row for `Mente/Doc/`, a folder ADR-029
    # deleted. ⭐ The file read FIRST was the least watched.
    if not args:
        files += [p for p in ("../CLAUDE.md", "../PROJECT-RULES.md") if os.path.exists(p)]

    broken = []
    for f in files:
        # ⭐ A GENERATED index is a snapshot: between a move and the next `generate-index` it
        # legitimately names old paths. Auditing it reports the generator's lag, not a defect —
        # and during M1 that made 3 reverted moves look like 10 broken links (2026-07-30).
        if f in FUTURE:
            continue
        if not os.path.exists(f):
            print(f"🔴 {f} does not exist")
            return 1
        # ⚠️ Maestro/ is a separate repo: its root is Maestro/, so a path written from the Mente
        # root is wrong INSIDE it. Its citations resolve against its own root.
        # A document one level up (CLAUDE.md, PROJECT-RULES.md) writes its paths from the PROJECT
        # root — `Mente/rules/x.md`, not `rules/x.md`. Resolving those against Mente/ would look
        # for Mente/Mente/… and silently find nothing, which is a green that means "not checked".
        base = "Maestro" if f.startswith("Maestro/") else (".." if f.startswith("../") else ".")
        try:
            text = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for c in cited(text):
            name = os.path.basename(c)
            if OPENCLAW_MEMORY.match(c):
                continue
            if c in FUTURE or PLACEHOLDER.search(c) or c.startswith(OUTSIDE):
                continue
            if in_sibling_repo(c):
                continue                      # resolves in a repo declared `outside`
            # Documento de instancia + ningún repo hermano clonado = no hay dónde verificar.
            # Se calla, y solo aquí: en el motor una cita rota sigue siendo un defecto.
            if _SIN_HERMANOS and f.startswith(DOCS_DE_INSTANCIA):
                continue
            if c in DISCUSSED.get(f, ()):
                continue                      # this document's subject, not its pointer
            if is_harness_memory(c):
                continue                      # lives in the harness memory store, verified
            # 🔴 secrets/ was skipped as a SOURCE (line below) but never as a DESTINATION, so
            # RETOMAR.md pointing at the demo secrets — present on disk, gitignored on purpose
            # (rule-config-hygiene §1.1) — read as a broken pointer. Reporting it invites
            # deleting a correct one. Resolved by existence, so a wrong path still fails.
            # ⭐ GENERALIZADO 2026-08-06: no solo `secrets/`, sino CUALQUIER destino que el
            # `.gitignore` excluya a propósito. Medido en un clon limpio ese día: 17 de las 30
            # citas rotas apuntaban a `Maestro/` y `secrets/` — carpetas que NO viajan por
            # decisión, no por error. En la máquina de Brian existen y el check pasaba; un clon
            # las veía rotas y **arrancaba reportando 30 fallos, pareciendo roto sin estarlo**.
            #
            # ⛔ Y esto NO es eximir por nombre: un puntero a `Maestro/no-existe.md` sigue
            # fallando EN LA MÁQUINA QUE SÍ TIENE `Maestro/`, que es donde se puede verificar.
            # Lo que se acepta es "el destino es local por diseño", no "no lo comprobamos".
            _limpia = re.sub(r"^Mente/", "", c)
            # un hermano: se acepta si NO está presente (clon); si está, se verifica de verdad
            # ⚠️ Se quitan TODOS los `../` iniciales, no solo uno: las citas reales usan
            # `../for3s-inter/…` y también `../../for3s-inter/…` según desde dónde se escriban.
            _rel = re.sub(r"^(\.\./)+", "", _limpia.lstrip("./"))
            _raiz = _rel.split("/")[0]
            if _raiz in HERMANOS and not os.path.isdir(os.path.join("..", _raiz)):
                continue
            if _limpia.split("/")[0] in IGNORADOS_A_PROPOSITO:
                if os.path.exists(_limpia) or not os.path.isdir(_limpia.split("/")[0]):
                    continue
            if name in GENERIC and "/" not in c:
                continue                      # a kind of file, not a specific one
            if name in PARENT and os.path.exists(os.path.join("..", name)):
                continue                      # lives at the project root, above Mente
            if f.startswith(DESCRIBES) or f in PLANNED or DESCRIBE_FOREIGN.match(f):
                continue
            # The exemption follows the DOCUMENT, not the folder: a radiography of OpenClaw keeps
            # describing OpenClaw after it moves. Recognised by its own migration trail.
            if re.match(r"^(Radiografia|Comparacion|Analisis|Entrenamiento|Estado_|TRAZA|"
                        r"Examen|Informe|Changelog|Banco_)", os.path.basename(f)):
                continue
            # A URL is not a path.
            if c.startswith(("http", "/")):
                continue
            # resolves from the Mente root, from its own directory, or from its repo root?
            # ⚠️ For a document ABOVE Mente the bare `c` fallback must NOT apply: it would resolve
            # `Maestro/piezas.tsv` from inside Mente/ and call it valid, while a reader starting at
            # the project root finds nothing there. That fallback turned a real broken pointer green.
            cands = ((os.path.join(base, c), os.path.join(os.path.dirname(f), c))
                     if f.startswith("../")
                     else (os.path.join(base, c), os.path.join(os.path.dirname(f), c), c))
            for cand in cands:
                if os.path.exists(cand):
                    break
            else:
                # A BARE NAME (no directory) that exists SOMEWHERE is not a broken link — it is an
                # ambiguous one, and `bin/check-blocks` already reports that as 🟡 "bare path".
                # Two validators reporting the same thing differently is how you learn to ignore
                # both. This one answers a narrower question: does the TARGET exist at all?
                if "/" not in c and glob.glob(f"**/{name}", recursive=True):
                    continue
                broken.append((f, c))

    if quiet:
        return 1 if broken else 0
    if broken:
        print(f"\n🔴 {len(broken)} citation(s) point nowhere\n")
        for f, c in broken[:30]:
            print(f"   {f}\n      → {c}")
        if len(broken) > 30:
            print(f"   … +{len(broken) - 30} more")
        print("\n   A pointer to nothing is worse than no pointer: it is read as a promise.")
        return 1
    print(f"✅ every citation resolves ({len(files)} files checked)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
