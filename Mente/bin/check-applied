#!/usr/bin/env python3
"""check-applied — F6-4: were the declared standards actually APPLIED, or just listed?

The gap this closes: §D lists the standards a block must follow, and until now nothing ever asked
whether they left a trace. **A standard that is declared and never applied is decoration** — and
decoration is what makes a system look professional while behaving like an MVP.

This does NOT judge quality (that is `bin/grade-block`). It asks a narrower, answerable question:
**is there evidence in the block that each declared standard was used?**

Evidence is one of:
  · a §G decision citing it            (the strongest — a decision names its rule)
  · a §H friction entry naming it      (it chafed and was complied with anyway)
  · the standard's own subject appearing in §G/§I

Usage: bin/check-applied <block> [--quiet]
Exit: 0 all declared standards show evidence · 1 some do not
"""
import os
import re
import sys
import glob

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(MENTE)


def section(text, name, nxt):
    m = re.search(rf"##\s*{name}\b(.*?)(?=##\s*{nxt}|\Z)", text, re.S)
    return m.group(1) if m else ""


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    quiet = "--quiet" in sys.argv
    if not args:
        print(__doc__)
        return 1
    # 🔴 A block name is a folder name. A glob or a path would silently resolve to a DIFFERENT
    # block and report about it under the name you typed (found adversarially, 2026-07-30:
    # `check-applied '*'` printed a verdict titled `*` about `demo`).
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", args[0]):
        print(f"🔴 {args[0]!r} is not a block name — lowercase letters, digits and hyphens only.\n"
              "   Globs and paths are refused: they would grade a block you did not ask about.")
        return 1
    hits = glob.glob(f"blocks/**/{args[0]}/BLOCK.md", recursive=True)
    if not hits:
        print(f"🔴 no block named {args[0]!r}")
        return 1

    text = open(hits[0], encoding="utf-8", errors="replace").read()
    # An HTML comment documents why something was REMOVED — it is not a declaration.
    # (Caught 2026-07-30: this counted a removal note as a declared standard still in force.)
    sec = re.sub(r"<!--.*?-->", "", section(text, "Required standards", "State"), flags=re.S)
    std = re.findall(r"^\s*-\s*([\w./-]+\.md)", sec, re.M)
    if not std:
        if not quiet:
            print(f"🔴 {args[0]}: §D declares no standards (contract-block.md requires them)")
        return 1

    # Where evidence of application can live.
    evidence = (section(text, "Decisions", "Quality") + section(text, "Friction log", "Checkpoints")
                + section(text, "Checkpoints", "Context") + section(text, "Quality verdict", "Friction"))

    # ⭐ …AND in the files those sections POINT AT (added 2026-08-05).
    # `doc-structure.md` says a document over its ceiling MUST be split and the halves pointed at.
    # The demo block hit 206 lines and its 7 July decisions moved to docs/decisions-julio.md — and
    # 3 standards instantly read as "never applied", because this check only looked at the §G text.
    #
    # 🔬 The lesson, measured that day: **a pointer a machine does not follow is not a pointer.**
    # A rule that splits documents and a check that only reads one of the halves cannot both be
    # right. Following the pointer is what makes the split honest instead of a way to hide history.
    for rel in re.findall(r"`(blocks/[\w./-]+\.md)`", evidence):
        p = os.path.join(MENTE, rel)
        if os.path.isfile(p):
            evidence += open(p, encoding="utf-8", errors="replace").read()

    applied, missing = [], []
    for s in std:
        stem = os.path.basename(s).rsplit(".", 1)[0]
        # ⭐ Evidence = the standard NAMED (path or stem). Nothing looser.
        #
        # 🔴 It used to also accept "its subject words appear somewhere", checking each word
        # SEPARATELY: `rule-session-close` → ["session", "close"], and the demo block mentions
        # `session.ts` and `closed` for unrelated reasons → ✅ for a standard nobody applied.
        # Measured 2026-08-05 by declaring `rule-session-close.md` in a block that never used it:
        # the check passed it. **A test whose sabotage does not turn it red is not measuring.**
        #
        # A whole-word check on the joined subject stays as the loose form, so a decision that
        # discusses `fix not patch` in prose still counts — but two common words in different
        # paragraphs no longer do.
        joined = " ".join(w for w in re.split(r"[-_]", stem)
                          if w not in ("rule", "case", "contract"))
        if (s in evidence or stem in evidence
                or (len(joined) > 8 and joined in evidence.lower())):
            applied.append(s)
        else:
            missing.append(s)

    if quiet:
        return 1 if missing else 0

    print(f"\nBLOCK {args[0]} — were the §D standards applied?\n")
    for s in applied:
        print(f"  ✅ {s}")
    for s in missing:
        print(f"  🟡 {s} — declared, no trace in §G/§H/§I")
    print()
    if missing:
        print(f"  🟡 {len(missing)}/{len(std)} declared standards show no evidence of use.")
        print("     A standard declared and never applied is decoration.")
        print("     Either cite it in a §G decision, log the friction in §H, or REMOVE it from §D —")
        print("     an inflated §D makes the injection hook noise, and noise gets ignored.")
        return 1
    print(f"  ✅ all {len(std)} declared standards show evidence of use")
    return 0


if __name__ == "__main__":
    sys.exit(main())
