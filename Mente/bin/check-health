#!/usr/bin/env python3
# Implements ADR-024 — the system audits ITSELF at SessionStart
"""check-health — the system audits its own state, without being asked.

Rule behind this file (Brian, 2026-07-27): **if you have to ASK for it, it is not automated.**
Three failures lived for weeks and were found by Brian asking — not by anything watching.

Never deletes forensic evidence. The .jsonl transcripts are never touched: the 2026-07-21
incident was recovered from them six days later, documented nowhere else.

Usage:
  bin/check-health              everything
  bin/check-health --misplaced  misplaced-file detection only
  bin/check-health --quiet      exit code only (for SessionStart)

Exit codes: 0 clean · 1 warnings · 2 errors
"""
import os
import re
import sys
import json
import glob
import subprocess
from datetime import date, datetime

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(MENTE, "bin"))
import mente_config as cfg                                            # noqa: E402
REPO = os.path.dirname(MENTE)
os.chdir(MENTE)

RED, YEL = [], []


def red(m):
    RED.append(m)


def yel(m):
    YEL.append(m)


def sh(*cmd, cwd=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=25, cwd=cwd).stdout
    except Exception:                                          # noqa: BLE001
        return ""


# ── MISPLACED FILES ──────────────────────────────────────────────────────────
# Finding #1 of 2026-07-30: three For3s OS docs were living in marca-personal/Mente/.
# They were found by NAME ("Demo", "GUIA") — which missed a fourth one,
# Plan_Pieza_E_Concentrado_Admin.md, that was the same violation.
#
# A misplaced file is not detected by its name. It is detected by its ORIGIN:
# every one of the three was written on 2026-07-20/21, during the degradation incident.
# The three legitimate files in that directory were last touched in June.
INCIDENTS = [
    # (start, end, label) — sessions where scope violations are documented
    ("2026-07-20", "2026-07-21", "2026-07-21 degradation incident (835K context, 6 scope violations)"),
]
# Directories that belong to another project: our vocabulary must not appear inside them.
FOREIGN = {
    "marca-personal/Mente": ["For3s OS", "for3s-core", "Foresito", "api_channel",
                             "Pieza E", "Pieza C", "instancia"],
}


def check_misplaced():
    for folder, markers in FOREIGN.items():
        full = os.path.join(REPO, folder)
        if not os.path.isdir(full):
            continue
        for f in glob.glob(f"{full}/**/*.md", recursive=True):
            rel = f.replace(REPO + "/", "")
            try:
                mtime = date.fromtimestamp(os.path.getmtime(f)).isoformat()
            except OSError:
                continue
            in_window = any(a <= mtime <= b for a, b, _ in INCIDENTS)
            if not in_window:
                continue
            label = next(lb for a, b, lb in INCIDENTS if a <= mtime <= b)
            # signal 2: does it talk about our project?
            try:
                head = open(f, encoding="utf-8", errors="replace").read(4000)
            except OSError:
                continue
            hits = [m for m in markers if m in head]
            if hits:
                red(f"MISPLACED · {rel}\n"
                    f"   modified {mtime} — inside the {label}\n"
                    f"   mentions: {', '.join(hits[:3])}\n"
                    f"   → likely written into the wrong project. Verify before moving.")
            else:
                yel(f"suspect · {rel} modified {mtime}, inside a known incident window")


# ── THE GUARDS THEMSELVES ────────────────────────────────────────────────────
# 🔴 Found adversarially 2026-07-30: nothing protected the guards. A hook could be deleted,
# emptied or stripped of its execute bit and NOTHING in the startup path noticed.
# ⭐ A disarmed guard is worse than no guard: the system reports healthy while unprotected.
#
# 🔴 Found again 2026-07-31, auditing every hardcoded list in the validators: this was a
# HANDWRITTEN dict of 9 entries while bin/ and hooks/ held 21 executables. The 12 unwatched
# ones included check-clear-ready (the /clear lock) and test-f0-f6 (the whole battery). Deleting
# the battery would have been silent.
#
# ⭐ THE RULE THAT CAME OUT OF THE AUDIT: a list that enumerates what is PROTECTED must be
# measured; a list that enumerates what is PERMITTED may be written, as long as the unknown
# fails closed. This one enumerated the protected — so it is discovered now.
#
# The floor is a FRACTION of the file's committed size rather than a number per file: a
# maintained number is a number that goes stale, and this whole audit started because one did.
GUARD_DIRS = ("bin", "hooks")
GUARD_FLOOR = 0.5          # gutted = under half of what git has


def _guards():
    """Every executable under bin/ and hooks/. Discovered, never listed.

    mente_config.py has no execute bit — it is imported, not run — but gutting it breaks every
    validator that reads the instance config, so it counts as a guard too.
    """
    out = []
    for d in GUARD_DIRS:
        for f in sorted(glob.glob(f"{d}/*")):
            if os.path.isfile(f) and not f.endswith((".md", ".yml", ".json")):
                out.append(f)
    return out


def check_guards():
    for path in _guards():
        # Modules that are IMPORTED, never run: no execute bit expected. Gutting them still
        # breaks everything downstream, so they stay in the guard list for the size check.
        imported = os.path.basename(path).startswith("_") or path.endswith("_config.py")
        if not os.access(path, os.X_OK) and not imported:
            red(f"GUARD DISARMED · {path} is not executable.\n"
                f"   A validator that cannot run is not a pass. Fix: chmod +x {path}")
            continue
        n = sum(1 for _ in open(path, encoding="utf-8", errors="replace"))
        # Compare against what git has, so "gutted" means gutted RELATIVE TO ITS OWN history
        # instead of relative to a threshold someone remembered to update.
        head = sh("git", "show", f"HEAD:{path}", cwd=MENTE)
        committed = head.count("\n") if head else 0
        if committed and n < committed * GUARD_FLOOR:
            red(f"GUARD GUTTED · {path} is {n} lines, was {committed} in git "
                f"(under {int(GUARD_FLOOR * 100)}%).\n"
                "   Restore it, or commit the reduction so the new size becomes the baseline.")

    # A guard that git knows and disk does not = deleted without anyone noticing.
    tracked = {p for p in sh("git", "ls-files", "bin", "hooks", cwd=MENTE).split()
               if not p.endswith((".md", ".yml", ".json"))}
    for path in sorted(tracked - set(_guards())):
        red(f"GUARD MISSING · {path} is tracked in git but not on disk. Restore it.")

    check_hooks_wired()


# ── THE SEAM: registered vs on disk ──────────────────────────────────────────
# 🔴 Found 2026-07-31 by breaking settings.json on purpose and measuring who noticed.
# check_guards() verifies the hook FILES exist. Nothing verified they are still REGISTERED.
# Two failures were completely silent:
#   · deleting all four hooks   → only the battery caught it, and only if someone runs it
#   · a hook pointing at a file that does not exist → NOBODY caught it
# In the second case check-health said the file existed, settings.json pointed elsewhere, and
# both reported green while all three gates were off.
#
# ⭐ THE SAME PATTERN, fifth time in one day: check-clear-ready watched a path but not whether
# it still existed · deny covered three tools but not Bash · SENSITIVE listed three credentials ·
# GUARDS watched 9 of 21. Every half was guarded and NOBODY guarded the seam —
# which is the project's own rule: "los bugs trágicos viven ENTRE las piezas."
#
# Why this belongs in check-health and not only in the battery: the hooks are layer D, and
# folder-structure.md calls them "lo ÚNICO que no depende del criterio de la IA. Sin ellos, el
# v2 repite el fallo del Método F: existe, es encontrable, y no se lee." A piece that critical
# cannot be verified only when someone remembers to run a test.
def check_hooks_wired():
    p = os.path.join(REPO, ".claude", "settings.json")
    if not os.path.exists(p):
        red("HOOKS UNWIRED · .claude/settings.json does not exist.\n"
            "   Layer D is the only thing that does not depend on the AI's judgment. "
            "Without it the system does not govern — it only documents.")
        return
    try:
        d = json.load(open(p, encoding="utf-8"))
    except Exception:                                          # noqa: BLE001
        return                       # already reported by check_permissions — do not duplicate

    registered = []
    for arr in (d.get("hooks") or {}).values():
        for entry in arr:
            for h in entry.get("hooks", []):
                cmd = h.get("command", "")
                # 🔴 2026-08-03: hooks became portable, and this guard compared the LITERAL
                # string — so it reported all four gates DANGLING while every one of them ran.
                # A guard that does not expand what the shell expands checks a path nobody uses,
                # and here it would have screamed that a healthy system was dead.
                cmd = cmd.replace(chr(36) + "{CLAUDE_PROJECT_DIR}", REPO) \
                         .replace(chr(36) + "CLAUDE_PROJECT_DIR", REPO)
                m = re.search(r"([^\s\"']+/(?:hooks|bin)/[\w.-]+)", cmd)
                if m:
                    registered.append(m.group(1))

    if not registered:
        red("HOOKS UNWIRED · settings.json registers NO hook pointing into Mente.\n"
            "   The three gates are off and nothing else would say so. "
            "Restore the hooks block (docs/architecture/how-it-runs.md §2-§4).")
        return

    # ① every registered command must resolve to a file that exists and can run
    for target in registered:
        if not os.path.exists(target):
            red(f"HOOK DANGLING · settings.json runs `{os.path.basename(target)}` "
                "but that file does not exist.\n"
                f"   {target}\n"
                "   The gate is registered and dead: it fails open on every call, silently.")
        elif not os.access(target, os.X_OK) and not target.endswith(".py"):
            red(f"HOOK NOT EXECUTABLE · {target} is registered but has no execute bit.")

    # ② every guard hook on disk should be registered — an unregistered gate is a gate that
    #    never fires. Warned, not blocked: a hook may legitimately be staged before wiring.
    # pre-commit.sh is invoked by git, and files starting with "_" are shared modules the hooks
    # import — neither is registered in settings.json, and neither is a fault.
    on_disk = {f for f in glob.glob("hooks/*")
               if os.path.isfile(f) and not f.endswith(("pre-commit.sh", ".md"))
               and not os.path.basename(f).startswith("_")}
    reg_names = {os.path.basename(t) for t in registered}
    for f in sorted(on_disk):
        if os.path.basename(f) not in reg_names:
            yel(f"{f} exists but is NOT registered in settings.json — it never fires")


# ── PERMISSIONS ──────────────────────────────────────────────────────────────
def check_permissions():
    # BOTH files, and they are not interchangeable (found 2026-07-30, F5):
    #   settings.json       is SHARED — travels with the repo, protects anyone who clones it
    #   settings.local.json is LOCAL  — gitignored, so a deny living only here protects nobody else
    # Auditing only the local one hid that the shared file granted Read(//home/brianweb3/**)
    # with zero deny rules — an open door to ~/.ssh that no validator was watching.
    for name in ("settings.json", "settings.local.json"):
        _check_one(os.path.join(REPO, ".claude", name), name)


def _check_one(p, name):
    if not os.path.exists(p):
        return
    try:
        d = json.load(open(p, encoding="utf-8"))
    except Exception:                                          # noqa: BLE001
        red(f"{name} is not valid JSON — ALL its settings are silently ignored")
        return
    perms = d.get("permissions", {})

    # A broad Read grant with nothing walling off credentials.
    #
    # 🔴 Found 2026-07-31: this used a HARDCODED list — (".ssh", "secrets", ".env") — so the
    # guard existed, ran, and stayed silent while `Read(//home/<user>/**)` exposed the GitHub
    # token in ~/.config/gh/hosts.yml, ~/.aws/credentials and ~/.gnupg. The guard was not
    # broken; it was looking in the wrong places.
    #
    # ⭐ THE PATTERN, hit three times in one day: a fixed list written when only three dangers
    # were known. Same shape as the deny that covered Read/Edit/Write but not Bash, and as the
    # test that counted exactly 3 rules per target. In all three the guard reported green with
    # the hole wide open.
    #
    # The fix is to DISCOVER instead of consult: walk the granted scope and flag whatever looks
    # like a credential. A new tool that drops a token in ~/.something is caught the day it
    # appears, without anyone remembering to extend a list.
    CRED_NAMES = ("credentials", "hosts.yml", ".netrc", ".npmrc", ".pypirc",
                  "id_rsa", "id_ed25519", "config.json", "token", "secring.gpg")
    CRED_DIRS = (".ssh", ".aws", ".gnupg", ".config/gh", ".docker", ".kube", "secrets")

    def _covered(path_fragment, deny_rules):
        """Is this path walled off by ANY deny rule, on any tool?"""
        key = path_fragment.strip("/").split("/")[-1]
        return any(key in dr for dr in deny_rules)

    for a in perms.get("allow", []):
        m = re.match(r"Read\(/{0,2}(/home/[^*)]*)\*\*\)", a)
        if not m:
            continue
        scope = m.group(1).rstrip("/")
        uncovered = []
        # ① the well-known credential directories that actually exist on this machine
        for c in CRED_DIRS:
            if os.path.isdir(os.path.join(scope, c)) and not _covered(c, perms.get("deny", [])):
                uncovered.append(f"{scope}/{c}/")
        # ② anything else at the top level whose NAME says credential
        try:
            for entry in os.listdir(scope):
                p = os.path.join(scope, entry)
                if os.path.isfile(p) and any(n in entry for n in CRED_NAMES) \
                        and not _covered(entry, perms.get("deny", [])):
                    uncovered.append(p)
        except OSError:
            pass
        # ③ the original three, kept explicit: .env files are not a directory
        for s in ("/.env",):
            if not _covered(s, perms.get("deny", [])):
                uncovered.append(f"{scope}{s}*")
        if uncovered:
            shown = "\n".join(f"     · {u}" for u in uncovered[:6])
            more = f"\n     … +{len(uncovered) - 6} more" if len(uncovered) > 6 else ""
            red(f"{name} · {a} grants credentials that NO deny rule covers:\n"
                f"{shown}{more}\n"
                "   Deny wins over allow. Add Read(...) AND Bash(cat ...) rules — a shell\n"
                "   reads whatever the file tools refuse (rules/rule-config-hygiene.md §1.5).")
    deny = perms.get("deny", [])
    allow = perms.get("allow", [])
    dirs = perms.get("additionalDirectories", [])

    # a deny that an additionalDirectory contradicts — the NavigoX hole
    for rule in deny:
        m = re.search(r"\((?://)?(/[^*)]+)", rule)
        if not m:
            continue
        locked = m.group(1).rstrip("/")
        for entry in dirs:
            if entry.startswith(locked) or locked.startswith(entry.rstrip("/") + "/"):
                red(f"CONTRADICTION · additionalDirectories grants {entry}\n"
                    f"   but a deny rule locks {locked}")

    for entry in dirs:
        if not os.path.exists(entry):
            yel(f"dead path in additionalDirectories: {entry}")
    for i, a in enumerate(dirs):
        for b in dirs[i + 1:]:
            if a != b and (a.startswith(b.rstrip("/") + "/") or b.startswith(a.rstrip("/") + "/")):
                yel(f"overlapping paths: {a} and {b} — one contains the other")

    # secrets pasted into approved commands
    blob = json.dumps(allow)
    for pat, what in ((r"sshpass\s+-p\s+['\"]?[A-Za-z0-9]{6,}", "an SSH password"),
                      (r"sk-ant-[A-Za-z0-9]{10,}", "an Anthropic key"),
                      (r"ghp_[A-Za-z0-9]{20,}", "a GitHub token")):
        if re.search(pat, blob):
            red(f"SECRET · {what} is embedded in an approved command.\n"
                "   Approved commands are stored verbatim — the secret is now permanent.\n"
                "   Purge it AND rotate it: purging does not invalidate.")

    # 🔴 Lowered from 200 to 120 on 2026-07-31. The audit found 199 entries — ONE under the
    # line — so this check never spoke while 25 broad wildcards, 24 dead scratchpad paths and
    # `rm -rf *` sat in the list. A limit missed by one unit is a limit set by accident.
    # 120 is above the ~30 the mechanism rule would yield, so it flags drift without nagging.
    if len(allow) > 120:
        yel(f"{len(allow)} allow entries — granularity should be the mechanism, "
            "not the invocation (rules/rule-config-hygiene.md §1.3)")


# ── SIZE LIMITS ──────────────────────────────────────────────────────────────
# ⚠️ This table is DUPLICATED in bin/check-blocks and declared in rules/contract-document.md §2.
# Three copies, so a ceiling change must touch all three or they contradict each other
# (2026-08-05: block 150→200, entry-point 200→250, done in all three).
LIMITS = {"entry-point": 250, "contract": 400, "rule": 250, "architecture": 800,
          "plan": 400, "block": 200, "memory-index": 80, "analysis": 300, "case": 300}


def check_sizes():
    for f in glob.glob("**/*.md", recursive=True):
        if ".git/" in f or f.startswith("secrets/"):
            continue
        try:
            text = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        m = re.search(r"\*\*Type:\*\*\s*([a-z-]+)", text)
        if not m:
            continue
        t = m.group(1)
        n = text.count("\n") + 1
        if t in LIMITS and n > LIMITS[t]:
            yel(f"{f}: {n} lines — over the {t} limit of {LIMITS[t]}")

    # ⛔ MEMORY.md IS NOT AUDITED HERE — removed 2026-08-05, by Brian.
    #
    # It is the HARNESS's memory index: it lives outside Mente/, it is written by Claude Code's
    # memory system, and nothing in this engine can shrink it. A warning nobody can act on is
    # noise, and 67 unactioned warnings is how a validator became noise once already (M1).
    #
    # ⚠️ The cost it flagged is REAL and does not go away by not measuring it: MEMORY.md loads on
    # every session start, so each line is context spent before the first token. It was 109 lines
    # against the 80 this check used to demand. If startup ever feels heavy, that file is the first
    # place to look — but the pruning is the harness owner's call, not this validator's finding.
    #
    # ⭐ The rule this follows: a validator audits what its system CONTROLS. Auditing a neighbour's
    # file produces a red nobody owns.


# ── TRUTH ────────────────────────────────────────────────────────────────────
def check_truth():
    reg = "Maestro/registro.md"
    if os.path.exists(reg):
        text = open(reg, encoding="utf-8", errors="replace").read()
        # 🔴 2026-08-03: `(\d+ docs` matched the FIRST occurrence anywhere in the file — and
        # registro.md lists SEVERAL Mente OS instances. When this repo's own count was turned
        # into a pointer, the check silently started measuring the neighbour's ("5 docs" for
        # marca-personal/Mente) against THIS tree's total. Anchor it to the line that names
        # this instance, and stay quiet when the count has become a pointer.
        m = re.search(r"`~/for3s/Mente/`[^\n]*?\((\d+)\s*docs", text)
        if m:
            claimed = int(m.group(1))
            real = len([f for f in glob.glob("**/*.md", recursive=True) if ".git/" not in f])
            if abs(claimed - real) > 10:
                red(f"registro.md claims {claimed} docs — measured {real}.\n"
                    "   Foresito reads this file LIVE via MCP: it is reporting false numbers.")

    for gen in ("docs/INDEX.md", "docs/STATES.md"):
        if not os.path.exists(gen):
            yel(f"{gen} does not exist — no generated index (phase F7)")


# ── ISOLATION ────────────────────────────────────────────────────────────────
# 🔴 Found 2026-07-31 while auditing the system against its own rules:
# `rules/rule-isolation.md` §5 promised that check-health flags "a block reading files from
# another block with no declared connection" and "a §C connection pointing at a block that does
# not exist". NEITHER existed in code — a rule in a document promising a rule in code, which is
# exactly what v2 exists to stop.
#
# Latent today (one active block, so no cross is possible) — it bites the moment there are two.
# Written now because a promise nobody implements teaches you to distrust the other promises.
def check_isolation():
    blocks = {}
    for b in glob.glob("blocks/*/*/BLOCK.md"):
        try:
            text = open(b, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        m = re.search(r"^id:\s*(\S+)", text, re.M)
        if m:
            blocks[m.group(1)] = (os.path.basename(os.path.dirname(b)), text)

    for bid, (name, text) in blocks.items():
        # ① a §C connection pointing at a block that does not exist
        conn = re.search(r"##\s*Connections\s*\n((?:\s*-.*\n)+)", text)
        if conn:
            for ref in re.findall(r"\bblk-[a-z0-9-]+", conn.group(1)):
                if ref not in blocks:
                    yel(f"block `{name}` §C declares a connection to `{ref}`, "
                        "which does not exist on disk")
        # ② referencing another block's files with no declared connection
        declared = conn.group(1) if conn else ""
        for other_id, (other_name, _) in blocks.items():
            if other_id == bid:
                continue
            path = f"blocks/active/{other_name}/"
            if path in text and other_id not in declared and other_name not in declared:
                yel(f"block `{name}` points into `{other_name}` with no §C connection "
                    "(rules/rule-isolation.md §1)")


# ── SESSION ──────────────────────────────────────────────────────────────────
def check_heartbeat():
    """Did the SessionStart hook actually run recently?

    🔴 The gap this closes, measured 2026-07-31: session-start.sh is silent when everything is
    fine — and equally silent if it is dead. The guard that reports on every OTHER guard could
    stop firing and nothing would say so, because a missing warning looks exactly like health.

    This cannot be caught in the moment (see the hook's own comment). It IS catchable after the
    fact: the hook stamps a date, and any validator run afterwards compares it to today. That
    turns "it said nothing" into "it has said nothing for N days" — which is distinguishable.

    ⚠️ Honest limit: if the hook AND the stamp are removed together, this cannot tell that from
    a fresh install. That is deliberate sabotage, not drift, and no internal guard covers it.
    """
    beat = os.path.join(MENTE, ".heartbeat")
    if not os.path.exists(beat):
        yel("no .heartbeat — the SessionStart hook has never run here.\n"
            "   Expected on a fresh clone; if this is not fresh, check .claude/settings.json")
        return
    try:
        stamped = date.fromisoformat(
            open(beat, encoding="utf-8", errors="replace").read().strip())
    except (OSError, ValueError):
        yel(".heartbeat is unreadable — cannot tell whether the startup hook still runs")
        return
    gap = (date.today() - stamped).days
    # 3 days: long enough that a weekend does not nag, short enough to catch it the same week.
    if gap >= 3:
        red(f"STARTUP HOOK SILENT · last ran {stamped} ({gap} days ago).\n"
            "   This is the guard that reports every other guard. If it is dead, every 🔴 it\n"
            "   would have raised is invisible — and silence reads exactly like health.\n"
            "   Verify: .claude/settings.json → hooks.SessionStart")

    # ── F2: the three gates leave their own proof ────────────────────────────
    # F1 covered SessionStart. The gates had the same blind spot for a different reason: a gate
    # that stopped firing looks exactly like a gate with nothing to block. Measured on the day
    # this was written: gate-handoff had blocked three launches (proof it fires), and after
    # dozens of edits there was NO way to tell whether gate-critical had run even once.
    #
    # Compared against the STARTUP beat, not against today: the gates only fire when you work,
    # so "quiet while nobody was here" is not a fault. The fault is a gate quiet on a day the
    # session itself was alive.
    gates = {"gate-critical": "blocks destructive SQL and insufficient closes",
             "pre-edit-standards": "injects the block's standards before an edit",
             "gate-handoff": "blocks a writing specialist with no declared scope"}
    for gname, what in gates.items():
        gbeat = os.path.join(MENTE, ".beats", gname)
        if not os.path.exists(gbeat):
            if gap == 0:                       # startup ran today, so the gates should have too
                yel(f"gate `{gname}` has never fired here — it {what}.\n"
                    "   Expected on a fresh clone; otherwise check its matcher in settings.json")
            continue
        try:
            gstamp = date.fromisoformat(open(gbeat, encoding="utf-8").read().strip())
        except (OSError, ValueError):
            continue
        gap_g = (stamped - gstamp).days
        # 7 days of sessions without one edit or one launch is implausible — that is a dead gate.
        if gap_g >= 7:
            red(f"GATE SILENT · `{gname}` last fired {gstamp}, {gap_g} days before the last "
                f"session.\n   It {what}.\n"
                "   A gate that stopped firing is indistinguishable from one with nothing to "
                "block — until something gets through.")


def check_session():
    # 🔴 This hardcoded the transcript path and returned SILENTLY when it did not resolve, so
    # on any other machine the session watch — the guard that exists BECAUSE of the 21-jul
    # incident — simply went quiet. Now the path is computed and a miss is REPORTED.
    d, why = cfg.session_dir()
    if why:
        yel(f"{why}\n   → session size/age is not being watched "
            "(set session.project_dir in mente.config.yml if this is wrong)")
        return
    js = cfg.session_files()
    if not js:
        return
    cur = js[0]
    size = os.path.getsize(cur) / 1e6
    if size > 50:
        red(f"current session is {size:.0f} MB — over the 50 MB red threshold")
    elif size > 15:
        yel(f"current session is {size:.0f} MB — watch it (red at 50)")

    try:
        first = last = None
        errs = 0
        for line in open(cur, errors="replace"):
            if "Connection closed mid-response" in line or "stalled mid-stream" in line:
                errs += 1
            i = line.find('"timestamp":"')
            if i > 0:
                ts = line[i + 13:i + 32]
                first = first or ts
                last = ts
        if first and last:
            h = (datetime.fromisoformat(last) - datetime.fromisoformat(first)).total_seconds() / 3600
            if h > 48:
                red(f"session open {h:.0f}h — the 2026-07-21 incident happened at 4 days "
                    "(835K context, 6 scope violations)")
            elif h > 24:
                yel(f"session open {h:.0f}h")
        if errs >= 5:
            yel(f"{errs} API connection errors this session — a saturated-context signal")
    except Exception:                                          # noqa: BLE001
        pass

    # a previous session with no entry in the log
    regc = "Cerebro/Registro_Conversaciones.md"
    if os.path.exists(regc) and len(js) > 1:
        text = open(regc, encoding="utf-8", errors="replace").read()
        # 🔴 Family A (2026-08-02): `[:8] not in text` matches those 8 hex characters ANYWHERE
        # — inside a commit hash, a path, a longer id — and reports a heavy unregistered
        # session as registered. Same defect fixed in check-clear-ready (8d9f5f3).
        def _logged(sid):
            return re.search(rf"(?<![0-9a-f]){re.escape(sid)}(?![0-9a-f])", text)
        missing = [os.path.basename(f)[:8] for f in js[1:]
                   if os.path.getsize(f) > 2e6 and not _logged(os.path.basename(f)[:8])]
        if missing:
            yel(f"{len(missing)} past session(s) over 2 MB with no entry in "
                f"Registro_Conversaciones.md: {', '.join(missing[:4])}")


# ── MAIN ─────────────────────────────────────────────────────────────────────
def main():
    args = sys.argv[1:]
    quiet = "--quiet" in args
    only_misplaced = "--misplaced" in args

    check_misplaced()
    if not only_misplaced:
        check_guards()
        check_permissions()
        check_sizes()
        check_truth()
        check_isolation()
        check_heartbeat()
        # 🔴 A published engine that cannot name its version cannot be debugged elsewhere.
        if not os.path.exists(os.path.join(MENTE, "VERSION")):
            red("VERSION is missing — this engine cannot say which version it is.\n"
                "   A bug reported from another machine could not be reproduced.")
        check_session()

    if quiet:
        return 2 if RED else (1 if YEL else 0)

    if RED:
        print(f"\n🔴 {len(RED)}")
        for m in RED:
            print(f"   {m}")
    if YEL:
        print(f"\n🟡 {len(YEL)}")
        for m in YEL:
            print(f"   {m}")
    # ── WHICH VERSION IS RUNNING (intern-os #5, 2026-08-05) ─────────────────────
    # 🔴 The gap: the engine is PUBLISHED, and until today nothing could say WHICH version was
    # running. A bug report from someone else's machine that cannot name a version is a bug report
    # nobody can reproduce — and that is precisely the field test still owed.
    #
    # It prints even when healthy, unlike everything else here: this line is not a warning, it is
    # the thing you paste into a report. intern-os validates the number in three places; the
    # source here is ONE file (`VERSION`), so there is nothing to keep in sync — a copy cannot
    # drift if it does not exist.
    try:
        _v = open(os.path.join(MENTE, "VERSION"), encoding="utf-8").read().strip()
    except OSError:
        _v = None
    if _v:
        print(f"\nMente OS {_v}   ({os.path.basename(MENTE)} · {date.today().isoformat()})")
    # Silence when everything is fine: a validator that always talks is always ignored.
    if not RED and not YEL:
        print("✅ system healthy")
    return 2 if RED else (1 if YEL else 0)


if __name__ == "__main__":
    sys.exit(main())
