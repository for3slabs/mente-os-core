case "$sout" in
  *"PIECE MOVED OR LOST"*) ok "a moved piece is caught by the pointer table" ;;
  *) bad "moved piece detection" "PIECE MOVED OR LOST" "silent" ;;
esac
mkdir -p /tmp/newhome && mv /tmp/gate.bak /tmp/newhome/Puentes_Mente_OS.md
